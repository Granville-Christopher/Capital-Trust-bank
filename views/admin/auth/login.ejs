<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capital Trust Bank - Admin Login</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      rel="stylesheet"
    />

    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="https://placehold.co/16x16/2563EB/DBEAFE?text=CTBank"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="https://placehold.co/180x180/2563EB/DBEAFE?text=CTBank"
    />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#2563EB" />

    <meta property="og:title" content="Capital Trust Bank - Admin Panel" />
    <meta
      property="og:description"
      content="Admin access for Capital Trust Bank management."
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content="https://capital-trust-bank-production.up.railway.app/"
    />
    <meta
      property="og:image"
      content="https://capital-trust-bank-production.up.railway.app/images/hpg.jpg"
    />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:site_name" content="Capital Trust Bank" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@CTBankOfficial" />
    <meta name="twitter:creator" content="@CTBankOfficial" />
    <meta name="twitter:title" content="Capital Trust Bank - Admin Panel" />
    <meta
      name="twitter:description"
      content="Admin access for Capital Trust Bank management."
    />
    <meta
      name="twitter:image"
      content="https://capital-trust-bank-production.up.railway.app/images/hpg.jpg"
    />
  </head>

  <body
    class="bg-gradient-to-b from-blue-100 to-gray-100 min-h-screen flex flex-col relative"
  >
    <div class="bg-blue-600 text-white py-6 px-4 flex flex-col items-center">
      <div class="text-2xl font-semibold flex items-center space-x-2">
        <i class="fa-solid fa-building-columns text-white"></i>
        <span>Capital Trust Bank - Admin</span>
      </div>
      <p class="mt-2 text-sm">Admin access panel. Please log in to continue.</p>
      <a href="/" class="mt-2 text-xs underline hover:text-gray-200"
        >← Back to Home</a
      >
    </div>

    <div class="flex-grow flex items-center justify-center px-4">
      <form
        id="admin-login"
        class="bg-white rounded-xl p-8 w-full max-w-md mt-[-4rem] relative shadow-lg"
      >
        <h2 class="text-xl font-bold text-blue-600 mb-6 text-center">
          Admin Sign In
        </h2>

        <div class="mb-4">
          <label class="block text-sm text-gray-700 mb-1" for="email"
            >Email Address</label
          >
          <input
            type="email"
            id="email"
            name="email"
            placeholder="Enter your email"
            class="w-full px-4 py-2 border border-blue-500 rounded-full outline-none focus:ring-2 focus:ring-blue-400"
            required
          />
        </div>

        <div class="mb-4 relative">
          <label class="block text-sm text-gray-700 mb-1" for="password"
            >Password</label
          >
          <input
            type="password"
            id="password"
            name="password"
            placeholder="Enter your password"
            class="w-full px-4 py-2 pr-10 border border-blue-500 rounded-full outline-none focus:ring-2 focus:ring-blue-400"
            required
          />
          <span
            class="absolute right-3 top-[38px] cursor-pointer text-blue-500"
            onclick="togglePassword()"
          >
            <i id="toggleIcon" class="fa-solid fa-eye"></i>
          </span>
        </div>

        <button
          type="submit"
          id="admin-login-btn"
          class="w-full py-2 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition duration-200 flex items-center justify-center"
        >
          <span id="login-text">Log in</span>
          <svg
            id="spinner"
            class="animate-spin h-5 w-5 ml-2 hidden text-white"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
          >
            <circle
              class="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="4"
            ></circle>
            <path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"
            ></path>
          </svg>
        </button>

        <div class="flex justify-between mt-4 text-sm">
          <a href="/admin/signup" class="text-blue-500 hover:underline"
            >Sign Up</a
          >
        </div>
      </form>
    </div>

    <div
      id="toast"
      class="fixed bottom-30 right-5 bg-gray-800 text-white px-4 py-2 z-50 rounded shadow-lg opacity-0 transition-opacity duration-300 pointer-events-none"
    >
      <div id="toast-message" class="flex items-center space-x-2">
        <i id="toast-icon" class="fas"></i>
        <span id="toast-text"></span>
      </div>
    </div>

    <script src="/js/frontendfiles/showpassword.js"></script>
    <script src="/js/frontendfiles/toastalerts.js"></script>
    <script src="/js/admin/admin-login.js"></script>
  </body>
</html>
