<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capital Trust Bank - Crypto Wallets</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-gradient-to-br from-slate-50 via-indigo-50/30 to-slate-50 min-h-screen">
    <%- include('partials/header') %> <%- include('partials/sidebar') %>

    <main class="ml-0 lg:ml-64 mt-20 p-6">
      <div class="flex justify-between items-center mb-6">
        <div>
          <h1 class="text-3xl font-bold text-gray-900 mb-2">Crypto Wallets</h1>
          <p class="text-sm text-gray-600">Manage cryptocurrency wallet addresses for user deposits.</p>
        </div>
        <button
          type="button"
          id="openAddWalletModalBtn"
          class="bg-indigo-600 text-white px-5 py-2.5 rounded-lg hover:bg-indigo-700 transition shadow-lg font-semibold"
        >
          <i class="fa-solid fa-plus mr-2"></i>Add Wallet
        </button>
      </div>

      <script type="application/json" id="crypto-wallets-payload" class="hidden">
<%- JSON.stringify(wallets.map(w => ({
  id: String(w._id),
  walletName: w.walletName,
  walletAddress: w.walletAddress,
  cryptocurrency: w.cryptocurrency,
  network: w.network,
  qrCode: w.qrCode || '',
  isActive: w.isActive
}))) %>
      </script>

      <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-6">
        <div class="overflow-x-auto">
          <table class="min-w-full table-auto">
            <thead>
              <tr class="bg-gray-50">
                <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Wallet Name</th>
                <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Cryptocurrency</th>
                <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Network</th>
                <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Address</th>
                <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Status</th>
                <th class="px-4 py-2 text-left text-sm font-medium text-gray-700">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% wallets.forEach(wallet => { %>
              <tr class="border-t">
                <td class="px-4 py-2 text-sm text-gray-900"><%= wallet.walletName %></td>
                <td class="px-4 py-2 text-sm text-gray-900"><%= wallet.cryptocurrency %></td>
                <td class="px-4 py-2 text-sm text-gray-900"><%= wallet.network %></td>
                <td class="px-4 py-2 text-sm text-gray-900">
                  <code class="text-xs break-all max-w-xs block"><%= wallet.walletAddress %></code>
                </td>
                <td class="px-4 py-2 text-sm">
                  <span class="px-2 py-1 rounded <%= wallet.isActive ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                    <%= wallet.isActive ? 'Active' : 'Inactive' %>
                  </span>
                </td>
                <td class="px-4 py-2 text-sm">
                  <button
                    type="button"
                    data-wallet-id="<%= wallet._id %>"
                    class="edit-wallet-btn text-blue-600 hover:text-blue-800 mr-2"
                  >
                    Edit
                  </button>
                  <button
                    onclick='deleteWallet("<%= wallet._id %>")'
                    class="text-red-600 hover:text-red-800"
                  >
                    Delete
                  </button>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Add Wallet Modal -->
      <div id="addWalletModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
        <div class="bg-white rounded-xl p-6 max-w-md w-full mx-4">
          <h2 class="text-xl font-bold mb-4">Add Crypto Wallet</h2>
          <form id="addWalletForm" enctype="multipart/form-data">
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-1">Wallet Name</label>
              <input type="text" name="walletName" required
                class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-1">Wallet Address</label>
              <input type="text" name="walletAddress" required
                class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-1">Cryptocurrency</label>
              <select name="cryptocurrency" required
                class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="BTC">Bitcoin (BTC)</option>
                <option value="ETH">Ethereum (ETH)</option>
                <option value="USDT">Tether (USDT)</option>
                <option value="USDC">USD Coin (USDC)</option>
                <option value="BNB">Binance Coin (BNB)</option>
                <option value="SOL">Solana (SOL)</option>
                <option value="XRP">Ripple (XRP)</option>
                <option value="DOGE">Dogecoin (DOGE)</option>
                <option value="ADA">Cardano (ADA)</option>
                <option value="DOT">Polkadot (DOT)</option>
                <option value="MATIC">Polygon (MATIC)</option>
                <option value="LTC">Litecoin (LTC)</option>
                <option value="TRX">Tron (TRX)</option>
                <option value="BCH">Bitcoin Cash (BCH)</option>
                <option value="XLM">Stellar (XLM)</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-1">Network</label>
              <select name="network" required
                class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="Bitcoin">Bitcoin</option>
                <option value="Ethereum">Ethereum</option>
                <option value="Binance Smart Chain">Binance Smart Chain</option>
                <option value="Polygon">Polygon</option>
                <option value="Solana">Solana</option>
                <option value="Tron">Tron</option>
                <option value="Litecoin">Litecoin</option>
                <option value="Bitcoin Cash">Bitcoin Cash</option>
                <option value="Stellar">Stellar</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-1">QR Code Image (Optional)</label>
              <label for="addQrCodeFile" class="flex flex-col gap-2 cursor-pointer">
                <span class="inline-flex items-center justify-center w-full px-3 py-2.5 border-2 border-dashed border-blue-200 rounded-lg bg-blue-50/50 text-sm text-blue-800 hover:bg-blue-50 transition">
                  <i class="fa-solid fa-qrcode mr-2"></i>
                  <span id="addQrFileLabel">Choose QR image file</span>
                </span>
                <input type="file" name="qrCode" id="addQrCodeFile"
                  accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
                  class="sr-only" />
              </label>
              <p class="text-xs text-gray-500 mt-1">JPG, PNG, or WEBP — max 2MB. Use “Choose file” if the dashed area does not open on your device.</p>
              <div id="addQrCodePreview" class="mt-2 hidden">
                <img id="addQrCodePreviewImg" src="" alt="QR Code Preview" class="max-w-xs h-32 object-contain border rounded bg-white" />
              </div>
            </div>
            <div class="flex justify-end space-x-2">
              <button
                type="button"
                onclick="document.getElementById('addWalletModal').classList.add('hidden')"
                class="px-4 py-2 border rounded-lg hover:bg-gray-100"
              >
                Cancel
              </button>
              <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                Add Wallet
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Edit Wallet Modal -->
      <div id="editWalletModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
        <div class="bg-white rounded-xl p-6 max-w-md w-full mx-4">
          <h2 class="text-xl font-bold mb-4">Edit Crypto Wallet</h2>
          <form id="editWalletForm" enctype="multipart/form-data">
            <input type="hidden" name="walletId" id="editWalletId" />
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-1">Wallet Name</label>
              <input type="text" name="walletName" id="editWalletName" required
                class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-1">Wallet Address</label>
              <input type="text" name="walletAddress" id="editWalletAddress" required
                class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-1">Cryptocurrency</label>
              <select name="cryptocurrency" id="editCryptocurrency" required
                class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="BTC">Bitcoin (BTC)</option>
                <option value="ETH">Ethereum (ETH)</option>
                <option value="USDT">Tether (USDT)</option>
                <option value="USDC">USD Coin (USDC)</option>
                <option value="BNB">Binance Coin (BNB)</option>
                <option value="SOL">Solana (SOL)</option>
                <option value="XRP">Ripple (XRP)</option>
                <option value="DOGE">Dogecoin (DOGE)</option>
                <option value="ADA">Cardano (ADA)</option>
                <option value="DOT">Polkadot (DOT)</option>
                <option value="MATIC">Polygon (MATIC)</option>
                <option value="LTC">Litecoin (LTC)</option>
                <option value="TRX">Tron (TRX)</option>
                <option value="BCH">Bitcoin Cash (BCH)</option>
                <option value="XLM">Stellar (XLM)</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-1">Network</label>
              <select name="network" id="editNetwork" required
                class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="Bitcoin">Bitcoin</option>
                <option value="Ethereum">Ethereum</option>
                <option value="Binance Smart Chain">Binance Smart Chain</option>
                <option value="Polygon">Polygon</option>
                <option value="Solana">Solana</option>
                <option value="Tron">Tron</option>
                <option value="Litecoin">Litecoin</option>
                <option value="Bitcoin Cash">Bitcoin Cash</option>
                <option value="Stellar">Stellar</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-1">QR Code Image (Optional)</label>
              <label for="editQrCodeFile" class="flex flex-col gap-2 cursor-pointer">
                <span class="inline-flex items-center justify-center w-full px-3 py-2.5 border-2 border-dashed border-blue-200 rounded-lg bg-blue-50/50 text-sm text-blue-800 hover:bg-blue-50 transition">
                  <i class="fa-solid fa-qrcode mr-2"></i>
                  <span id="editQrFileLabel">Replace QR image</span>
                </span>
                <input type="file" name="qrCode" id="editQrCodeFile"
                  accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
                  class="sr-only" />
              </label>
              <p class="text-xs text-gray-500 mt-1">JPG, PNG, or WEBP — max 2MB</p>
              <div id="editQrCodePreview" class="mt-2">
                <img id="editQrCodePreviewImg" src="" alt="Current QR Code" class="max-w-xs h-32 object-contain border rounded hidden bg-white" />
                <p id="editQrCodeCurrent" class="text-xs text-gray-600 mt-1"></p>
              </div>
            </div>
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
              <select name="isActive" id="editIsActive"
                class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="true">Active</option>
                <option value="false">Inactive</option>
              </select>
            </div>
            <div class="flex justify-end space-x-2">
              <button
                type="button"
                onclick="document.getElementById('editWalletModal').classList.add('hidden')"
                class="px-4 py-2 border rounded-lg hover:bg-gray-100"
              >
                Cancel
              </button>
              <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                Update Wallet
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>

    <%- include('partials/footer') %> <%- include('partials/toastalerts') %> <%- include('partials/confirmation-modal') %>

    <script>
      let walletsPayload = [];
      try {
        const payloadEl = document.getElementById('crypto-wallets-payload');
        if (payloadEl) walletsPayload = JSON.parse(payloadEl.textContent.trim());
      } catch (e) {
        console.error('crypto-wallets payload', e);
      }

      function openEditWallet(walletId) {
        const w = walletsPayload.find(x => x.id === walletId);
        if (!w) return;
        editWallet(w);
      }

      function editWallet(w) {
        document.getElementById('editWalletId').value = w.id;
        document.getElementById('editWalletName').value = w.walletName;
        document.getElementById('editWalletAddress').value = w.walletAddress;
        document.getElementById('editCryptocurrency').value = w.cryptocurrency;
        document.getElementById('editNetwork').value = w.network;
        document.getElementById('editIsActive').value = String(!!w.isActive);

        const previewImg = document.getElementById('editQrCodePreviewImg');
        const currentText = document.getElementById('editQrCodeCurrent');
        const editQrFileLabel = document.getElementById('editQrFileLabel');
        if (w.qrCode && String(w.qrCode).trim() !== '') {
          previewImg.src = w.qrCode;
          previewImg.classList.remove('hidden');
          currentText.textContent = 'Current QR Code:';
          if (editQrFileLabel) editQrFileLabel.textContent = 'Replace QR image';
        } else {
          previewImg.removeAttribute('src');
          previewImg.classList.add('hidden');
          currentText.textContent = 'No QR code uploaded yet';
          if (editQrFileLabel) editQrFileLabel.textContent = 'Upload QR image';
        }

        document.getElementById('editQrCodeFile').value = '';

        document.getElementById('editWalletModal').classList.remove('hidden');
      }

      document.getElementById('openAddWalletModalBtn').addEventListener('click', function () {
        const form = document.getElementById('addWalletForm');
        if (form) form.reset();
        const prev = document.getElementById('addQrCodePreview');
        const prevImg = document.getElementById('addQrCodePreviewImg');
        const lbl = document.getElementById('addQrFileLabel');
        if (prev) prev.classList.add('hidden');
        if (prevImg) prevImg.removeAttribute('src');
        if (lbl) lbl.textContent = 'Choose QR image file';
        document.getElementById('addWalletModal').classList.remove('hidden');
      });

      document.querySelectorAll('.edit-wallet-btn').forEach(btn => {
        btn.addEventListener('click', function () {
          const id = this.getAttribute('data-wallet-id');
          if (id) openEditWallet(id);
        });
      });

      document.getElementById('addQrCodeFile').addEventListener('change', function(e) {
        const file = e.target.files[0];
        const previewDiv = document.getElementById('addQrCodePreview');
        const previewImg = document.getElementById('addQrCodePreviewImg');
        const lbl = document.getElementById('addQrFileLabel');
        if (file) {
          const reader = new FileReader();
          reader.onload = function(ev) {
            previewImg.src = ev.target.result;
            previewDiv.classList.remove('hidden');
          };
          reader.readAsDataURL(file);
          if (lbl) lbl.textContent = file.name;
        } else {
          previewDiv.classList.add('hidden');
          if (lbl) lbl.textContent = 'Choose QR image file';
        }
      });

      document.getElementById('editQrCodeFile').addEventListener('change', function(e) {
        const file = e.target.files[0];
        const previewImg = document.getElementById('editQrCodePreviewImg');
        if (file) {
          const reader = new FileReader();
          reader.onload = function(ev) {
            previewImg.src = ev.target.result;
            previewImg.classList.remove('hidden');
            document.getElementById('editQrCodeCurrent').textContent = 'New QR Code (will replace current):';
          };
          reader.readAsDataURL(file);
          const el = document.getElementById('editQrFileLabel');
          if (el) el.textContent = file.name;
        }
      });

      function deleteWallet(id) {
        showConfirmation(
          'Delete Crypto Wallet',
          'Are you sure you want to delete this wallet? This action cannot be undone.',
          () => {
            fetch(`/admin/crypto-wallets/${id}`, { method: 'DELETE' })
              .then(res => res.json())
              .then(data => {
                if (data.message) {
                  showSuccess('Success', data.message, () => {
                    setTimeout(() => location.reload(), 1000);
                  });
                } else {
                  showError('Error', data.error || 'Failed to delete wallet');
                }
              })
              .catch(err => {
                console.error(err);
                showError('Error', 'Server error. Please try again.');
              });
          },
          'Delete',
          'Cancel'
        );
      }

      document.getElementById('addWalletForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);

        try {
          const response = await fetch('/admin/crypto-wallets', {
            method: 'POST',
            body: formData,
          });

          const result = await response.json();
          if (response.ok) {
            showSuccess('Success', result.message, () => {
              document.getElementById('addWalletModal').classList.add('hidden');
              setTimeout(() => location.reload(), 1000);
            });
          } else {
            const errorMsg = result.errors ? result.errors.map(e => e.msg || e.message).join(', ') : (result.error || 'Failed to create wallet');
            showError('Error', errorMsg);
          }
        } catch (err) {
          console.error(err);
          showError('Error', 'Server error. Please try again.');
        }
      });

      document.getElementById('editWalletForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const walletId = formData.get('walletId');

        try {
          const response = await fetch(`/admin/crypto-wallets/${walletId}`, {
            method: 'PUT',
            body: formData,
          });

          const result = await response.json();
          if (response.ok) {
            showSuccess('Success', result.message, () => {
              document.getElementById('editWalletModal').classList.add('hidden');
              setTimeout(() => location.reload(), 1000);
            });
          } else {
            const errorMsg = result.errors ? result.errors.map(e => e.msg || e.message).join(', ') : (result.error || 'Failed to update wallet');
            showError('Error', errorMsg);
          }
        } catch (err) {
          console.error(err);
          showError('Error', 'Server error. Please try again.');
        }
      });
    </script>
  </body>
</html>

