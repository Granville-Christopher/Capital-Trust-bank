<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capital Trust Bank - Loan Details</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      rel="stylesheet"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank"
    />
  </head>
  <body class="bg-gradient-to-br from-slate-50 via-indigo-50/30 to-slate-50 min-h-screen">
    <%- include('partials/header') %> <%- include('partials/sidebar') %>

    <main class="ml-0 lg:ml-64 mt-20 p-6">
      <div class="mb-6">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Loan Details</h1>
        <p class="text-sm text-gray-600">View detailed information about the loan application.</p>
      </div>

      <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- User Info -->
          <div>
            <h2 class="text-xl font-semibold text-gray-800 mb-4">
              User Information
            </h2>
            <p><strong>Name:</strong> <%= loan.userId.Name %></p>
            <p><strong>Email:</strong> <%= loan.userId.Email %></p>
            <p>
              <strong>Account Number:</strong> <%= loan.userId.AccountNumber %>
            </p>
          </div>

          <!-- Loan Info -->
          <div>
            <h2 class="text-xl font-semibold text-gray-800 mb-4">
              Loan Information
            </h2>
            <p><strong>Amount:</strong> $<%= loan.amount %></p>
            <p><strong>Interest Rate:</strong> <%= loan.interestRate %>%</p>
            <p>
              <strong>Due Date:</strong> <%= new
              Date(loan.dueDate).toLocaleDateString() %>
            </p>
            <p>
              <strong>Status:</strong>
              <span
                class="px-2 py-1 rounded-full text-xs font-medium <%= loan.status === 'approved' ? 'bg-green-100 text-green-800' : loan.status === 'repaid' ? 'bg-blue-100 text-blue-800' : loan.status === 'defaulted' ? 'bg-red-100 text-red-800' : 'bg-yellow-100 text-yellow-800' %>"
              >
                <%= loan.status.charAt(0).toUpperCase() + loan.status.slice(1) %>
              </span>
            </p>
            <p>
              <strong>Created:</strong> <%= new
              Date(loan.createdAt).toLocaleDateString() %>
            </p>
          </div>
        </div>

        <!-- Actions -->
        <div class="mt-6 pt-6 border-t">
          <h3 class="text-lg font-semibold text-gray-800 mb-4">Actions</h3>
          <div class="flex gap-4">
            <% if (loan.status !== 'repaid') { %>
            <button
              onclick="markAsPaid('<%= loan._id %>')"
              class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700"
            >
              Mark as Paid
            </button>
            <% } %>
            <a
              href="/admin/loans"
              class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700"
              >Back to List</a
            >
          </div>
        </div>
      </div>
    </main>

    <%- include('partials/footer') %> <%- include('partials/toastalerts') %> <%- include('partials/confirmation-modal') %>

    <script>
      async function markAsPaid(loanId) {
        showConfirmation(
          'Mark Loan as Paid',
          'Are you sure you want to mark this loan as paid? This action cannot be undone.',
          async () => {
            try {
              const response = await fetch(`/admin/loans/${loanId}/mark-paid`, {
                method: "POST",
              });
              const result = await response.json();
              if (response.ok) {
                showSuccess('Success', result.message, () => {
                  setTimeout(() => (window.location.href = "/admin/loans"), 1000);
                });
              } else {
                showError('Error', result.error || "Update failed");
              }
            } catch (err) {
              showError('Error', "Server error. Please try again.");
            }
          },
          'Mark as Paid',
          'Cancel'
        );
      }
    </script>
  </body>
</html>
