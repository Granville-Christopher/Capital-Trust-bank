<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capital Trust Bank - Loan Details</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      rel="stylesheet"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank"
    />
  </head>
  <body class="bg-gray-100 min-h-screen">
    <%- include('partials/header') %> <%- include('partials/sidebar') %>

    <main class="ml-0 lg:ml-64 mt-20 p-6">
      <h1 class="text-2xl font-bold text-gray-800 mb-6">Loan Details</h1>

      <div class="bg-white rounded-xl shadow p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- User Info -->
          <div>
            <h2 class="text-xl font-semibold text-gray-800 mb-4">
              User Information
            </h2>
            <p><strong>Name:</strong> <%= loan.userId.Name %></p>
            <p><strong>Email:</strong> <%= loan.userId.Email %></p>
            <p>
              <strong>Account Number:</strong> <%= loan.userId.AccountNumber %>
            </p>
          </div>

          <!-- Loan Info -->
          <div>
            <h2 class="text-xl font-semibold text-gray-800 mb-4">
              Loan Information
            </h2>
            <p><strong>Amount:</strong> $<%= loan.amount %></p>
            <p><strong>Interest Rate:</strong> <%= loan.interestRate %>%</p>
            <p>
              <strong>Due Date:</strong> <%= new
              Date(loan.dueDate).toLocaleDateString() %>
            </p>
            <p>
              <strong>Status:</strong>
              <span
                class="px-2 py-1 rounded-full text-xs font-medium <%= loan.status === 'Active' ? 'bg-green-100 text-green-800' : loan.status === 'Paid' ? 'bg-blue-100 text-blue-800' : 'bg-red-100 text-red-800' %>"
              >
                <%= loan.status %>
              </span>
            </p>
            <p>
              <strong>Created:</strong> <%= new
              Date(loan.createdAt).toLocaleDateString() %>
            </p>
          </div>
        </div>

        <!-- Actions -->
        <div class="mt-6 pt-6 border-t">
          <h3 class="text-lg font-semibold text-gray-800 mb-4">Actions</h3>
          <div class="flex gap-4">
            <% if (loan.status !== 'Paid') { %>
            <button
              onclick="markAsPaid('<%= loan._id %>')"
              class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700"
            >
              Mark as Paid
            </button>
            <% } %>
            <a
              href="/admin/loans"
              class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700"
              >Back to List</a
            >
          </div>
        </div>
      </div>
    </main>

    <%- include('partials/footer') %> <%- include('partials/toastalerts') %>

    <script>
      async function markAsPaid(loanId) {
        if (!confirm("Are you sure you want to mark this loan as paid?"))
          return;
        try {
          const response = await fetch(`/admin/loans/${loanId}/mark-paid`, {
            method: "POST",
          });
          const result = await response.json();
          if (response.ok) {
            showToast("success", result.message);
            setTimeout(() => (window.location.href = "/admin/loans"), 1500);
          } else {
            showToast("error", result.error || "Update failed");
          }
        } catch (err) {
          showToast("error", "Server error");
        }
      }
    </script>
  </body>
</html>
