<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Capital Trust Bank - Live Customer Support</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      rel="stylesheet"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank"
    />
    <style>
      .chat-scroll::-webkit-scrollbar {
        width: 5px;
      }
      .chat-scroll::-webkit-scrollbar-track {
        background: transparent;
      }
      .chat-scroll::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
      }
      .chat-scroll::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
      }
    </style>
  </head>
  <body class="bg-slate-100 min-h-screen text-slate-800">
    <%- include('partials/header') %> <%- include('partials/sidebar') %>

    <main class="ml-0 lg:ml-64 mt-16 lg:mt-20 p-3 sm:p-4 lg:p-6">
      
      <!-- ========================================== -->
      <!-- VIEW 1: ALL USERS DIRECTORY VIEW           -->
      <!-- ========================================== -->
      <div id="users-directory-view" class="space-y-4 sm:space-y-6">
        
        <!-- Header banner -->
        <div class="bg-white p-4 sm:p-6 rounded-2xl shadow-sm border border-gray-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-indigo-600 text-white flex items-center justify-center text-lg sm:text-xl shadow-md flex-shrink-0">
              <i class="fa-solid fa-comments"></i>
            </div>
            <div>
              <h1 class="text-xl sm:text-2xl font-bold text-gray-900 leading-tight">Customer Support Chat</h1>
              <p class="text-xs sm:text-sm text-gray-500">
                Direct live messaging with email notification delivery to user's inbox.
              </p>
            </div>
          </div>
          
          <div class="flex items-center gap-2 flex-wrap">
            <span id="unread-total-badge" class="hidden items-center gap-1.5 px-3 py-1.5 bg-red-100 text-red-700 text-xs font-bold rounded-full border border-red-200 shadow-sm animate-pulse">
              <i class="fa-solid fa-bell text-xs"></i> <span id="unread-total-count">0</span> Unread
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-emerald-50 text-emerald-700 text-xs font-semibold rounded-full border border-emerald-200">
              <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span> Active
            </span>
          </div>
        </div>

        <!-- Search input -->
        <div class="bg-white p-3 sm:p-4 rounded-2xl shadow-sm border border-gray-200 flex flex-col sm:flex-row gap-3 items-center justify-between">
          <div class="relative w-full sm:w-80 md:w-96">
            <i class="fa-solid fa-magnifying-glass text-gray-400 absolute left-3.5 top-3 text-sm"></i>
            <input
              id="user-search-input"
              type="text"
              placeholder="Search by customer name, email, account #..."
              class="w-full pl-10 pr-4 py-2 bg-slate-50 border border-gray-200 text-xs sm:text-sm rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition text-gray-800"
            />
          </div>
          <div class="text-xs text-gray-500 font-medium self-end sm:self-auto">
            Total Customers: <span id="users-count" class="font-bold text-gray-900">0</span>
          </div>
        </div>

        <!-- Users Grid -->
        <div id="users-grid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3 sm:gap-4">
          <div class="col-span-full p-12 text-center text-gray-400 bg-white rounded-2xl border border-gray-200">
            <i class="fa-solid fa-spinner fa-spin text-3xl text-indigo-600 mb-3"></i>
            <p class="text-sm font-medium">Loading customer accounts...</p>
          </div>
        </div>

      </div>


      <!-- ========================================== -->
      <!-- VIEW 2: DEDICATED FULL-PAGE MESSAGING PANEL-->
      <!-- ========================================== -->
      <div id="chat-panel-view" class="hidden bg-white rounded-2xl shadow-lg border border-gray-200 overflow-hidden flex flex-col h-[calc(100vh-80px)] sm:h-[calc(100vh-100px)]">
        
        <!-- Top Bar: Responsive & Clean -->
        <div class="px-3 sm:px-5 py-2.5 sm:py-3 bg-white border-b border-gray-200 flex items-center justify-between gap-2 shadow-sm z-20">
          
          <!-- Left: Back Button + Avatar + Customer Name -->
          <div class="flex items-center gap-2 sm:gap-3 min-w-0 flex-1">
            <button
              id="back-to-users-btn"
              type="button"
              class="inline-flex items-center justify-center w-8 h-8 sm:w-auto sm:px-3 sm:py-1.5 bg-slate-100 hover:bg-indigo-50 text-slate-700 hover:text-indigo-700 font-semibold rounded-lg text-xs transition border border-slate-200 shadow-sm flex-shrink-0"
              title="Return to customer list"
            >
              <i class="fa-solid fa-arrow-left text-sm"></i>
              <span class="hidden sm:inline sm:ml-1.5">Customers</span>
            </button>

            <div class="relative flex-shrink-0">
              <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-gradient-to-tr from-indigo-600 to-blue-500 text-white font-bold flex items-center justify-center text-xs sm:text-sm shadow" id="chat-user-avatar">
                U
              </div>
              <span class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-emerald-500 ring-2 ring-white rounded-full"></span>
            </div>

            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-1.5 flex-wrap">
                <h2 id="chat-user-name" class="text-xs sm:text-sm font-bold text-gray-900 truncate">Customer Name</h2>
                <span id="chat-user-currency-badge" class="px-1.5 py-0.5 bg-indigo-50 text-indigo-700 text-[10px] font-bold rounded border border-indigo-200">USD</span>
              </div>
              <div class="flex items-center gap-1.5 text-[10px] sm:text-xs text-gray-500 font-medium truncate">
                <span id="chat-user-account" class="font-mono">ACCT#</span>
                <span>&bull;</span>
                <span id="chat-user-email" class="truncate hidden xs:inline">user@example.com</span>
                <span>&bull;</span>
                <span class="text-emerald-700 font-bold" id="chat-user-balance">$0.00</span>
              </div>
            </div>
          </div>

          <!-- Right: Action Buttons -->
          <div class="flex items-center gap-1.5 sm:gap-2 flex-shrink-0">
            <a
              id="chat-login-as-user-btn"
              href="#"
              target="_blank"
              class="inline-flex items-center gap-1 px-2.5 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg text-xs transition shadow-sm"
              title="Log in to this user account without password"
            >
              <i class="fa-solid fa-arrow-right-to-bracket text-xs"></i>
              <span class="hidden sm:inline">Log In</span>
            </a>
            <a
              id="chat-view-user-btn"
              href="#"
              class="inline-flex items-center gap-1 px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-lg text-xs transition border border-slate-200"
              title="View full account details"
            >
              <i class="fa-solid fa-user text-xs"></i>
              <span class="hidden sm:inline">Details</span>
            </a>
          </div>

        </div>

        <!-- Middle: Chat Messages Timeline -->
        <div id="chat-messages-container" class="flex-1 p-3 sm:p-5 overflow-y-auto chat-scroll space-y-3 bg-[#e5ddd5]/20">
          <!-- Messages inserted dynamically -->
        </div>

        <!-- Bottom: Input Box -->
        <div class="p-2.5 sm:p-3 bg-white border-t border-gray-200 shadow-sm z-20">
          <div class="flex items-center gap-2">
            <div class="flex-1 relative">
              <textarea
                id="chat-input-field"
                rows="1"
                placeholder="Type your reply... (Press Enter to send, Shift+Enter for new line)"
                class="w-full text-xs sm:text-sm bg-slate-50 text-gray-900 placeholder-gray-400 rounded-xl px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition resize-none max-h-28 leading-relaxed border border-gray-200"
              ></textarea>
            </div>
            <button
              id="chat-send-btn"
              type="button"
              class="inline-flex items-center justify-center gap-1.5 px-4 sm:px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 text-white font-semibold rounded-xl text-xs sm:text-sm transition shadow flex-shrink-0"
            >
              <span>Send</span>
              <i class="fa-solid fa-paper-plane text-xs"></i>
            </button>
          </div>
          <div class="flex items-center justify-between text-[10px] text-gray-400 mt-1.5 px-1">
            <span><i class="fa-solid fa-envelope text-indigo-500 mr-1"></i> Notification email automatically sent to customer.</span>
            <span class="hidden sm:inline">Enter = Send &bull; Shift+Enter = Line break</span>
          </div>
        </div>

      </div>

    </main>

    <%- include('partials/footer') %> <%- include('partials/toastalerts') %>

    <script>
      (function() {
        let activeUserId = null;
        let activeUserData = null;
        let conversations = [];
        let loadedMessageIds = new Set();
        let pollTimer = null;

        const directoryView = document.getElementById("users-directory-view");
        const chatPanelView = document.getElementById("chat-panel-view");
        const usersGrid = document.getElementById("users-grid");
        const searchInput = document.getElementById("user-search-input");
        const usersCount = document.getElementById("users-count");
        const unreadTotalBadge = document.getElementById("unread-total-badge");
        const unreadTotalCount = document.getElementById("unread-total-count");

        const backBtn = document.getElementById("back-to-users-btn");
        const messagesContainer = document.getElementById("chat-messages-container");
        const inputField = document.getElementById("chat-input-field");
        const sendBtn = document.getElementById("chat-send-btn");

        const chatUserName = document.getElementById("chat-user-name");
        const chatUserEmail = document.getElementById("chat-user-email");
        const chatUserAccount = document.getElementById("chat-user-account");
        const chatUserBalance = document.getElementById("chat-user-balance");
        const chatUserCurrencyBadge = document.getElementById("chat-user-currency-badge");
        const chatUserAvatar = document.getElementById("chat-user-avatar");
        const chatLoginBtn = document.getElementById("chat-login-as-user-btn");
        const chatViewBtn = document.getElementById("chat-view-user-btn");

        function formatTime(iso) {
          if (!iso) return "";
          const d = new Date(iso);
          if (isNaN(d.getTime())) return "";
          const now = new Date();
          if (d.toDateString() === now.toDateString()) {
            return d.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
          }
          return d.toLocaleDateString([], { month: "short", day: "numeric" }) + " " + d.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
        }

        function scrollToBottom() {
          if (messagesContainer) {
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
          }
        }

        async function fetchConversations() {
          try {
            const res = await fetch("/admin/api/support-chat/conversations");
            if (!res.ok) return;
            const data = await res.json();
            if (data.success && Array.isArray(data.conversations)) {
              conversations = data.conversations;
              renderUsersDirectory();
            }
          } catch (err) {
            console.error("Error fetching conversations:", err);
          }
        }

        function renderUsersDirectory() {
          const query = (searchInput?.value || "").trim().toLowerCase();
          const filtered = conversations.filter(c => {
            const name = (c.user.Name || "").toLowerCase();
            const email = (c.user.Email || "").toLowerCase();
            const acct = (c.user.AccountNumber || "").toLowerCase();
            return name.includes(query) || email.includes(query) || acct.includes(query);
          });

          if (usersCount) usersCount.textContent = filtered.length;

          // Unread badge count
          const totalUnread = conversations.reduce((acc, c) => acc + (c.unreadCount || 0), 0);
          if (unreadTotalBadge && unreadTotalCount) {
            if (totalUnread > 0) {
              unreadTotalCount.textContent = totalUnread;
              unreadTotalBadge.classList.remove("hidden");
              unreadTotalBadge.classList.add("inline-flex");
            } else {
              unreadTotalBadge.classList.add("hidden");
              unreadTotalBadge.classList.remove("inline-flex");
            }
          }

          if (filtered.length === 0) {
            usersGrid.innerHTML = `
              <div class="col-span-full p-12 text-center text-gray-400 bg-white rounded-2xl border border-gray-200">
                <i class="fa-solid fa-user-slash text-3xl mb-2 text-gray-300"></i>
                <p class="text-sm font-semibold text-gray-600">No matching users found.</p>
                <p class="text-xs text-gray-400 mt-1">Try searching with a different name, email, or account number.</p>
              </div>
            `;
            return;
          }

          usersGrid.innerHTML = filtered.map(c => {
            const initials = (c.user.Name || "U").slice(0, 2).toUpperCase();
            const lastMsgText = c.lastMessage ? c.lastMessage.message : "No messages yet";
            const lastTime = c.lastMessage ? formatTime(c.lastMessage.createdAt) : "New";
            const hasUnread = c.unreadCount > 0;
            const balanceText = c.user.formattedBalance || ((c.user.currencySymbol || '$') + Number(c.user.AccountBalance || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }));
            const currCode = c.user.currencyCode || 'USD';

            return `
              <div
                onclick="openChatPanel('${c.user._id}')"
                class="bg-white rounded-2xl p-4 sm:p-5 border transition-all duration-200 cursor-pointer shadow-sm hover:shadow-md flex flex-col justify-between group ${
                  hasUnread ? 'border-indigo-400 ring-2 ring-indigo-500/20 bg-indigo-50/20' : 'border-gray-200 hover:border-indigo-300'
                }"
              >
                <div>
                  <div class="flex items-start justify-between gap-3 mb-3">
                    <div class="flex items-center gap-3 min-w-0">
                      <div class="relative flex-shrink-0">
                        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-indigo-500 to-indigo-700 text-white font-bold flex items-center justify-center text-sm shadow-sm group-hover:scale-105 transition-transform">
                          ${initials}
                        </div>
                        ${hasUnread ? '<span class="absolute -top-1 -right-1 w-3.5 h-3.5 bg-red-500 ring-2 ring-white rounded-full"></span>' : ''}
                      </div>
                      <div class="min-w-0">
                        <h3 class="text-xs sm:text-sm font-bold text-gray-900 truncate group-hover:text-indigo-600 transition">${c.user.Name}</h3>
                        <p class="text-[11px] sm:text-xs text-gray-500 truncate">${c.user.Email}</p>
                      </div>
                    </div>

                    <div class="flex flex-col items-end flex-shrink-0">
                      ${hasUnread ? `<span class="px-2 py-0.5 bg-red-500 text-white text-[10px] font-bold rounded-full mb-1 shadow-sm">${c.unreadCount} New</span>` : ''}
                      <span class="text-[10px] text-gray-400 font-medium">${lastTime}</span>
                    </div>
                  </div>

                  <div class="bg-slate-50 rounded-xl p-2.5 mb-3 border border-slate-100">
                    <div class="flex items-center justify-between text-xs mb-1">
                      <span class="text-[10px] sm:text-[11px] text-gray-500 font-mono font-medium">ACCT: ${c.user.AccountNumber}</span>
                      <span class="font-bold text-gray-900 text-xs">${balanceText} (${currCode})</span>
                    </div>
                    <p class="text-xs text-gray-600 line-clamp-2 italic font-normal">
                      ${c.lastMessage && c.lastMessage.sender === 'admin' ? '<strong class="text-indigo-600 not-italic">You: </strong>' : ''}${lastMsgText}
                    </p>
                  </div>
                </div>

                <div class="flex items-center justify-between pt-2 border-t border-gray-100">
                  <span class="text-[11px] font-semibold text-indigo-600 flex items-center gap-1 group-hover:underline">
                    <span>Open Conversation</span>
                    <i class="fa-solid fa-arrow-right text-[10px]"></i>
                  </span>
                  <span class="text-[10px] text-gray-400 uppercase font-semibold">Click to Chat</span>
                </div>
              </div>
            `;
          }).join("");
        }

        window.openChatPanel = async function(userId) {
          activeUserId = userId;
          const conv = conversations.find(c => c.user._id === userId);
          if (!conv) return;
          activeUserData = conv.user;

          // Update header details
          chatUserName.textContent = activeUserData.Name;
          chatUserEmail.textContent = activeUserData.Email;
          chatUserAccount.textContent = `ACCT: ${activeUserData.AccountNumber}`;
          chatUserBalance.textContent = activeUserData.formattedBalance || ((activeUserData.currencySymbol || '$') + Number(activeUserData.AccountBalance || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }));
          chatUserCurrencyBadge.textContent = activeUserData.currencyCode || 'USD';
          chatUserAvatar.textContent = (activeUserData.Name || "U").slice(0, 2).toUpperCase();
          chatLoginBtn.href = `/admin/users/${activeUserData._id}/login-as-user`;
          chatViewBtn.href = `/admin/users/${activeUserData._id}`;

          // Hide users directory, show chat panel
          directoryView.classList.add("hidden");
          chatPanelView.classList.remove("hidden");

          loadedMessageIds.clear();
          messagesContainer.innerHTML = `
            <div class="p-12 text-center text-xs text-gray-400">
              <i class="fa-solid fa-spinner fa-spin text-indigo-600 text-2xl mb-2"></i>
              <p class="font-medium">Loading message history...</p>
            </div>
          `;

          await fetchActiveMessages();
          if (inputField) inputField.focus();
        };

        window.closeChatPanel = function() {
          activeUserId = null;
          activeUserData = null;
          chatPanelView.classList.add("hidden");
          directoryView.classList.remove("hidden");
          fetchConversations();
        };

        if (backBtn) {
          backBtn.addEventListener("click", window.closeChatPanel);
        }

        async function fetchActiveMessages() {
          if (!activeUserId) return;
          try {
            const res = await fetch(`/admin/api/support-chat/messages/${activeUserId}`);
            if (!res.ok) return;
            const data = await res.json();
            if (data.success && Array.isArray(data.messages)) {
              if (messagesContainer.querySelector(".fa-spinner")) {
                messagesContainer.innerHTML = "";
              }
              if (data.messages.length === 0) {
                messagesContainer.innerHTML = `
                  <div class="p-12 text-center text-gray-400">
                    <div class="w-12 h-12 rounded-full bg-indigo-50 text-indigo-500 flex items-center justify-center text-xl mx-auto mb-2">
                      <i class="fa-solid fa-comments"></i>
                    </div>
                    <p class="text-sm font-semibold text-gray-700">No message history yet</p>
                    <p class="text-xs text-gray-400 mt-1">Send a message below to start the support conversation with this customer.</p>
                  </div>
                `;
              } else {
                data.messages.forEach(renderChatMessage);
              }
            }
          } catch (err) {
            console.error("Error loading chat messages:", err);
          }
        }

        function renderChatMessage(msg) {
          if (loadedMessageIds.has(msg.id)) return;
          loadedMessageIds.add(msg.id);

          if (messagesContainer.querySelector(".fa-comments") || messagesContainer.querySelector(".fa-spinner")) {
            messagesContainer.innerHTML = "";
          }

          const isAdmin = msg.sender === "admin";
          const wrapper = document.createElement("div");

          if (isAdmin) {
            wrapper.className = "flex justify-end";
            wrapper.innerHTML = `
              <div class="max-w-[85%] sm:max-w-[70%] bg-indigo-600 text-white rounded-2xl rounded-tr-sm px-3.5 py-2 sm:px-4 sm:py-2.5 shadow-sm text-xs sm:text-sm leading-relaxed break-words">
                <div class="text-[10px] text-indigo-200 font-semibold mb-0.5 flex items-center justify-between gap-2">
                  <span>${msg.adminName || 'Support Specialist'}</span>
                  <span><i class="fa-solid fa-headset text-[9px]"></i> Support</span>
                </div>
                <p class="whitespace-pre-wrap font-normal">${msg.message}</p>
                <div class="flex items-center justify-end gap-1 text-[10px] text-indigo-200 mt-1">
                  <span>${formatTime(msg.createdAt)}</span>
                  <i class="fa-solid fa-check-double text-[9px] text-indigo-300"></i>
                </div>
              </div>
            `;
          } else {
            wrapper.className = "flex justify-start";
            wrapper.innerHTML = `
              <div class="max-w-[85%] sm:max-w-[70%] bg-white text-gray-800 border border-gray-200 rounded-2xl rounded-tl-sm px-3.5 py-2 sm:px-4 sm:py-2.5 shadow-sm text-xs sm:text-sm leading-relaxed break-words">
                <div class="text-[10px] text-indigo-600 font-bold mb-0.5 flex items-center justify-between gap-2">
                  <span>${activeUserData?.Name || 'Customer'}</span>
                  <span><i class="fa-solid fa-user text-[9px]"></i> User</span>
                </div>
                <p class="whitespace-pre-wrap font-normal text-gray-800">${msg.message}</p>
                <span class="block text-[10px] text-gray-400 text-right mt-1">${formatTime(msg.createdAt)}</span>
              </div>
            `;
          }

          messagesContainer.appendChild(wrapper);
          scrollToBottom();
        }

        async function handleSendAdmin() {
          if (!activeUserId) return;
          const text = (inputField?.value || "").trim();
          if (!text) return;

          inputField.value = "";
          if (sendBtn) sendBtn.disabled = true;

          // Optimistically render
          renderChatMessage({
            id: "temp-" + Date.now(),
            sender: "admin",
            adminName: "Support Specialist",
            message: text,
            createdAt: new Date().toISOString(),
          });

          try {
            const res = await fetch(`/admin/api/support-chat/send/${activeUserId}`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ message: text }),
            });
            const data = await res.json();
            if (data.success && data.message) {
              loadedMessageIds.add(data.message.id);
            }
          } catch (err) {
            console.error("Failed to send admin message:", err);
          } finally {
            if (sendBtn) sendBtn.disabled = false;
            fetchConversations();
          }
        }

        if (sendBtn) sendBtn.addEventListener("click", handleSendAdmin);
        if (inputField) {
          inputField.addEventListener("keydown", (e) => {
            if (e.key === "Enter" && !e.shiftKey) {
              e.preventDefault();
              handleSendAdmin();
            }
          });
        }
        if (searchInput) {
          searchInput.addEventListener("input", renderUsersDirectory);
        }

        // Auto-select user if URL has query ?userId=...
        const urlParams = new URLSearchParams(window.location.search);
        const preselectId = urlParams.get("userId");

        fetchConversations().then(() => {
          if (preselectId) {
            openChatPanel(preselectId);
          }
        });

        // Polling loop
        pollTimer = setInterval(() => {
          if (activeUserId) {
            fetchActiveMessages();
          } else {
            fetchConversations();
          }
        }, 3500);

      })();
    </script>
  </body>
</html>
