<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capital Trust Bank - KYC Details</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      rel="stylesheet"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank"
    />
  </head>
  <body class="bg-gradient-to-br from-slate-50 via-indigo-50/30 to-slate-50 min-h-screen">
    <%- include('partials/header') %> <%- include('partials/sidebar') %>

    <main class="ml-0 lg:ml-64 mt-20 p-6">
      <div class="mb-6">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">KYC Details</h1>
        <p class="text-sm text-gray-600">Detailed view of user KYC information and documents.</p>
      </div>

      <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- User Info -->
          <div>
            <h2 class="text-xl font-semibold text-gray-800 mb-4">
              User Information
            </h2>
            <p><strong>Name:</strong> <%= kyc.userId.Name %></p>
            <p><strong>Email:</strong> <%= kyc.userId.Email %></p>
            <p>
              <strong>Account Number:</strong> <%= kyc.userId.AccountNumber %>
            </p>
          </div>

          <!-- KYC Info -->
          <div>
            <h2 class="text-xl font-semibold text-gray-800 mb-4">
              KYC Information
            </h2>
            <p><strong>Country:</strong> <%= kyc.country %></p>
            <p><strong>Nationality:</strong> <%= kyc.nationality %></p>
            <p><strong>Address:</strong> <%= kyc.residentialAddress %></p>
            <p><strong>Occupation:</strong> <%= kyc.occupation %></p>
            <p><strong>Account Category:</strong> <%= kyc.accountCategory %></p>
            <p>
              <strong>Current Status:</strong> <%= kyc.verified ? 'Verified' :
              'Pending' %>
            </p>
            <p>
              <strong>Submitted:</strong> <%= new
              Date(kyc.createdAt).toLocaleDateString() %>
            </p>
          </div>
        </div>

        <!-- Documents Section -->
        <div class="mt-6 pt-6 border-t">
          <h3 class="text-lg font-semibold text-gray-800 mb-4">
            Uploaded Verification Documents
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- ID Front -->
            <% if (kyc.idFront) { %>
            <div class="border rounded-xl p-4 bg-gray-50 flex flex-col items-center">
              <p class="font-semibold text-gray-700 mb-3 w-full text-left">
                <i class="fa-solid fa-id-card mr-1 text-indigo-600"></i> ID Front / Document Front
              </p>
              <div class="w-full h-64 overflow-hidden rounded-lg border border-gray-200 bg-white flex items-center justify-center mb-3">
                <img 
                  src="<%= kyc.idFront %>" 
                  alt="ID Front" 
                  class="max-h-full max-w-full object-contain cursor-pointer hover:scale-105 transition duration-300"
                  onclick="window.open('<%= kyc.idFront %>', '_blank')"
                />
              </div>
              <a
                href="<%= kyc.idFront %>"
                target="_blank"
                class="px-4 py-2 bg-indigo-50 text-indigo-700 font-semibold rounded-lg hover:bg-indigo-100 transition text-sm flex items-center gap-1.5"
              >
                <i class="fa-solid fa-up-right-from-square"></i> Open in New Tab
              </a>
            </div>
            <% } %>

            <!-- ID Back -->
            <% if (kyc.idBack) { %>
            <div class="border rounded-xl p-4 bg-gray-50 flex flex-col items-center">
              <p class="font-semibold text-gray-700 mb-3 w-full text-left">
                <i class="fa-solid fa-id-card mr-1 text-indigo-600"></i> ID Back / Document Back
              </p>
              <div class="w-full h-64 overflow-hidden rounded-lg border border-gray-200 bg-white flex items-center justify-center mb-3">
                <img 
                  src="<%= kyc.idBack %>" 
                  alt="ID Back" 
                  class="max-h-full max-w-full object-contain cursor-pointer hover:scale-105 transition duration-300"
                  onclick="window.open('<%= kyc.idBack %>', '_blank')"
                />
              </div>
              <a
                href="<%= kyc.idBack %>"
                target="_blank"
                class="px-4 py-2 bg-indigo-50 text-indigo-700 font-semibold rounded-lg hover:bg-indigo-100 transition text-sm flex items-center gap-1.5"
              >
                <i class="fa-solid fa-up-right-from-square"></i> Open in New Tab
              </a>
            </div>
            <% } %>

            <% if (!kyc.idFront && !kyc.idBack) { %>
            <div class="col-span-2 text-center py-6 bg-amber-50 border border-amber-100 text-amber-800 rounded-xl">
              <i class="fa-solid fa-triangle-exclamation text-lg mb-1"></i>
              <p class="font-semibold text-sm">No identification documents uploaded for this KYC request.</p>
            </div>
            <% } %>
          </div>
        </div>

        <!-- Actions -->
        <div class="mt-6 pt-6 border-t">
          <h3 class="text-lg font-semibold text-gray-800 mb-4">Actions</h3>
          <div class="flex gap-4">
            <button
              onclick="approveKYC('<%= kyc._id %>')"
              class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700"
            >
              Approve KYC
            </button>
            <button
              onclick="declineKYC('<%= kyc._id %>')"
              class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700"
            >
              Decline KYC
            </button>
            <a
              href="/admin/kyc"
              class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700"
              >Back to List</a
            >
          </div>
        </div>
      </div>
    </main>

    <%- include('partials/footer') %> <%- include('partials/toastalerts') %> <%- include('partials/confirmation-modal') %>

    <script>
      async function approveKYC(kycId) {
        showConfirmation(
          'Approve KYC',
          'Are you sure you want to approve this KYC verification? The user will be verified.',
          async () => {
            try {
              const response = await fetch(`/admin/kyc/${kycId}/approve`, {
                method: "POST",
              });
              const result = await response.json();
              if (response.ok) {
                showSuccess('Success', result.message, () => {
                  setTimeout(() => (window.location.href = "/admin/kyc"), 1000);
                });
              } else {
                showError('Error', result.error || "Approval failed");
              }
            } catch (err) {
              showError('Error', "Server error. Please try again.");
            }
          },
          'Approve',
          'Cancel'
        );
      }

      async function declineKYC(kycId) {
        showConfirmation(
          'Decline KYC',
          'Are you sure you want to decline this KYC verification? This action cannot be undone.',
          async () => {
            try {
              const response = await fetch(`/admin/kyc/${kycId}/decline`, {
                method: "POST",
              });
              const result = await response.json();
              if (response.ok) {
                showSuccess('Success', result.message, () => {
                  setTimeout(() => (window.location.href = "/admin/kyc"), 1000);
                });
              } else {
                showError('Error', result.error || "Decline failed");
              }
            } catch (err) {
              showError('Error', "Server error. Please try again.");
            }
          },
          'Decline',
          'Cancel'
        );
      }
    </script>
  </body>
</html>
