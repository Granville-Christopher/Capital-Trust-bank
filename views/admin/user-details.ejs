<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capital Trust Bank - User Details</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      rel="stylesheet"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank"
    />
  </head>
  <body class="bg-gray-100 min-h-screen">
    <%- include('partials/header') %> <%- include('partials/sidebar') %>

    <main class="ml-0 lg:ml-64 mt-20 p-6">
      <h1 class="text-2xl font-bold text-gray-800 mb-6">User Details</h1>

      <div class="bg-white rounded-xl shadow p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- User Info -->
          <div>
            <h2 class="text-xl font-semibold text-gray-800 mb-4">
              User Information
            </h2>
            <p><strong>Name:</strong> <%= user.Name %></p>
            <p><strong>Email:</strong> <%= user.Email %></p>
            <p><strong>Account Number:</strong> <%= user.AccountNumber %></p>
            <p><strong>Balance:</strong> $<%= user.AccountBalance %></p>
            <p><strong>Role:</strong> <%= user.role %></p>
            <p>
              <strong>Created:</strong> <%= new
              Date(user.createdAt).toLocaleDateString() %>
            </p>
          </div>

          <!-- KYC Info -->
          <% if (kyc) { %>
          <div>
            <h2 class="text-xl font-semibold text-gray-800 mb-4">
              KYC Information
            </h2>
            <p><strong>Country:</strong> <%= kyc.country %></p>
            <p><strong>Nationality:</strong> <%= kyc.nationality %></p>
            <p><strong>Address:</strong> <%= kyc.residentialAddress %></p>
            <p><strong>Occupation:</strong> <%= kyc.occupation %></p>
            <p><strong>Account Category:</strong> <%= kyc.accountCategory %></p>
            <p><strong>Verified:</strong> <%= kyc.verified ? 'Yes' : 'No' %></p>
          </div>
          <% } else { %>
          <div>
            <h2 class="text-xl font-semibold text-gray-800 mb-4">
              KYC Information
            </h2>
            <p>No KYC information available.</p>
          </div>
          <% } %>
        </div>

        <!-- Actions -->
        <div class="mt-6 pt-6 border-t">
          <h3 class="text-lg font-semibold text-gray-800 mb-4">Actions</h3>

          <!-- Update Balance Form -->
          <div class="mb-4">
            <h4 class="font-medium text-gray-700 mb-2">Update Balance</h4>
            <form id="balance-form" class="flex gap-2">
              <select name="action" class="px-3 py-2 border rounded-lg">
                <option value="add">Add</option>
                <option value="decrease">Decrease</option>
              </select>
              <input
                type="number"
                name="amount"
                placeholder="Amount"
                step="0.01"
                min="0"
                class="px-3 py-2 border rounded-lg w-32"
                required
              />
              <button
                type="submit"
                class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700"
              >
                Update
              </button>
            </form>
          </div>

          <!-- Delete User -->
          <form
            action="/admin/users/<%= user._id %>/delete"
            method="POST"
            class="inline"
          >
            <button
              type="submit"
              class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700"
              onclick="return confirm('Are you sure you want to delete this user?')"
            >
              Delete User
            </button>
          </form>
        </div>
      </div>
    </main>

    <%- include('partials/footer') %> <%- include('partials/toastalerts') %>

    <script>
      document
        .getElementById("balance-form")
        .addEventListener("submit", async (e) => {
          e.preventDefault();
          const data = {
            userId: "<%= user._id %>",
            action: e.target.action.value,
            amount: e.target.amount.value,
          };

          try {
            const response = await fetch("/admin/users/update-balance", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify(data),
            });
            const result = await response.json();
            if (response.ok) {
              showToast("success", result.message);
              setTimeout(() => location.reload(), 1500);
            } else {
              showToast("error", result.error || "Update failed");
            }
          } catch (err) {
            showToast("error", "Server error");
          }
        });
    </script>
  </body>
</html>
