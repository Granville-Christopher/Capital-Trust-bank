<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capital Trust Bank - KYC Verification</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      rel="stylesheet"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank"
    />
  </head>
  <body class="bg-gradient-to-br from-slate-50 via-indigo-50/30 to-slate-50 min-h-screen">
    <%- include('partials/header') %> <%- include('partials/sidebar') %>

    <main class="ml-0 lg:ml-64 mt-20 p-6">
      <div class="mb-6">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">KYC Verification</h1>
        <p class="text-sm text-gray-600">Review and verify user identity documents and information.</p>
      </div>

      <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-6">
        <div class="overflow-x-auto">
          <table class="min-w-full table-auto">
            <thead>
              <tr class="bg-gray-50">
                <th
                  class="px-4 py-2 text-left text-sm font-medium text-gray-700"
                >
                  User Name
                </th>
                <th
                  class="px-4 py-2 text-left text-sm font-medium text-gray-700"
                >
                  Email
                </th>
                <th
                  class="px-4 py-2 text-left text-sm font-medium text-gray-700"
                >
                  Submission Date
                </th>
                <th
                  class="px-4 py-2 text-left text-sm font-medium text-gray-700"
                >
                  Actions
                </th>
              </tr>
            </thead>
            <tbody>
              <% kycs.forEach(kyc => { %>
              <tr class="border-t">
                <td class="px-4 py-2 text-sm text-gray-900">
                  <%= kyc.userId.Name %>
                </td>
                <td class="px-4 py-2 text-sm text-gray-900">
                  <%= kyc.userId.Email %>
                </td>
                <td class="px-4 py-2 text-sm text-gray-900">
                  <%= new Date(kyc.createdAt).toLocaleDateString() %>
                </td>
                <td class="px-4 py-2 text-sm">
                  <a
                    href="/admin/kyc/<%= kyc._id %>"
                    class="text-blue-600 hover:text-blue-800 mr-2"
                    >View</a
                  >
                  <button
                    onclick="approveKYC('<%= kyc._id %>')"
                    class="text-green-600 hover:text-green-800 mr-2"
                  >
                    Approve
                  </button>
                  <button
                    onclick="declineKYC('<%= kyc._id %>')"
                    class="text-red-600 hover:text-red-800"
                  >
                    Decline
                  </button>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </main>

    <%- include('partials/footer') %> <%- include('partials/toastalerts') %> <%- include('partials/confirmation-modal') %>

    <script>
      async function approveKYC(kycId) {
        showConfirmation(
          'Approve KYC',
          'Are you sure you want to approve this KYC verification? The user will be verified.',
          async () => {
            try {
              const response = await fetch(`/admin/kyc/${kycId}/approve`, {
                method: "POST",
              });
              const result = await response.json();
              if (response.ok) {
                showSuccess('Success', result.message, () => {
                  setTimeout(() => location.reload(), 1000);
                });
              } else {
                showError('Error', result.error || "Approval failed");
              }
            } catch (err) {
              showError('Error', "Server error. Please try again.");
            }
          },
          'Approve',
          'Cancel'
        );
      }

      async function declineKYC(kycId) {
        showConfirmation(
          'Decline KYC',
          'Are you sure you want to decline this KYC verification? This action cannot be undone.',
          async () => {
            try {
              const response = await fetch(`/admin/kyc/${kycId}/decline`, {
                method: "POST",
              });
              const result = await response.json();
              if (response.ok) {
                showSuccess('Success', result.message, () => {
                  setTimeout(() => location.reload(), 1000);
                });
              } else {
                showError('Error', result.error || "Decline failed");
              }
            } catch (err) {
              showError('Error', "Server error. Please try again.");
            }
          },
          'Decline',
          'Cancel'
        );
      }
    </script>
  </body>
</html>
