 <!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Change Account Password</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
</head>

<body class="bg-gradient-to-b from-blue-100 to-gray-100 min-h-screen p-6 flex flex-col justify-center items-center">
    <div class="bg-white rounded-xl shadow p-6 max-w-sm w-full text-center">
        <h2 class="text-xl font-semibold text-gray-800 mb-6">Change Account Password</h2>

        <form id="changePasswordForm" class="space-y-4">
            <div class="relative">
                <input type="password" id="oldPassword" placeholder="Old Password" maxlength="50"
                    class="w-full py-3 px-4 rounded-full border-2 border-blue-600 text-center text-lg outline-none" />
                <i class="fa fa-eye absolute right-4 top-3 cursor-pointer text-gray-500" onclick="togglePassword('oldPassword', this)"></i>
            </div>
            <div class="relative">
                <input type="password" id="newPassword" placeholder="New Password" maxlength="50"
                    class="w-full py-3 px-4 rounded-full border-2 border-blue-600 text-center text-lg outline-none" />
                <i class="fa fa-eye absolute right-4 top-3 cursor-pointer text-gray-500" onclick="togglePassword('newPassword', this)"></i>
            </div>
            <div class="relative">
                <input type="password" id="confirmNewPassword" placeholder="Confirm New Password" maxlength="50"
                    class="w-full py-3 px-4 rounded-full border-2 border-blue-600 text-center text-lg outline-none" />
                <i class="fa fa-eye absolute right-4 top-3 cursor-pointer text-gray-500" onclick="togglePassword('confirmNewPassword', this)"></i>
            </div>

            <button type="submit"
                class="w-full py-3 bg-blue-600 text-white rounded-full font-medium hover:bg-blue-700 transition">
                Change Password
            </button>
        </form>
    </div>

    <!-- Generating Modal -->
    <div id="generatingModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
        <div class="bg-white rounded-xl shadow-xl p-6 w-full max-w-sm text-center">
            <i class="fa-solid fa-spinner fa-spin text-blue-600 text-4xl mb-4"></i>
            <h3 class="text-lg font-semibold">Changing Password...</h3>
            <p class="text-sm text-gray-500">Please wait while we update your password.</p>
        </div>
    </div>

    <!-- Success/Failure Modal -->
    <div id="pinModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden">
        <div class="bg-white rounded-xl shadow-xl p-6 w-full max-w-sm text-center relative animate-fadeIn">

            <!-- Success Icon -->
            <div id="successIcon" class="mb-4">
                <i class="fa-solid fa-circle-check text-green-500 text-5xl animate-bounce"></i>
                <h3 class="mt-2 text-xl font-semibold text-gray-800">Password Changed Successfully</h3>
                <p class="text-sm text-gray-500">Your account password has been updated.</p>
            </div>

            <!-- Failure Icon (hidden by default) -->
            <div id="failureIcon" class="mb-4 hidden">
                <i class="fa-solid fa-circle-xmark text-red-500 text-5xl animate-shake"></i>
                <h3 class="mt-2 text-xl font-semibold text-gray-800">Failed to Change Password</h3>
                <p class="text-sm text-gray-500">Something went wrong. Please try again.</p>
            </div>

            <!-- Close Button -->
            <button onclick="closePinModal()"
                class="mt-6 w-full py-2 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition">
                Close
            </button>
        </div>
    </div>

    <script>
        function togglePassword(inputId, icon) {
            const input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }

        const generatingModal = document.getElementById("generatingModal");
        const pinModal = document.getElementById("pinModal");
        const successIcon = document.getElementById("successIcon");
        const failureIcon = document.getElementById("failureIcon");

        function closePinModal() {
            pinModal.classList.add("hidden");
        }
        window.closePinModal = closePinModal;

        document.getElementById("changePasswordForm").addEventListener("submit", function (e) {
            e.preventDefault();
            generatingModal.classList.remove("hidden");
            // Simulate async operation
            setTimeout(() => {
                generatingModal.classList.add("hidden");
                successIcon.classList.remove("hidden");
                failureIcon.classList.add("hidden");
                pinModal.classList.remove("hidden");
            }, 2000);
        });
    </script>
</body>
</html>
