<%- include('partials/toastalerts')%>

    <body class="bg-gradient-to-b from-blue-100 to-gray-100 min-h-screen p-6 flex flex-col justify-center items-center">
        <div class="bg-white rounded-xl shadow p-6 max-w-sm w-full text-center">
            <h2 class="text-xl font-semibold text-gray-800 mb-6">Change Account Password</h2>

            <form id="changePasswordForm" class="space-y-4">
                <div class="relative">
                    <input type="password" id="oldPassword" placeholder="Old Password" maxlength="50"
                        class="w-full py-3 px-4 rounded-full border-2 border-blue-600 text-center text-lg outline-none" />
                    <i class="fa fa-eye absolute right-4 top-3 cursor-pointer text-gray-500"
                        onclick="togglePassword('oldPassword', this)"></i>
                </div>
                <div class="relative">
                    <input type="password" id="newPassword" placeholder="New Password" maxlength="50"
                        class="w-full py-3 px-4 rounded-full border-2 border-blue-600 text-center text-lg outline-none" />
                    <i class="fa fa-eye absolute right-4 top-3 cursor-pointer text-gray-500"
                        onclick="togglePassword('newPassword', this)"></i>
                </div>
                <div class="relative">
                    <input type="password" id="confirmNewPassword" placeholder="Confirm New Password" maxlength="50"
                        class="w-full py-3 px-4 rounded-full border-2 border-blue-600 text-center text-lg outline-none" />
                    <i class="fa fa-eye absolute right-4 top-3 cursor-pointer text-gray-500"
                        onclick="togglePassword('confirmNewPassword', this)"></i>
                </div>

                <button type="submit"
                    class="w-full py-3 bg-blue-600 text-white rounded-full font-medium hover:bg-blue-700 transition">
                    Change Password
                </button>
            </form>
        </div>

        <div id="generatingModal"
            class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
            <div class="bg-white rounded-xl shadow-xl p-6 w-full max-w-sm text-center">
                <i class="fa-solid fa-spinner fa-spin text-blue-600 text-4xl mb-4"></i>
                <h3 class="text-lg font-semibold">Changing Password...</h3>
                <p class="text-sm text-gray-500">Please wait while we update your password.</p>
            </div>
        </div>

        <div id="pinModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden">
            <div class="bg-white rounded-xl shadow-xl p-6 w-full max-w-sm text-center relative animate-fadeIn">

                <div id="successIcon" class="mb-4">
                    <i class="fa-solid fa-circle-check text-green-500 text-5xl animate-bounce"></i>
                    <h3 class="mt-2 text-xl font-semibold text-gray-800">Password Changed Successfully</h3>
                    <p class="text-sm text-gray-500">Your account password has been updated.</p>
                </div>

                <div id="failureIcon" class="mb-4 hidden">
                    <i class="fa-solid fa-circle-xmark text-red-500 text-5xl animate-shake"></i>
                    <h3 class="mt-2 text-xl font-semibold text-gray-800">Failed to Change Password</h3>
                    <p id="failureMessage" class="text-sm text-gray-500">Something went wrong. Please try again.</p>
                </div>

                <button onclick="closePinModal()"
                    class="mt-6 w-full py-2 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition">
                    Close
                </button>
            </div>
        </div>
        <script src="/js/auth/changeaccountloginpin.js"></script>
