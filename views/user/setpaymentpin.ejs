<%- include('partials/toastalerts')%>

    <body class="bg-gradient-to-b from-blue-100 to-gray-100 min-h-screen p-6 flex flex-col justify-center items-center">

        <div class="bg-white rounded-xl shadow p-6 max-w-sm w-full text-center">
            <div class="setpaymentpindsection">
                <% if (hasPin) { %>
                    <h2 class="text-xl font-semibold text-gray-800 mb-6">Payment PIN Already Set</h2>
                    <p class="mb-4">You have already set your payment PIN successfully.</p>
                    <p>
                        Want to change your PIN? Please go to
                        <a href="changepaymentpin" class="text-blue-600 underline">Change Payment
                            PIN</a>.
                    </p>
                    <p>
                        <a href="dashboard"> back to dashboard</a>
                    </p>
                    <% } else { %>
                        <h2 class="text-xl font-semibold text-gray-800 mb-6"> Set payment pin</h2>
                        <form id="setPinForm" class="space-y-4">
                            <div class="relative">
                                <input type="password" id="Pin" placeholder="New PIN" maxlength="4"
                                    class="w-full py-3 px-4 rounded-full border-2 border-blue-600 text-center text-lg outline-none" />
                                <i class="fa fa-eye absolute right-4 top-3 cursor-pointer text-gray-500"
                                    onclick="togglePassword('Pin', this)"></i>
                            </div>
                            <div class="relative">
                                <input type="password" id="confirmPin" placeholder="Confirm New PIN" maxlength="4"
                                    class="w-full py-3 px-4 rounded-full border-2 border-blue-600 text-center text-lg outline-none" />
                                <i class="fa fa-eye absolute right-4 top-3 cursor-pointer text-gray-500"
                                    onclick="togglePassword('confirmPin', this)"></i>
                            </div>

                            <button type="submit" id="confirmPin-btn"
                                class="w-full py-3 bg-blue-600 text-white rounded-full font-medium hover:bg-blue-700 transition duration-200 flex items-center justify-center">
                                <span id="confirmPin-text"> Set PIN</span>
                                <svg id="spinner" class="animate-spin h-5 w-5 ml-2 hidden text-white"
                                    xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"
                                        stroke-width="4">
                                    </circle>
                                    <path class="opacity-75" fill="currentColor"
                                        d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                                </svg>
                            </button>
                        </form>
                        <% } %>

                            <div id="generatingPinModal"
                                class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
                                <div class="bg-white rounded-xl shadow-xl p-6 w-full max-w-sm text-center">
                                    <i class="fa-solid fa-spinner fa-spin text-blue-600 text-4xl mb-4"></i>
                                    <h3 class="text-lg font-semibold">Setting Payment PIN...</h3>
                                    <p class="text-sm text-gray-500">Please wait while we update your payment PIN.</p>
                                </div>
                            </div>
                            <div id="pinsetModal"
                                class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden">
                                <div
                                    class="bg-white rounded-xl shadow-xl p-6 w-full max-w-sm text-center relative animate-fadeIn">

                                    <div id="successIcon" class="mb-4">
                                        <i class="fa-solid fa-circle-check text-green-500 text-5xl animate-bounce"></i>
                                        <h3 class="mt-2 text-xl font-semibold text-gray-800">Payment PIN Set
                                            Successfully</h3>
                                        <p class="text-sm text-gray-500">Your payment PIN has been Set.</p>
                                    </div>

                                    <div id="failureIcon" class="mb-4 hidden">
                                        <i class="fa-solid fa-circle-xmark text-red-500 text-5xl animate-shake"></i>
                                        <h3 class="mt-2 text-xl font-semibold text-gray-800">Failed to Set Payment PIN
                                        </h3>
                                        <p id="failureMessage" class="text-sm text-gray-500">Something went wrong.
                                            Please try again.</p>
                                    </div>

                                    <button onclick="closeSetPinModal()"
                                        class="mt-6 w-full py-2 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition">
                                        Close
                                    </button>
                                </div>
                            </div>
            </div>
        </div>

        <script src="/js/auth/setpaymentpin.js"></script>
