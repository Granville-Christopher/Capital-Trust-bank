<!DOCTYPE html>
<html lang="en">


<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capital Trust Bank - International transfer</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <link rel="icon" type="image/png" sizes="32x32" href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank" />
    <link rel="icon" type="image/png" sizes="16x16" href="https://placehold.co/16x16/2563EB/DBEAFE?text=CTBank" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://placehold.co/180x180/2563EB/DBEAFE?text=CTBank" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#2563EB" />

    <meta property="og:title" content="Capital Trust Bank - Secure & Modern Banking" />
    <meta property="og:description"
        content="Manage your finances with ease. Secure, fast, and reliable banking services for all your needs." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://capital-trust-bank-production.up.railway.app/" />
<meta property="og:image" content="https://capital-trust-bank-production.up.railway.app/images/hpg.jpg" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:site_name" content="Capital Trust Bank" />
    <meta property="og:locale" content="en_NG" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@CTBankOfficial" />
    <meta name="twitter:creator" content="@CTBankOfficial" />
    <meta name="twitter:title" content="Capital Trust Bank - Secure & Modern Banking" />
    <meta name="twitter:description"
        content="Manage your finances with ease. Secure, fast, and reliable banking services for all your needs." />
        <meta name="twitter:image" content="https://capital-trust-bank-production.up.railway.app/images/hpg.jpg" />


</head>
<%- include('partials/toastalerts')%>

    <body class="bg-gradient-to-b from-blue-100 to-gray-100 min-h-screen p-6 relative overflow-y-hidden">

        <div class=" flex justify-start">
            <a href="dashboard" class="text-blue-600 no-underline  hover:text-blue-800 text-sm">← Back to
                Dashboard</a>
        </div>
        <div class="mb-6 mt-8 flex items-center justify-center">
            <h2 class="text-xl font-semibold text-gray-800">
                <i class="fa-solid fa-globe text-blue-600 mr-2"></i>
                International Transfer
            </h2>
        </div>

        <div class="bg-white rounded-xl shadow p-6 max-w-xl mx-auto">
            <form id="internationaltransfer">
                <div class="mb-4">
                    <label class="block text-sm mb-1 text-gray-700">Recipient Full Name</label>
                    <input type="text" name="fName" id="fName" placeholder="John Doe"
                        class="w-full px-4 py-2 border border-blue-500 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-400" />
                </div>

                <div class="mb-4">
                    <label class="block text-sm mb-1 text-gray-700">Account Number</label>
                    <input type="text" name="Acount_number" id="Acount_number" placeholder="1234567890"
                        class="w-full px-4 py-2 border border-blue-500 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-400" />
                </div>

                <div class="mb-4">
                    <label class="block text-sm mb-1 text-gray-700">Recipient Bank</label>
                    <input type="text" name="Bank" id="Bank" placeholder="Bank Name"
                        class="w-full px-4 py-2 border border-blue-500 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-400" />
                </div>

                <div class="mb-6">
                    <label class="block text-sm mb-1 text-gray-700">Amount ($)</label>
                    <input type="number" name="Amount" id="Amount" placeholder="50000"
                        class="w-full px-4 py-2 border border-blue-500 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-400" />
                </div>

                <div class="mb-4">
                    <label class="block text-sm mb-1 text-gray-700">Recipient Address</label>
                    <input type="text" name="Address" id="Address" placeholder="123 Avenue, City, Country"
                        class="w-full px-4 py-2 border border-blue-500 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-400" />
                </div>

                <div class="mb-6">
                    <label class="block text-sm mb-1 text-gray-700">IBAN</label>
                    <input type="text" name="Iban" id="Iban" placeholder="DE89370400440532013000"
                        class="w-full px-4 py-2 border border-blue-500 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-400" />
                </div>

                <button type="submit" id="internationaltransfer-btn"
                    class="w-full py-2 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition duration-200 flex items-center justify-center">
                    <span id="internationaltransfer-text">Initiate transfer</span>
                    <svg id="spinner" class="animate-spin h-5 w-5 ml-2 hidden text-white"
                        xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4">
                        </circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                    </svg>
                </button>
            </form>
        </div>
        <script src="/js/auth/internationaltransfer.js"></script>
    </body>

</html>