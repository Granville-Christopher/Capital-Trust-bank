<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capital Trust Bank - Verify Transfer</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="icon" type="image/png" sizes="32x32" href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank" />
    <link rel="icon" type="image/png" sizes="16x16" href="https://placehold.co/16x16/2563EB/DBEAFE?text=CTBank" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://placehold.co/180x180/2563EB/DBEAFE?text=CTBank" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#4f46e5" />
</head>

<body class="bg-gradient-to-br from-slate-50 via-indigo-50/20 to-slate-50 min-h-screen pb-20">
    <div class="fixed top-0 left-0 right-0 bg-white/98 backdrop-blur-lg border-b border-gray-100 flex items-center px-4 py-3 z-30 shadow-sm">
        <a href="/udp/dashboard" class="text-red-600 hover:text-red-700 text-xs font-semibold flex items-center gap-1.5">
            <i class="fa-solid fa-xmark text-sm"></i> Cancel Payment
        </a>
    </div>

    <div class="pt-16 px-4 space-y-4">
        <div class="text-center mb-4">
            <div class="w-12 h-12 rounded-full bg-indigo-100 flex items-center justify-center mx-auto mb-2">
                <i class="fa-solid fa-key text-indigo-600 text-lg"></i>
            </div>
            <h2 class="text-base font-bold text-gray-800">Transfer Verification</h2>
            <p class="text-xs text-gray-500 mt-1">Enter the OTP sent to your email</p>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 max-w-sm mx-auto mb-4">
            <h3 class="text-sm font-bold text-gray-800 mb-3 flex items-center gap-1.5">
                <i class="fa-solid fa-money-bill-transfer text-indigo-600 text-sm"></i> Transfer Summary
            </h3>
            <div class="space-y-2">
                <div class="flex justify-between items-center pb-1.5 border-b border-gray-100">
                    <span class="text-xs font-semibold text-gray-600">Recipient:</span>
                    <span class="text-xs font-semibold text-gray-800"><%= transferDetails.FullName %></span>
                </div>
                <div class="flex justify-between items-center pb-1.5 border-b border-gray-100">
                    <span class="text-xs font-semibold text-gray-600">Account Number:</span>
                    <span class="text-xs font-semibold text-gray-800"><%= transferDetails.AccountNumber %></span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-xs font-semibold text-gray-600">Amount:</span>
                    <span class="text-base font-bold text-indigo-600">$<%= transferDetails.Amount %></span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 max-w-sm mx-auto">
            <form id="confirmtransfer">
                <input type="hidden" id="transferId" value="<%= transferDetails._id %>">

                <div class="flex justify-center gap-1.5 mb-4">
                    <input type="text" maxlength="1" class="otp-box w-10 h-12 text-center text-base font-bold border-2 border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" />
                    <input type="text" maxlength="1" class="otp-box w-10 h-12 text-center text-base font-bold border-2 border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" />
                    <input type="text" maxlength="1" class="otp-box w-10 h-12 text-center text-base font-bold border-2 border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" />
                    <input type="text" maxlength="1" class="otp-box w-10 h-12 text-center text-base font-bold border-2 border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" />
                    <input type="text" maxlength="1" class="otp-box w-10 h-12 text-center text-base font-bold border-2 border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" />
                    <input type="text" maxlength="1" class="otp-box w-10 h-12 text-center text-base font-bold border-2 border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" />
                </div>

                <!-- Payment PIN Section -->
                <div class="mt-4">
                    <p class="text-xs font-semibold text-gray-700 mb-2 text-center">Enter your 4-digit Payment PIN</p>
                    <div class="flex justify-center gap-2">
                        <input type="password" maxlength="1" class="pin-box w-10 h-12 text-center text-base font-bold border-2 border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" />
                        <input type="password" maxlength="1" class="pin-box w-10 h-12 text-center text-base font-bold border-2 border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" />
                        <input type="password" maxlength="1" class="pin-box w-10 h-12 text-center text-base font-bold border-2 border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" />
                        <input type="password" maxlength="1" class="pin-box w-10 h-12 text-center text-base font-bold border-2 border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" />
                    </div>
                </div>

                <button type="submit" id="confirmBtn"
                    class="w-full mt-4 py-2.5 bg-gradient-to-r from-indigo-600 to-indigo-700 text-white rounded-lg hover:from-indigo-700 hover:to-indigo-800 transition font-semibold shadow-md text-sm">
                    <span id="confirmText">Verify Transfer</span>
                    <svg id="confirmSpinner" class="animate-spin h-4 w-4 ml-2 hidden text-white inline"
                        xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                    </svg>
                </button>
            </form>
        </div>
    </div>

    <!-- Success/Failure Modal -->
    <div id="transferModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/50 backdrop-blur-sm">
        <div class="bg-white rounded-2xl shadow-2xl p-6 max-w-xs w-full mx-4 text-center">
            <!-- Success/Pending Icon -->
            <div id="successIcon" class="hidden mb-4">
                <div class="w-16 h-16 rounded-full bg-amber-100 flex items-center justify-center mx-auto">
                    <i class="fa-solid fa-clock-rotate-left text-amber-600 text-2xl"></i>
                </div>
                <h3 class="text-lg font-bold text-gray-800 mt-3">Transfer Pending</h3>
                <p id="successMessage" class="text-sm text-gray-500 mt-1">Your payment is being processed and will be completed within 2 hours.</p>
            </div>
            <!-- Failure Icon -->
            <div id="failureIcon" class="hidden mb-4">
                <div class="w-16 h-16 rounded-full bg-red-100 flex items-center justify-center mx-auto">
                    <i class="fa-solid fa-xmark text-red-600 text-2xl"></i>
                </div>
                <h3 class="text-lg font-bold text-gray-800 mt-3">Transfer Failed</h3>
                <p id="errorMessage" class="text-sm text-gray-500 mt-1">Something went wrong. Please try again.</p>
            </div>
            <button onclick="closeModal()" class="mt-4 w-full py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition font-semibold text-sm">
                Close
            </button>
        </div>
    </div>

    <div class="fixed bottom-0 left-0 right-0 bg-white/98 backdrop-blur-lg border-t border-gray-100 z-50">
        <div class="flex justify-around items-center px-4 py-2.5">
            <a href="/udp/dashboard" class="flex flex-col items-center gap-0.5 text-gray-600">
                <div class="w-9 h-9 rounded-lg flex items-center justify-center">
                    <i class="fa-solid fa-house text-sm"></i>
                </div>
                <span class="text-xs font-medium">Home</span>
            </a>
            <a href="/udp/finance" class="flex flex-col items-center gap-0.5 text-gray-600">
                <div class="w-9 h-9 rounded-lg flex items-center justify-center">
                    <i class="fa-solid fa-chart-line text-sm"></i>
                </div>
                <span class="text-xs font-medium">Finance</span>
            </a>
            <a href="/udp/cards" class="flex flex-col items-center gap-0.5 text-gray-600">
                <div class="w-9 h-9 rounded-lg flex items-center justify-center">
                    <i class="fa-solid fa-credit-card text-sm"></i>
                </div>
                <span class="text-xs font-medium">Cards</span>
            </a>
            <a href="/udp/profile" class="flex flex-col items-center gap-0.5 text-gray-600">
                <div class="w-9 h-9 rounded-lg flex items-center justify-center">
                    <i class="fa-solid fa-user text-sm"></i>
                </div>
                <span class="text-xs font-medium">Profile</span>
            </a>
        </div>
    </div>
    <script src="/js/auth/confirmtransfer.js"></script>
</body>

</html>
