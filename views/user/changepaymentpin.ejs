<!DOCTYPE html>
<html lang="en">


<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capital Trust Bank - Change payment pin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <link rel="icon" type="image/png" sizes="32x32" href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank" />
    <link rel="icon" type="image/png" sizes="16x16" href="https://placehold.co/16x16/2563EB/DBEAFE?text=CTBank" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://placehold.co/180x180/2563EB/DBEAFE?text=CTBank" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#2563EB" />

    <meta property="og:title" content="Capital Trust Bank - Secure & Modern Banking" />
    <meta property="og:description"
        content="Manage your finances with ease. Secure, fast, and reliable banking services for all your needs." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://capital-trust-bank-production.up.railway.app/" />
<meta property="og:image" content="https://capital-trust-bank-production.up.railway.app/images/hpg.jpg" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:site_name" content="Capital Trust Bank" />
    <meta property="og:locale" content="en_NG" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@CTBankOfficial" />
    <meta name="twitter:creator" content="@CTBankOfficial" />
    <meta name="twitter:title" content="Capital Trust Bank - Secure & Modern Banking" />
    <meta name="twitter:description"
        content="Manage your finances with ease. Secure, fast, and reliable banking services for all your needs." />
        <meta name="twitter:image" content="https://capital-trust-bank-production.up.railway.app/images/hpg.jpg" />


</head>
<%- include('partials/toastalerts')%>

    <body class="bg-gradient-to-b from-blue-100 to-gray-100 min-h-screen p-6 flex flex-col justify-center items-center">

        <div class="bg-white rounded-xl shadow p-6 max-w-sm w-full text-center">

            <div class="changepaymentpinsection mt-28">
                <h2 class="text-xl font-semibold text-gray-800 mb-6">Change Payment PIN</h2>

                <form id="changePinForm" class="space-y-4">
                    <div class="relative">
                        <input type="password" id="oldPin" placeholder="Old PIN" maxlength="4"
                            class="w-full py-3 px-4 rounded-full border-2 border-blue-600 text-center text-lg outline-none" />
                        <i class="fa fa-eye absolute right-4 top-3 cursor-pointer text-gray-500"
                            onclick="togglePassword('oldPin', this)"></i>
                    </div>
                    <div class="relative">
                        <input type="password" id="newPin" placeholder="New PIN" maxlength="4"
                            class="w-full py-3 px-4 rounded-full border-2 border-blue-600 text-center text-lg outline-none" />
                        <i class="fa fa-eye absolute right-4 top-3 cursor-pointer text-gray-500"
                            onclick="togglePassword('newPin', this)"></i>
                    </div>
                    <div class="relative">
                        <input type="password" id="confirmNewPin" placeholder="Confirm New PIN" maxlength="4"
                            class="w-full py-3 px-4 rounded-full border-2 border-blue-600 text-center text-lg outline-none" />
                        <i class="fa fa-eye absolute right-4 top-3 cursor-pointer text-gray-500"
                            onclick="togglePassword('confirmNewPin', this)"></i>
                    </div>

                    <button type="submit"
                        class="w-full py-3 bg-blue-600 text-white rounded-full font-medium hover:bg-blue-700 transition">
                        Change PIN
                    </button>
                </form>
            </div>
        </div>

        <div id="generatingModal"
            class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
            <div class="bg-white rounded-xl shadow-xl p-6 w-full max-w-sm text-center">
                <i class="fa-solid fa-spinner fa-spin text-blue-600 text-4xl mb-4"></i>
                <h3 class="text-lg font-semibold">Changing Payment PIN...</h3>
                <p class="text-sm text-gray-500">Please wait while we update your payment PIN.</p>
            </div>
        </div>

        <div id="pinModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden">
            <div class="bg-white rounded-xl shadow-xl p-6 w-full max-w-sm text-center relative animate-fadeIn">

                <div id="successIcon" class="mb-4">
                    <i class="fa-solid fa-circle-check text-green-500 text-5xl animate-bounce"></i>
                    <h3 class="mt-2 text-xl font-semibold text-gray-800">Payment PIN Changed Successfully</h3>
                    <p class="text-sm text-gray-500">Your payment PIN has been updated.</p>
                </div>

                <div id="failureIcon" class="mb-4 hidden">
                    <i class="fa-solid fa-circle-xmark text-red-500 text-5xl animate-shake"></i>
                    <h3 class="mt-2 text-xl font-semibold text-gray-800">Failed to Change Payment PIN</h3>
                    <p id="failureMessage" class="text-sm text-gray-500">Something went wrong. Please try again.</p>
                </div>

                <button onclick="closePinModal()"
                    class="mt-6 w-full py-2 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition">
                    Close
                </button>
            </div>
        </div>


        <script>
            function togglePassword(inputId, icon) {
                const input = document.getElementById(inputId);
                if (input.type === "password") {
                    input.type = "text";
                    icon.classList.remove("fa-eye");
                    icon.classList.add("fa-eye-slash");
                } else {
                    input.type = "password";
                    icon.classList.remove("fa-eye-slash");
                    icon.classList.add("fa-eye");
                }
            }

            const generatingModal = document.getElementById("generatingModal");
            const pinModal = document.getElementById("pinModal");
            const successIcon = document.getElementById("successIcon");
            const failureIcon = document.getElementById("failureIcon");

            function closePinModal() {
                pinModal.classList.add("hidden");
            }
            window.closePinModal = closePinModal;

            document.getElementById("changePinForm").addEventListener("submit", async function (e) {
                e.preventDefault();

                generatingModal.classList.remove("hidden");

                const oldPin = document.getElementById('oldPin').value;
                const newPin = document.getElementById('newPin').value;
                const confirmNewPin = document.getElementById('confirmNewPin').value;

                if (newPin !== confirmNewPin) {
                    generatingModal.classList.add("hidden");
                    showToast("New PIN and Confirm New PIN do not match");
                    return;
                }

                try {
                    const response = await fetch("/user/secure/ctb/changepaymentpin", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ oldPin, newPin }),
                    });

                    const contentType = response.headers.get("content-type");

                    if (contentType && contentType.includes("application/json")) {
                        const data = await response.json();
                        if (!response.ok) {
                            generatingModal.classList.add("hidden");
                            successIcon.classList.add("hidden");
                            failureIcon.classList.remove("hidden");
                            pinModal.classList.remove("hidden");

                            const failureMessageElem = document.getElementById("failureMessage");
                            if (failureMessageElem) {
                                failureMessageElem.textContent = data.error || data.message || "Failed to change payment PIN.";
                            }

                            return;
                        }

                        generatingModal.classList.add("hidden");
                        successIcon.classList.remove("hidden");
                        failureIcon.classList.add("hidden");
                        pinModal.classList.remove("hidden");

                        setTimeout(() => {
                            window.location.href = `/udp/dashboard`;
                        }, 5000);
                    } else {
                        const text = await response.text();
                        console.error("Non-JSON response:", text);
                        generatingModal.classList.add("hidden");
                        showToast("Server error: non-JSON response");
                    }
                } catch (err) {
                    console.error("Error changing pin:", err);
                    generatingModal.classList.add("hidden");
                    showToast("Network error. Please try again later.");
                }
            });


        </script>
    </body>

</html>