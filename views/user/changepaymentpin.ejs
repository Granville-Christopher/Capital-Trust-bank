<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capital Trust Bank - Change payment pin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" sizes="32x32" href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank" />
    <link rel="icon" type="image/png" sizes="16x16" href="https://placehold.co/16x16/2563EB/DBEAFE?text=CTBank" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://placehold.co/180x180/2563EB/DBEAFE?text=CTBank" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#4f46e5" />
</head>
<%- include('partials/toastalerts')%>

<body class="bg-gradient-to-br from-slate-50 via-indigo-50/20 to-slate-50 min-h-screen pb-24">
    <div class="fixed top-0 left-0 right-0 bg-white/98 backdrop-blur-lg border-b border-gray-100 flex items-center px-5 py-4 z-30 shadow-sm">
        <button onclick="history.back()" class="w-10 h-10 rounded-full bg-white shadow-md flex items-center justify-center hover:bg-gray-50 transition border border-gray-100 mr-3">
            <i class="fa-solid fa-arrow-left text-gray-700"></i>
        </button>
        <h2 class="text-lg font-bold text-gray-800">Change Payment PIN</h2>
    </div>

    <div class="pt-20 px-5 flex flex-col justify-center items-center min-h-[calc(100vh-80px)]">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 max-w-sm w-full text-center">
            <div class="changepaymentpinsection">
                <div class="w-16 h-16 rounded-full bg-indigo-100 flex items-center justify-center mx-auto mb-4">
                    <i class="fa-solid fa-shield-halved text-indigo-600 text-2xl"></i>
                </div>
                <h2 class="text-xl font-bold text-gray-800 mb-6">Change Payment PIN</h2>

                <form id="changePinForm" class="space-y-4">
                    <div class="relative">
                        <input type="password" id="oldPin" placeholder="Old PIN" maxlength="4"
                            class="w-full py-3 px-4 rounded-xl border-2 border-gray-200 text-center text-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" />
                        <i class="fa fa-eye absolute right-4 top-3.5 cursor-pointer text-gray-500 hover:text-indigo-600"
                            onclick="togglePassword('oldPin', this)"></i>
                    </div>
                    <div class="relative">
                        <input type="password" id="newPin" placeholder="New PIN" maxlength="4"
                            class="w-full py-3 px-4 rounded-xl border-2 border-gray-200 text-center text-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" />
                        <i class="fa fa-eye absolute right-4 top-3.5 cursor-pointer text-gray-500 hover:text-indigo-600"
                            onclick="togglePassword('newPin', this)"></i>
                    </div>
                    <div class="relative">
                        <input type="password" id="confirmNewPin" placeholder="Confirm New PIN" maxlength="4"
                            class="w-full py-3 px-4 rounded-xl border-2 border-gray-200 text-center text-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" />
                        <i class="fa fa-eye absolute right-4 top-3.5 cursor-pointer text-gray-500 hover:text-indigo-600"
                            onclick="togglePassword('confirmNewPin', this)"></i>
                    </div>

                    <button type="submit"
                        class="w-full py-3 bg-gradient-to-r from-indigo-600 to-indigo-700 text-white rounded-xl font-semibold hover:from-indigo-700 hover:to-indigo-800 transition shadow-lg">
                        Change PIN
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div id="generatingModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center hidden z-50 p-4">
        <div class="bg-white rounded-2xl shadow-2xl p-8 w-full max-w-sm text-center">
            <i class="fa-solid fa-spinner fa-spin text-indigo-600 text-5xl mb-4"></i>
            <h3 class="text-lg font-bold text-gray-800">Changing Payment PIN...</h3>
            <p class="text-sm text-gray-500 mt-2">Please wait while we update your payment PIN.</p>
        </div>
    </div>

    <div id="pinModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50 hidden p-4">
        <div class="bg-white rounded-2xl shadow-2xl p-8 w-full max-w-sm text-center relative">
            <div id="successIcon" class="mb-4">
                <div class="w-16 h-16 rounded-full bg-emerald-100 flex items-center justify-center mx-auto mb-4">
                    <i class="fa-solid fa-circle-check text-emerald-600 text-3xl"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-800">Payment PIN Changed Successfully</h3>
                <p class="text-sm text-gray-500 mt-2">Your payment PIN has been updated.</p>
            </div>

            <div id="failureIcon" class="mb-4 hidden">
                <div class="w-16 h-16 rounded-full bg-red-100 flex items-center justify-center mx-auto mb-4">
                    <i class="fa-solid fa-circle-xmark text-red-600 text-3xl"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-800">Failed to Change Payment PIN</h3>
                <p id="failureMessage" class="text-sm text-gray-500 mt-2">Something went wrong. Please try again.</p>
            </div>

            <button onclick="closePinModal()"
                class="mt-6 w-full py-3 bg-indigo-600 text-white rounded-xl hover:bg-indigo-700 transition font-semibold shadow-lg">
                Close
            </button>
        </div>
    </div>

    <div class="fixed bottom-0 left-0 right-0 bg-white/98 backdrop-blur-lg border-t border-gray-100 z-50">
        <div class="flex justify-around items-center px-6 py-3">
            <a href="/udp/dashboard" class="flex flex-col items-center gap-1 text-gray-600">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center">
                    <i class="fa-solid fa-house text-lg"></i>
                </div>
                <span class="text-xs font-medium">Home</span>
            </a>
            <a href="/udp/finance" class="flex flex-col items-center gap-1 text-gray-600">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center">
                    <i class="fa-solid fa-chart-line text-lg"></i>
                </div>
                <span class="text-xs font-medium">Finance</span>
            </a>
            <a href="/udp/cards" class="flex flex-col items-center gap-1 text-gray-600">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center">
                    <i class="fa-solid fa-credit-card text-lg"></i>
                </div>
                <span class="text-xs font-medium">Cards</span>
            </a>
            <a href="/udp/profile" class="flex flex-col items-center gap-1 text-gray-600">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center">
                    <i class="fa-solid fa-user text-lg"></i>
                </div>
                <span class="text-xs font-medium">Profile</span>
            </a>
        </div>
    </div>

    <script>
        function togglePassword(inputId, icon) {
            const input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }

        const generatingModal = document.getElementById("generatingModal");
        const pinModal = document.getElementById("pinModal");
        const successIcon = document.getElementById("successIcon");
        const failureIcon = document.getElementById("failureIcon");

        function closePinModal() {
            pinModal.classList.add("hidden");
        }
        window.closePinModal = closePinModal;

        document.getElementById("changePinForm").addEventListener("submit", async function (e) {
            e.preventDefault();

            generatingModal.classList.remove("hidden");

            const oldPin = document.getElementById('oldPin').value;
            const newPin = document.getElementById('newPin').value;
            const confirmNewPin = document.getElementById('confirmNewPin').value;

            if (newPin !== confirmNewPin) {
                generatingModal.classList.add("hidden");
                showToast("New PIN and Confirm New PIN do not match");
                return;
            }

            try {
                const response = await fetch("/user/secure/ctb/changepaymentpin", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ oldPin, newPin }),
                });

                const contentType = response.headers.get("content-type");

                if (contentType && contentType.includes("application/json")) {
                    const data = await response.json();
                    if (!response.ok) {
                        generatingModal.classList.add("hidden");
                        successIcon.classList.add("hidden");
                        failureIcon.classList.remove("hidden");
                        pinModal.classList.remove("hidden");

                        const failureMessageElem = document.getElementById("failureMessage");
                        if (failureMessageElem) {
                            failureMessageElem.textContent = data.error || data.message || "Failed to change payment PIN.";
                        }

                        return;
                    }

                    generatingModal.classList.add("hidden");
                    successIcon.classList.remove("hidden");
                    failureIcon.classList.add("hidden");
                    pinModal.classList.remove("hidden");

                    setTimeout(() => {
                        window.location.href = `/udp/dashboard`;
                    }, 5000);
                } else {
                    const text = await response.text();
                    console.error("Non-JSON response:", text);
                    generatingModal.classList.add("hidden");
                    showToast("Server error: non-JSON response");
                }
            } catch (err) {
                console.error("Error changing pin:", err);
                generatingModal.classList.add("hidden");
                showToast("Network error. Please try again later.");
            }
        });
    </script>
</body>

</html>
