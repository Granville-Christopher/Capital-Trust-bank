<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manage Debit Card PIN</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
</head>

<body class="bg-gradient-to-b from-blue-100 to-gray-100 min-h-screen p-6 flex flex-col justify-center items-center">
    <div class="bg-white rounded-xl shadow p-6 max-w-sm w-full text-center">
        <h2 class="text-xl font-semibold text-gray-800 mb-6">Manage Debit Card PIN</h2>

        <button id="resetPinBtn"
            class="w-full py-3 bg-blue-600 text-white rounded-full font-medium hover:bg-blue-700 transition mb-6">
            Reset Card PIN
        </button>

        <div id="resetPinSection" class="hidden space-y-4">
            <form id="resetPinForm">
                <p class="text-sm text-gray-600 mb-2">Enter your login PIN</p>
                <div class="flex justify-center gap-2 mb-4">
                    <input type="password" maxlength="1" class="pin-box" id="loginPin1" />
                    <input type="password" maxlength="1" class="pin-box" id="loginPin2" />
                    <input type="password" maxlength="1" class="pin-box" id="loginPin3" />
                    <input type="password" maxlength="1" class="pin-box" id="loginPin4" />
                    <input type="password" maxlength="1" class="pin-box" id="loginPin5" />
                    <input type="password" maxlength="1" class="pin-box" id="loginPin6" />
                </div>

                <p class="text-sm text-gray-600 mb-2">Enter your new card PIN</p>
                <div class="flex justify-center gap-2 mb-4">
                    <input type="password" maxlength="1" class="pin-box" id="newCardPin1" />
                    <input type="password" maxlength="1" class="pin-box" id="newCardPin2" />
                    <input type="password" maxlength="1" class="pin-box" id="newCardPin3" />
                    <input type="password" maxlength="1" class="pin-box" id="newCardPin4" />
                </div>

                <p class="text-sm text-gray-600 mb-6">Confirm your new card PIN</p>
                <div class="flex justify-center gap-2 mb-6">
                    <input type="password" maxlength="1" class="pin-box" id="confirmCardPin1" />
                    <input type="password" maxlength="1" class="pin-box" id="confirmCardPin2" />
                    <input type="password" maxlength="1" class="pin-box" id="confirmCardPin3" />
                    <input type="password" maxlength="1" class="pin-box" id="confirmCardPin4" />
                </div>

                <button type="submit"
                    class="w-full py-3 bg-blue-600 text-white rounded-full font-medium hover:bg-blue-700 transition">
                    Submit
                </button>
            </form>
        </div>
    </div>

    <script>
        function setupInputs(selector) {
            const inputs = document.querySelectorAll(selector);
            inputs.forEach((input, index) => {
                input.addEventListener("input", () => {
                    if (input.value && index < inputs.length - 1) {
                        inputs[index + 1].focus();
                    }
                });
                input.addEventListener("keydown", (e) => {
                    if (e.key === "Backspace" && !input.value && index > 0) {
                        inputs[index - 1].focus();
                    }
                });
            });
        }

        document.addEventListener("DOMContentLoaded", () => {
            setupInputs(".pin-box");

            const resetPinBtn = document.getElementById("resetPinBtn");
            const resetPinSection = document.getElementById("resetPinSection");

            resetPinBtn.addEventListener("click", () => {
                resetPinSection.classList.toggle("hidden");
            });

            document.getElementById("resetPinForm").addEventListener("submit", function (e) {
                e.preventDefault();
                // Add form validation and submission logic here
                alert("Debit Card PIN reset submitted.");
            });
        });
    </script>

    <!-- Generating Modal -->
    <div id="generatingModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
        <div class="bg-white rounded-xl shadow-xl p-6 w-full max-w-sm text-center">
            <i class="fa-solid fa-spinner fa-spin text-blue-600 text-4xl mb-4"></i>
            <h3 class="text-lg font-semibold">Resetting Card PIN...</h3>
            <p class="text-sm text-gray-500">Please wait while we reset your card PIN.</p>
        </div>
    </div>

    <!-- Success/Failure Modal -->
    <div id="pinModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden">
        <div class="bg-white rounded-xl shadow-xl p-6 w-full max-w-sm text-center relative animate-fadeIn">

            <!-- Success Icon -->
            <div id="successIcon" class="mb-4">
                <i class="fa-solid fa-circle-check text-green-500 text-5xl animate-bounce"></i>
                <h3 class="mt-2 text-xl font-semibold text-gray-800">Card PIN Reset Successfully</h3>
                <p class="text-sm text-gray-500">Your card PIN has been reset.</p>
            </div>

            <!-- Failure Icon (hidden by default) -->
            <div id="failureIcon" class="mb-4 hidden">
                <i class="fa-solid fa-circle-xmark text-red-500 text-5xl animate-shake"></i>
                <h3 class="mt-2 text-xl font-semibold text-gray-800">Failed to Reset Card PIN</h3>
                <p class="text-sm text-gray-500">Something went wrong. Please try again.</p>
            </div>

            <!-- Close Button -->
            <button onclick="closePinModal()"
                class="mt-6 w-full py-2 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition">
                Close
            </button>
        </div>
    </div>

    <script>
        function setupInputs(selector) {
            const inputs = document.querySelectorAll(selector);
            inputs.forEach((input, index) => {
                input.addEventListener("input", () => {
                    if (input.value && index < inputs.length - 1) {
                        inputs[index + 1].focus();
                    }
                });
                input.addEventListener("keydown", (e) => {
                    if (e.key === "Backspace" && !input.value && index > 0) {
                        inputs[index - 1].focus();
                    }
                });
            });
        }

        document.addEventListener("DOMContentLoaded", () => {
            setupInputs(".pin-box");

            const resetPinBtn = document.getElementById("resetPinBtn");
            const resetPinSection = document.getElementById("resetPinSection");

            resetPinBtn.addEventListener("click", () => {
                resetPinSection.classList.toggle("hidden");
            });

            const generatingModal = document.getElementById("generatingModal");
            const pinModal = document.getElementById("pinModal");
            const successIcon = document.getElementById("successIcon");
            const failureIcon = document.getElementById("failureIcon");

            function closePinModal() {
                pinModal.classList.add("hidden");
            }
            window.closePinModal = closePinModal;

            document.getElementById("resetPinForm").addEventListener("submit", function (e) {
                e.preventDefault();
                generatingModal.classList.remove("hidden");
                // Simulate async operation
                setTimeout(() => {
                    generatingModal.classList.add("hidden");
                    successIcon.classList.remove("hidden");
                    failureIcon.classList.add("hidden");
                    pinModal.classList.remove("hidden");
                }, 2000);
            });
        });
    </script>
</body>

</html>
