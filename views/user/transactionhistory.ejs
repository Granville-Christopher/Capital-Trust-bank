<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capital Trust Bank - Transaction History</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>

<body class="bg-gradient-to-b from-blue-100 to-gray-100 min-h-screen p-6 space-y-6 relative overflow-y-hidden">

    <!-- Header Section -->
    <div class="flex justify-between items-center mb-4">
        <h2 class="text-xl font-semibold text-gray-800">
            <i class="fa-solid fa-file-invoice-dollar text-blue-600 mr-2"></i>
            Transaction History
        </h2>
    </div>
    <div class="grid grid-cols-2 gap-4 flex justify-between items-center">
        <a href="dashboard" class="text-blue-500 text-sm no-underline hover:text-blue-700">
            ← Back to Dashboard
        </a>
        <!-- Download Statement Trigger -->
        <a href="#" onclick="openModal()" class="text-blue-500 text-sm no-underline hover:text-blue-700">
            <i class="fa-solid fa-file-arrow-down"></i> Download Statement
        </a>

        <!-- Modal Background -->
        <div id="statementModal"
            class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
            <!-- Modal Content -->
            <div class="bg-white rounded-xl shadow-lg p-6 w-full max-w-md relative">
                <h3 class="text-lg font-semibold text-gray-800 mb-4">Download Statement</h3>

                <form>
                    <div class="mb-4">
                        <label class="block text-sm text-gray-700 mb-1" for="fromDate">From Date</label>
                        <input type="date" id="fromDate"
                            class="w-full px-4 py-2 border border-blue-500 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-400" />
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm text-gray-700 mb-1" for="toDate">To Date</label>
                        <input type="date" id="toDate"
                            class="w-full px-4 py-2 border border-blue-500 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-400" />
                    </div>
                    <button type="submit"
                        class="w-full py-2 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition">
                        Submit Request
                    </button>
                </form>

                <!-- Close Button -->
                <button onclick="closeModal()" class="absolute top-3 right-4 text-gray-500 hover:text-gray-700">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
        </div>
    </div>
    <!-- Table Section -->
    <div class="overflow-x-auto rounded-xl pt-0 px-6 pb-6 overflow-y-auto h-[650px]">
        <table class="min-w-full text-sm">
            <thead class="bg-blue-100 text-gray-700 sticky top-0 z-10">
                <tr>
                    <th class="py-2 px-4 whitespace-nowrap text-left">Date</th>
                    <th class="py-2 px-4 whitespace-nowrap text-left">Description</th>
                    <th class="py-2 px-4 whitespace-nowrap text-left">Type</th>
                    <th class="py-2 px-4 whitespace-nowrap text-left">Amount</th>
                    <th class="py-2 px-4 whitespace-nowrap text-left">Status</th>
                </tr>
            </thead>
            <tbody class="text-gray-800">
                <tr class="border-b">
                    <td class="py-2 px-4 whitespace-nowrap">Jul 21, 2025</td>
                    <td class="py-2 px-4 whitespace-nowrap">Transfer to John Doe</td>
                    <td class="py-2 px-4 whitespace-nowrap">Debit</td>
                    <td class="py-2 px-4 whitespace-nowrap text-red-600">-₦5,000.00</td>
                    <td class="py-2 px-4 whitespace-nowrap text-green-600">Completed</td>
                </tr>
                <tr class="border-b">
                    <td class="py-2 px-4 whitespace-nowrap">Jul 20, 2025</td>
                    <td class="py-2 px-4 whitespace-nowrap">ATM Withdrawal</td>
                    <td class="py-2 px-4 whitespace-nowrap">Debit</td>
                    <td class="py-2 px-4 whitespace-nowrap text-red-600">-₦20,000.00</td>
                    <td class="py-2 px-4 whitespace-nowrap text-green-600">Completed</td>
                </tr>
                <tr class="border-b">
                    <td class="py-2 px-4 whitespace-nowrap">Jul 19, 2025</td>
                    <td class="py-2 px-4 whitespace-nowrap">Loan Credit</td>
                    <td class="py-2 px-4 whitespace-nowrap">Credit</td>
                    <td class="py-2 px-4 whitespace-nowrap text-blue-600">+₦150,000.00</td>
                    <td class="py-2 px-4 whitespace-nowrap text-green-600">Completed</td>
                </tr>
                <tr class="border-b">
                    <td class="py-2 px-4 whitespace-nowrap">Jul 18, 2025</td>
                    <td class="py-2 px-4 whitespace-nowrap">Mobile Recharge</td>
                    <td class="py-2 px-4 whitespace-nowrap">Debit</td>
                    <td class="py-2 px-4 whitespace-nowrap text-red-600">-₦500.00</td>
                    <td class="py-2 px-4 whitespace-nowrap text-green-600">Completed</td>
                </tr>
                <tr>
                    <td class="py-2 px-4 whitespace-nowrap">Jul 17, 2025</td>
                    <td class="py-2 px-4 whitespace-nowrap">POS Payment</td>
                    <td class="py-2 px-4 whitespace-nowrap">Debit</td>
                    <td class="py-2 px-4 whitespace-nowrap text-red-600">-₦3,200.00</td>
                    <td class="py-2 px-4 whitespace-nowrap text-green-600">Completed</td>
                </tr>
            </tbody>
        </table>
    </div>
    <!-- Fixed Bottom Navigation -->
    <div class="fixed bottom-0 left-0 right-0 bg-gray-100 border-t-2 shadow-md z-50">
        <div class="flex justify-between items-center px-8 py-3 text-xs text-gray-700">

            <!-- Home -->
            <a href="dashboard" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
                <i class="fa-solid fa-house text-lg"></i>
                <span class="mt-1">Home</span>
            </a>

            <!-- Finance -->
            <a href="finance" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
                <i class="fa-solid fa-chart-line text-lg"></i>
                <span class="mt-1">Finance</span>
            </a>

            <!-- Cards -->
            <a href="cards" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
                <i class="fa-solid fa-credit-card text-lg"></i>
                <span class="mt-1">Cards</span>
            </a>

            <!-- Me -->
            <a href="profile" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
                <i class="fa-solid fa-user text-lg"></i>
                <span class="mt-1">Me</span>
            </a>

        </div>
    </div>
    <script src="js/frontendfiles//downloadstatementmodal.js"></script>
</body>

</html>