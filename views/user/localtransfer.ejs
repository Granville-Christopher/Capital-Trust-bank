<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capital Trust Bank - Local Transfer</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>

<body class="bg-gradient-to-b from-blue-100 to-gray-100 min-h-screen p-6 relative overflow-y-hidden">
    <div class=" flex justify-start">
        <a href="dashboard" class="text-blue-600 no-underline  hover:text-blue-800 text-sm">← Back to Dashboard</a>
    </div>
    <!-- Page Header -->
    <div class="mb-6 mt-8 flex items-center justify-center">
        <h2 class="text-xl font-semibold text-gray-800">
            <i class="fa-solid fa-location-dot text-blue-600 mr-2"></i>
            Local Transfer
        </h2>
    </div>

    <!-- Transfer Form Card -->
    <div class="bg-white rounded-xl shadow p-6 max-w-xl mx-auto">
        <form>
            <!-- Recipient Name -->
            <div class="mb-4">
                <label class="block text-sm mb-1 text-gray-700">Recipient Full Name</label>
                <input type="text" placeholder="Jane Doe"
                    class="w-full px-4 py-2 border border-blue-500 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-400" />
            </div>

            <!-- Account Number -->
            <div class="mb-4">
                <label class="block text-sm mb-1 text-gray-700">Account Number</label>
                <input type="text" placeholder="0012345678"
                    class="w-full px-4 py-2 border border-blue-500 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-400" />
            </div>

            <!-- Recipient Bank -->
            <div class="mb-4">
                <label class="block text-sm mb-1 text-gray-700">Recipient Bank</label>
                <input type="text" placeholder="Capital Trust Bank"
                    class="w-full px-4 py-2 border border-blue-500 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-400" />
            </div>

            <!-- Recipient Address -->
            <div class="mb-4">
                <label class="block text-sm mb-1 text-gray-700">Recipient Address</label>
                <input type="text" placeholder="No. 10 Broad Street, Lagos"
                    class="w-full px-4 py-2 border border-blue-500 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-400" />
            </div>

            <!-- Amount -->
            <div class="mb-6">
                <label class="block text-sm mb-1 text-gray-700">Amount (₦)</label>
                <input type="number" placeholder="50000"
                    class="w-full px-4 py-2 border border-blue-500 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-400" />
            </div>

            <!-- Transfer Button -->
            <button type="submit"
                class="w-full py-3 bg-blue-600 text-white rounded-full font-medium hover:bg-blue-700 transition">
                <i class="fa-solid fa-paper-plane mr-2"></i> Initiate Transfer
            </button>
        </form>
    </div>

</body>

</html>