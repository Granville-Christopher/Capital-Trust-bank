<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capital Trust Bank - Local Transfer</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<%- include('partials/toastalerts') %>
<body class="bg-gradient-to-b from-blue-100 to-gray-100 min-h-screen p-6 relative overflow-y-hidden">
    <div class=" flex justify-start">
        <a href="dashboard" class="text-blue-600 no-underline  hover:text-blue-800 text-sm">← Back to Dashboard</a>
    </div>
    <!-- Page Header -->
    <div class="mb-6 mt-8 flex items-center justify-center">
        <h2 class="text-xl font-semibold text-gray-800">
            <i class="fa-solid fa-location-dot text-blue-600 mr-2"></i>
            Local Transfer
        </h2>
    </div>

    <!-- Transfer Form Card -->
    <div class="bg-white rounded-xl shadow p-6 max-w-xl mx-auto">
        <form id="localTf">
            <div class="mb-4">
                <label class="block text-sm mb-1 text-gray-700">Account Number</label>
                <input type="text" id="Account_number" placeholder="0012345678"
                    class="w-full px-4 py-2 border border-blue-500 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-400" />
            </div>

            <div class="mb-4">
                <label class="block text-sm mb-1 text-gray-700">Recipient Full Name</label>
                <input type="text"  id="fName" placeholder="Jane Doe"
                    class="w-full px-4 py-2 border border-blue-500 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-400" />
            </div>

            <div class="mb-4">
                <label class="block text-sm mb-1 text-gray-700">Recipient Bank</label>
                <input type="text" id="Bank" value="Capital Trust Bank" disabled
                    class="w-full px-4 py-2 border border-blue-500 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-400" />
            </div>

            <div class="mb-6">
                <label class="block text-sm mb-1 text-gray-700">Amount ($)</label>
                <input type="number" id="Amount" placeholder="50000"
                    class="w-full px-4 py-2 border border-blue-500 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-400" />
            </div>

            <button type="submit" id="localtransfer-btn"
                class="w-full py-2 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition duration-200 flex items-center justify-center">
                <span id="localtransfer-text">Initiate transfer</span>
                <svg id="spinner" class="animate-spin h-5 w-5 ml-2 hidden text-white" xmlns="http://www.w3.org/2000/svg"
                    fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4">
                    </circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                </svg>
            </button>
        </form>
    </div>
    <script src="/js/auth/localtransfer.js"></script>

</body>

</html>