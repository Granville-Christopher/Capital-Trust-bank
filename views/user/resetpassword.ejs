<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capital Trust Bank - Password reset</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" sizes="32x32" href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank" />
    <link rel="icon" type="image/png" sizes="16x16" href="https://placehold.co/16x16/2563EB/DBEAFE?text=CTBank" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://placehold.co/180x180/2563EB/DBEAFE?text=CTBank" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#4f46e5" />
</head>

<body class="bg-gradient-to-br from-slate-50 via-indigo-50/20 to-slate-50 min-h-screen flex flex-col relative">
    <div class="bg-gradient-to-r from-indigo-600 to-indigo-700 text-white py-6 px-4 flex h-60 flex-col items-center shadow-lg">
        <div class="text-2xl font-bold flex items-center space-x-2">
            <i class="fa-solid fa-building-columns text-white"></i>
            <span>Capital Trust Bank</span>
        </div>
        <p class="mt-2 text-sm text-indigo-100">Need to reset your password? We'll guide you step by step.</p>
        <a href="index" class="mt-2 text-xs underline hover:text-white transition">← Back to Home</a>
    </div>

    <div class="flex-grow flex flex-col items-center justify-center px-4 gap-8 mt-[-6rem]">
        <form class="bg-white shadow-xl rounded-2xl p-8 w-full max-w-md border border-gray-100">
            <div class="text-center mb-6">
                <div class="w-16 h-16 rounded-full bg-indigo-100 flex items-center justify-center mx-auto mb-4">
                    <i class="fa-solid fa-key text-indigo-600 text-2xl"></i>
                </div>
                <h2 class="text-2xl font-bold text-indigo-700">Request Password Reset</h2>
            </div>
            <div class="mb-5">
                <label class="block text-sm font-semibold text-gray-700 mb-2" for="email">Email Address</label>
                <input type="email" id="email" placeholder="Enter your email"
                    class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" />
            </div>
            <button type="submit"
                class="w-full py-3 bg-gradient-to-r from-indigo-600 to-indigo-700 text-white rounded-xl hover:from-indigo-700 hover:to-indigo-800 transition font-semibold shadow-lg">
                Get OTP
            </button>
        </form>

        <form class="bg-white shadow-xl rounded-2xl p-8 w-full max-w-md border border-gray-100">
            <div class="text-center mb-6">
                <div class="w-16 h-16 rounded-full bg-indigo-100 flex items-center justify-center mx-auto mb-4">
                    <i class="fa-solid fa-lock text-indigo-600 text-2xl"></i>
                </div>
                <h2 class="text-2xl font-bold text-indigo-700">Reset Your Password</h2>
            </div>

            <div class="mb-4">
                <label class="block text-sm font-semibold text-gray-700 mb-2" for="reset-email">Email Address</label>
                <input type="email" id="reset-email" placeholder="Enter your email"
                    class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" />
            </div>

            <div class="mb-4">
                <label class="block text-sm font-semibold text-gray-700 mb-2" for="otp">OTP</label>
                <input type="text" id="otp" placeholder="Enter the OTP"
                    class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" />
            </div>

            <div class="mb-4 relative">
                <label class="block text-sm font-semibold text-gray-700 mb-2" for="new-password">New Password</label>
                <input type="password" id="new-password"
                    class="w-full px-4 py-3 pr-12 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition"
                    placeholder="Enter new password" />
                <span class="absolute right-3 top-[42px] cursor-pointer text-indigo-600 hover:text-indigo-700"
                    onclick="togglePassword('new-password', 'icon-new')">
                    <i id="icon-new" class="fa-solid fa-eye"></i>
                </span>
            </div>

            <div class="mb-5 relative">
                <label class="block text-sm font-semibold text-gray-700 mb-2" for="confirm-password">Confirm New Password</label>
                <input type="password" id="confirm-password"
                    class="w-full px-4 py-3 pr-12 border-2 border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition"
                    placeholder="Confirm new password" />
                <span class="absolute right-3 top-[42px] cursor-pointer text-indigo-600 hover:text-indigo-700"
                    onclick="togglePassword('confirm-password', 'icon-confirm')">
                    <i id="icon-confirm" class="fa-solid fa-eye"></i>
                </span>
            </div>

            <button type="submit"
                class="w-full py-3 bg-gradient-to-r from-indigo-600 to-indigo-700 text-white rounded-xl hover:from-indigo-700 hover:to-indigo-800 transition font-semibold shadow-lg">
                Reset Password
            </button>

            <p class="mt-4 text-sm text-center text-gray-600">
                Already have an account with Capital Trust? <a href="login" class="text-indigo-600 hover:text-indigo-700 font-semibold underline">Please log in here</a>
            </p>
        </form>
    </div>
    <script src="/js/frontendfiles/showpassreset.js"></script>
</body>

</html>
