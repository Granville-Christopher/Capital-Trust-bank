    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@CTBankOfficial" />
    <meta name="twitter:creator" content="@CTBankOfficial" />
    <meta name="twitter:title" content="Capital Trust Bank - Secure & Modern Banking" />
    <meta name="twitter:description"
        content="Manage your finances with ease. Secure, fast, and reliable banking services for all your needs." />
        <meta name="twitter:image" content="https://capital-trust-bank-production.up.railway.app/images/hpg.jpg" />


</head>

<body class="bg-gradient-to-b from-blue-100 to-gray-100 min-h-screen flex flex-col relative">

    <div class="bg-blue-600 text-white py-6 px-4 flex h-60 flex-col items-center">
        <div class="text-2xl font-semibold flex items-center space-x-2">
            <i class="fa-solid fa-building-columns text-white"></i>
            <span>Capital Trust Bank</span>
        </div>
        <p class="mt-2 text-sm">Need to reset your password? We’ll guide you step by step.</p>
        <a href="index" class="mt-2 text-xs underline hover:text-gray-200">← Back to Home</a>
    </div>

    <div class="flex-grow flex flex-col items-center justify-center px-4 gap-12 mt-[-6rem]">

        <form class="bg-white shadow-md rounded-xl p-8 w-full max-w-md">
            <h2 class="text-xl font-bold text-blue-600 mb-6 text-center">Request Password Reset</h2>
            <div class="mb-4">
                <label class="block text-sm text-gray-700 mb-1" for="email">Email Address</label>
                <input type="email" id="email" placeholder="Enter your email"
                    class="w-full px-4 py-2 border border-blue-500 rounded-full outline-none focus:ring-2 focus:ring-blue-400">
            </div>
            <button type="submit"
                class="w-full py-2 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition duration-200">
                Get OTP
            </button>
        </form>

        <form class=" rounded-xl p-8 w-full max-w-md">
            <h2 class="text-xl font-bold text-blue-600 mb-6 text-center">Reset Your Password</h2>

            <div class="mb-4">
                <label class="block text-sm text-gray-700 mb-1" for="reset-email">Email Address</label>
                <input type="email" id="reset-email" placeholder="Enter your email"
                    class="w-full px-4 py-2 border border-blue-500 rounded-full outline-none focus:ring-2 focus:ring-blue-400">
            </div>

            <div class="mb-4">
                <label class="block text-sm text-gray-700 mb-1" for="otp">OTP</label>
                <input type="text" id="otp" placeholder="Enter the OTP"
                    class="w-full px-4 py-2 border border-blue-500 rounded-full outline-none focus:ring-2 focus:ring-blue-400">
            </div>

            <div class="mb-4 relative">
                <label class="block text-sm mb-1" for="new-password">New Password</label>
                <input type="password" id="new-password"
                    class="w-full px-4 py-2 pr-10 border border-blue-500 rounded-full outline-none focus:ring-2 focus:ring-blue-400"
                    placeholder="Enter new password" />
                <span class="absolute right-3 top-[38px] cursor-pointer text-blue-500"
                    onclick="togglePassword('new-password', 'icon-new')">
                    <i id="icon-new" class="fa-solid fa-eye"></i>
                </span>
            </div>

            <div class="mb-4 relative">
                <label class="block text-sm mb-1" for="confirm-password">Confirm New Password</label>
                <input type="password" id="confirm-password"
                    class="w-full px-4 py-2 pr-10 border border-blue-500 rounded-full outline-none focus:ring-2 focus:ring-blue-400"
                    placeholder="Confirm new password" />
                <span class="absolute right-3 top-[38px] cursor-pointer text-blue-500"
                    onclick="togglePassword('confirm-password', 'icon-confirm')">
                    <i id="icon-confirm" class="fa-solid fa-eye"></i>
                </span>
            </div>

            <button type="submit"
                class="w-full py-2 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition duration-200">
                Reset Password
            </button>

            <p class="mt-4 text-sm text-center">
                Already have an account with Capital Trust? <a href="login" class="text-blue-500 hover:underline">Please
                    log in here</a>
            </p>
        </form>

    </div>
    <script src="/js/frontendfiles/showpassreset.js"></script>
</body>

</html>