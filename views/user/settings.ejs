<!DOCTYPE html>
<html lang="en">


<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capital Trust Bank - Settings</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <link rel="icon" type="image/png" sizes="32x32" href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank" />
    <link rel="icon" type="image/png" sizes="16x16" href="https://placehold.co/16x16/2563EB/DBEAFE?text=CTBank" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://placehold.co/180x180/2563EB/DBEAFE?text=CTBank" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#2563EB" />

    <meta property="og:title" content="Capital Trust Bank - Secure & Modern Banking" />
    <meta property="og:description"
        content="Manage your finances with ease. Secure, fast, and reliable banking services for all your needs." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://capital-trust-bank-production.up.railway.app/" />
    <meta property="og:image" content="https://capital-trust-bank-production.up.railway.app/images/hpg.jpg" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:site_name" content="Capital Trust Bank" />
    <meta property="og:locale" content="en_NG" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@CTBankOfficial" />
    <meta name="twitter:creator" content="@CTBankOfficial" />
    <meta name="twitter:title" content="Capital Trust Bank - Secure & Modern Banking" />
    <meta name="twitter:description"
        content="Manage your finances with ease. Secure, fast, and reliable banking services for all your needs." />
    <meta name="twitter:image" content="https://capital-trust-bank-production.up.railway.app/images/hpg.jpg" />


</head>

<body class="bg-gradient-to-b from-blue-100 to-gray-100 min-h-screen p-6 text-gray-800 space-y-6 relative">

    <div class="flex items-center fixed bg-blue-100 p-4 top-0 left-0 right-0 w-full">
        <button onclick="history.back()" class="text-blue-700 hover:text-blue-900 text-lg">
            <i class="fa-solid fa-arrow-left"></i>
        </button>
        <h2 class="ml-3 text-xl font-semibold">Settings</h2>
    </div>

    <div class="space-y-4 mt-32">
        <div class="max-w-md mx-auto bg-blue-50 shadow-md rounded-lg p-4 ">

            <h2 class="text-xl font-bold text-gray-800 mb-2"><%- user.Name %></h2>

            <p class="text-gray-600">
                KYC Status:
                <span class="font-semibold <%= kyc?.verified ? 'text-green-600' : 'text-red-600' %>">
                    <%= kyc?.verified ? "Verified" : "Not Verified" %>
                </span>
            </p>

            <button onclick="toggleKycDetails()"
                class="mt-4 px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 focus:outline-none">
                Profile Details
            </button>

            <div id="kycDetails" class="hidden mt-4 bg-white rounded p-3 space-y-3 border-t pt-4">
                <p><strong>Email:</strong> <%- user.Email %></p>
                <p>
                    <strong>Date of Birth:</strong>
                    <%- ( kyc?.dateOfBirth ? new Date(kyc.dateOfBirth).toLocaleDateString('en-US', { year: 'numeric' ,
                        month: 'long' , day: 'numeric' , timeZone: 'UTC' }) : "N/A" ) %>
                </p>
                <p><strong>Nationality:</strong> <%- kyc?.nationality || "N/A" %></p>

                <p><strong>Address:</strong> <%- kyc?.residentialAddress || "N/A" %></p>
                <p><strong>Phone:</strong> <%- kyc?.phoneNumber || "N/A" %></p>

                <p><strong>Account Category:</strong> <%- kyc?.accountCategory || "N/A" %></p>
                <p><strong>Account Type:</strong> <%- kyc?.accountType || "N/A" %></p>
            </div>
        </div>

        <script>
            function toggleKycDetails() {
                document.getElementById("kycDetails").classList.toggle("hidden");
            }
        </script>

        <h3 class="text-sm font-semibold text-gray-700 mb-2">Security Management</h3>

        <a href="/secure/ctb/changeaccountpassword"
            class="block text-sm hover:bg-blue-50 px-4 py-2 rounded transition">Change Account Password</a>
        <a href="/secure/ctb/resetpassword" class="block text-sm hover:bg-blue-50 px-4 py-2 rounded transition">Forgot
            Account Password</a>
        <a href="/secure/ctb/setpaymentpin" class="block text-sm hover:bg-blue-50 px-4 py-2 rounded transition">Set
            Payment PIN</a>
        <a href="/secure/ctb/changepaymentpin"
            class="block text-sm hover:bg-blue-50 px-4 py-2 rounded transition">Change Payment PIN</a>
        <a href="/secure/ctb/forgotpaymentpin"
            class="block text-sm hover:bg-blue-50 px-4 py-2 rounded transition">Forgot Payment PIN</a>
        <a href="/secure/ctb/setcreditcardpin" class="block text-sm hover:bg-blue-50 px-4 py-2 rounded transition">Set
            Credit Card PIN</a>
        <a href="/secure/ctb/managecreditcardpin"
            class="block text-sm hover:bg-blue-50 px-4 py-2 rounded transition">Manage Credit Card PIN</a>
        <a href="/secure/ctb/setdebitcardpin" class="block text-sm hover:bg-blue-50 px-4 py-2 rounded transition">Set
            Debit Card PIN</a>
        <a href="/secure/ctb/managedebitcardpin"
            class="block text-sm hover:bg-blue-50 px-4 py-2 rounded transition">Manage Debit Card PIN</a>
    </div>

    <div class="bg-white rounded-xl shadow p-6">
        <h3 class="text-sm font-semibold text-gray-700 mb-2">Account Options</h3>
        <a href="#" class="block text-sm text-red-600 hover:bg-red-50 px-4 py-2 rounded transition">Close Account</a>
    </div>

    <div class="mt-8">
        <button onclick="logout()"
            class="w-full py-3 bg-red-600 text-white rounded-full font-medium hover:bg-red-700 transition">
            <i class="fa-solid fa-arrow-right-from-bracket mr-2"></i> Log Out
        </button>
    </div>
    <div class="fixed bottom-0 left-0 right-0 bg-gray-100 border-t-2 shadow-md z-50">
        <div class="flex justify-between items-center px-8 py-3 text-xs text-gray-700">

            <a href="dashboard" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
                <i class="fa-solid fa-house text-lg"></i>
                <span class="mt-1">Home</span>
            </a>

            <a href="finance" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
                <i class="fa-solid fa-chart-line text-lg"></i>
                <span class="mt-1">Finance</span>
            </a>

            <a href="cards" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
                <i class="fa-solid fa-credit-card text-lg"></i>
                <span class="mt-1">Cards</span>
            </a>

            <a href="profile" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
                <i class="fa-solid fa-user text-lg"></i>
                <span class="mt-1">Me</span>
            </a>
        </div>
    </div>

    <script>
        function logout() {

            alert("You have been logged out.");
            window.location.href = "login";
        }
    </script>
</body>

</html>