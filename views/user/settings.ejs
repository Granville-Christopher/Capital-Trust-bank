    <script>
        function toggleKycDetails() {
            document.getElementById("kycDetails").classList.toggle("hidden");
        }

        function logout() {
            if (confirm("Are you sure you want to log out?")) {
                window.location.href = "/secure/ctb/logout";
            }
        }
    </script>
</body>

</html>
