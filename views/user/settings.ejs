<!DOCTYPE html>
<html lang="en">


<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capital Trust Bank - Settings</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <link rel="icon" type="image/png" sizes="32x32" href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank" />
    <link rel="icon" type="image/png" sizes="16x16" href="https://placehold.co/16x16/2563EB/DBEAFE?text=CTBank" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://placehold.co/180x180/2563EB/DBEAFE?text=CTBank" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#2563EB" />

    <meta property="og:title" content="Capital Trust Bank - Secure & Modern Banking" />
    <meta property="og:description"
        content="Manage your finances with ease. Secure, fast, and reliable banking services for all your needs." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://capital-trust-bank-production.up.railway.app/" />
    <meta property="og:image" content="https://capital-trust-bank-production.up.railway.app/images/hpg.jpg" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:site_name" content="Capital Trust Bank" />
    <meta property="og:locale" content="en_NG" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@CTBankOfficial" />
    <meta name="twitter:creator" content="@CTBankOfficial" />
    <meta name="twitter:title" content="Capital Trust Bank - Secure & Modern Banking" />
    <meta name="twitter:description"
        content="Manage your finances with ease. Secure, fast, and reliable banking services for all your needs." />
    <meta name="twitter:image" content="https://capital-trust-bank-production.up.railway.app/images/hpg.jpg" />


</head>

<body
    class="bg-gradient-to-b from-blue-100 to-gray-100 min-h-screen p-6 text-gray-800 space-y-6 relative overflow-y-hidden">

    <div class="flex items-center">
        <button onclick="history.back()" class="text-blue-700 hover:text-blue-900 text-lg">
            <i class="fa-solid fa-arrow-left"></i>
        </button>
        <h2 class="ml-3 text-xl font-semibold">Settings</h2>
    </div>

    <div class="bg-white rounded-xl shadow p-6 space-y-4">
        <h3 class="text-sm font-semibold text-gray-700 mb-2">Security Management</h3>

        <a href="/secure/ctb/changeaccountpassword"
            class="block text-sm hover:bg-blue-50 px-4 py-2 rounded transition">Change Account Password</a>
        <a href="/secure/ctb/resetpassword" class="block text-sm hover:bg-blue-50 px-4 py-2 rounded transition">Forgot
            Account Password</a>
        <a href="/secure/ctb/setpaymentpin" class="block text-sm hover:bg-blue-50 px-4 py-2 rounded transition">Set
            Payment PIN</a>
        <a href="/secure/ctb/changepaymentpin"
            class="block text-sm hover:bg-blue-50 px-4 py-2 rounded transition">Change Payment PIN</a>
        <a href="/secure/ctb/forgotpaymentpin"
            class="block text-sm hover:bg-blue-50 px-4 py-2 rounded transition">Forgot Payment PIN</a>
        <a href="/secure/ctb/setcreditcardpin"
            class="block text-sm hover:bg-blue-50 px-4 py-2 rounded transition">Set Credit Card PIN</a>
        <a href="/secure/ctb/managecreditcardpin"
            class="block text-sm hover:bg-blue-50 px-4 py-2 rounded transition">Manage Credit Card PIN</a>
        <a href="/secure/ctb/setdebitcardpin"
            class="block text-sm hover:bg-blue-50 px-4 py-2 rounded transition">Set Debit Card PIN</a>
        <a href="/secure/ctb/managedebitcardpin"
            class="block text-sm hover:bg-blue-50 px-4 py-2 rounded transition">Manage Debit Card PIN</a>
    </div>

    <div class="bg-white rounded-xl shadow p-6">
        <h3 class="text-sm font-semibold text-gray-700 mb-2">Account Options</h3>
        <a href="#" class="block text-sm text-red-600 hover:bg-red-50 px-4 py-2 rounded transition">Close Account</a>
    </div>

    <div class="mt-8">
        <button onclick="logout()"
            class="w-full py-3 bg-red-600 text-white rounded-full font-medium hover:bg-red-700 transition">
            <i class="fa-solid fa-arrow-right-from-bracket mr-2"></i> Log Out
        </button>
    </div>

    <script>
        function logout() {

            alert("You have been logged out.");
            window.location.href = "login";
        }
    </script>
</body>

</html>