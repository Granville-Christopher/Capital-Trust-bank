<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Capital Trust Bank - Cards</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
  <style>
    .card-face {
      width: 100%;
      height: 200px;
      border-radius: 1rem;
      padding: 1.5rem;
      background-color: #2563eb;
      color: white;
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    }

    .card-back {
      background-color: #1e3a8a;
    }
  </style>
</head>

<body class="bg-gradient-to-b from-blue-100 to-gray-100 min-h-screen p-6 space-y-6 text-gray-800 relative overflow-y-hidden">
  <!-- Credit Card -->
  <section>
    <h2 class="text-xl font-semibold mb-4 md:text-center">Credit Card</h2>
    <div class="relative max-w-md w-full mx-auto">
      <div id="creditCard" class="card-face w-full flex flex-col justify-between">
        <div class="flex justify-between items-center">
          <span><i class="fa-brands fa-cc-mastercard text-2xl"></i></span>
          <span class="text-sm">Credit Card</span>
        </div>
        <div>
          <p id="creditCardNumber" class="text-lg tracking-widest mb-2">1234 5678 9012 3456</p>
          <div class="flex justify-between text-sm">
            <span>Exp: 12/27</span>
            <span id="creditCardCVV">CVV: 123</span>
          </div>
        </div>
        <p class="text-sm mt-2 font-medium">Granville Banks</p>
      </div>
    </div>
  </section>

  <!-- Debit Card -->
  <section>
    <h2 class="text-xl font-semibold mb-4 md:text-center">Debit Card</h2>
    <div class="relative w-full max-w-md mx-auto">
      <div id="debitCard" class="card-face w-full flex flex-col justify-between">
        <div class="flex justify-between items-center">
          <span><i class="fa-brands fa-cc-visa text-2xl"></i></span>
          <span class="text-sm">Debit Card</span>
        </div>
        <div>
          <p id="debitCardNumber" class="text-lg tracking-widest mb-2">9876 5432 1098 7654</p>
          <div class="flex justify-between text-sm">
            <span>Exp: 10/26</span>
            <span id="debitCardCVV">CVV: 456</span>
          </div>
        </div>
        <p class="text-sm mt-2 font-medium">Granville Banks</p>
      </div>
    </div>
  </section>

  <!-- Show/Hide Card Number and CVV Togglers -->
  <section class="grid grid-cols-2 gap-4 mt-6 text-center max-w-md mx-auto">
    <!-- Credit Card Number and CVV Toggler -->
    <button id="toggleCreditInfo"
      class="flex items-center justify-center bg-white rounded-xl shadow px-4 py-5 hover:bg-blue-50 transition">
      <i id="creditEyeIcon" class="fa-solid fa-eye text-blue-600 text-2xl mr-2"></i>
      <span class="text-sm font-medium">Show Credit Card Info</span>
    </button>

    <!-- Debit Card Number and CVV Toggler -->
    <button id="toggleDebitInfo"
      class="flex items-center justify-center bg-white rounded-xl shadow px-4 py-5 hover:bg-blue-50 transition">
      <i id="debitEyeIcon" class="fa-solid fa-eye text-blue-600 text-2xl mr-2"></i>
      <span class="text-sm font-medium">Show Debit Card Info</span>
    </button>
  </section>

  <section class="grid grid-cols-2 gap-4 mt-6 mb-2 text-center max-w-md mx-auto">
    <!-- Credit Card Number and CVV Toggler -->
    <a href="creditcard" class="flex items-center justify-center bg-white rounded-xl shadow px-4 py-3 hover:bg-blue-50 transition no-underline">
      <span class="text-sm font-medium">View Credit Card</span>
    </a>

    <!-- Debit Card Number and CVV Toggler -->
    <a href="debitcard" class="flex items-center justify-center bg-white rounded-xl shadow px-4 py-3 hover:bg-blue-50 transition no-underline">
      <span class="text-sm font-medium">View Debit Card</span>
    </a>
  </section>

  <!-- Fixed Bottom Navigation -->
  <div class="fixed bottom-0 left-0 right-0 bg-gray-100 border-t-2 shadow-md z-50">
    <div class="flex justify-between items-center px-8 py-3 text-xs text-gray-700">

      <!-- Home -->
      <a href="dashboard" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
        <i class="fa-solid fa-house text-lg"></i>
        <span class="mt-1">Home</span>
      </a>

      <!-- Finance -->
      <a href="finance" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
        <i class="fa-solid fa-chart-line text-lg"></i>
        <span class="mt-1">Finance</span>
      </a>

      <!-- Cards -->
      <a href="cards" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
        <i class="fa-solid fa-credit-card text-lg"></i>
        <span class="mt-1">Cards</span>
      </a>

      <!-- Me -->
      <a href="profile" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
        <i class="fa-solid fa-user text-lg"></i>
        <span class="mt-1">Me</span>
      </a>

    </div>
  </div>
  <script src="/js/frontendfiles/cardstoggle.js"></script>
</body>

</html>