<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Capital Trust Bank - Cards</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="icon" type="image/png" sizes="32x32" href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank" />
  <link rel="icon" type="image/png" sizes="16x16" href="https://placehold.co/16x16/2563EB/DBEAFE?text=CTBank" />
  <link rel="apple-touch-icon" sizes="180x180" href="https://placehold.co/180x180/2563EB/DBEAFE?text=CTBank" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#4f46e5" />

  <style>
    * {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    .glass-effect {
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(14, 165, 233, 0.1);
    }

    .card-face {
      width: 100%;
      height: 220px;
      border-radius: 1.5rem;
      padding: 1.5rem;
      background: linear-gradient(135deg, #4f46e5 0%, #4338ca 50%, #3730a3 100%);
      color: white;
      box-shadow: 0 12px 24px rgba(79, 70, 229, 0.3);
      position: relative;
      overflow: hidden;
    }

    .card-face::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
    }

    .card-back {
      background: linear-gradient(135deg, #3730a3 0%, #4338ca 100%);
    }

    .card-number {
      letter-spacing: 0.15em;
      font-weight: 600;
    }

    .bottom-nav {
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.06);
      border-top: 1px solid #e2e8f0;
    }

    .nav-item.active {
      color: #4f46e5;
    }
  </style>
</head>

<body class="bg-gradient-to-br from-slate-50 via-indigo-50/20 to-slate-50 min-h-screen pb-20">
  <div class="fixed top-0 left-0 right-0 glass-effect flex items-center px-4 py-3 z-30 shadow-sm">
    <button onclick="history.back()" class="w-9 h-9 rounded-full bg-white shadow-md flex items-center justify-center hover:bg-gray-50 transition border border-gray-100 mr-2">
      <i class="fa-solid fa-arrow-left text-gray-700 text-sm"></i>
    </button>
    <h2 class="text-sm font-bold text-gray-800">My Cards</h2>
  </div>

  <div class="pt-16 px-4 space-y-4">
    <!-- Credit Card -->
    <section>
      <h2 class="text-sm font-bold text-gray-700 mb-3 px-1">Credit Card</h2>
      <div class="relative max-w-md w-full mx-auto">
        <div id="creditCard" class="card-face w-full flex flex-col justify-between relative z-10">
          <div class="flex justify-between items-center">
            <span>
              <i class="fa-brands fa-cc-<%= creditCard ? creditCard.cardType : 'mastercard' %> text-3xl"></i>
            </span>
            <span class="text-sm font-semibold bg-white/20 px-3 py-1 rounded-lg backdrop-blur-sm">Credit Card</span>
          </div>
          <div>
            <p id="creditCardNumber" class="text-xl tracking-widest mb-3 font-semibold card-number">
              <%= creditCard ? creditCard.cardNumber.replace(/(.{4})/g, "$1 " ) : "1234 5678 9012 3456" %>
            </p>
            <div class="flex justify-between text-sm">
              <span class="font-medium">
                Exp: <%= creditCard ? (new Date(creditCard.expiryDate)).toLocaleDateString("en-US", { month: "2-digit", year: "numeric" }) : "12/27" %>
              </span>
              <span id="creditCardCVV" class="font-medium">
                CVV: <%= creditCard ? creditCard.cvv : "123" %>
              </span>
            </div>
          </div>
          <p class="text-sm mt-2 font-semibold">
            <%= userName %>
          </p>
        </div>
      </div>
    </section>

    <!-- Debit Card -->
    <section>
      <h2 class="text-sm font-bold text-gray-700 mb-3 px-1">Debit Card</h2>
      <div class="relative w-full max-w-md mx-auto">
        <div id="debitCard" class="card-face w-full flex flex-col justify-between relative z-10" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 50%, #4338ca 100%); box-shadow: 0 12px 24px rgba(99, 102, 241, 0.3);">
          <div class="flex justify-between items-center">
            <span>
              <i class="fa-brands fa-cc-<%= debitCard ? debitCard.cardType : 'visa' %> text-3xl"></i>
            </span>
            <span class="text-sm font-semibold bg-white/20 px-3 py-1 rounded-lg backdrop-blur-sm">Debit Card</span>
          </div>
          <div>
            <p id="debitCardNumber" class="text-xl tracking-widest mb-3 font-semibold card-number">
              <%= debitCard ? debitCard.cardNumber.replace(/(.{4})/g, "$1 " ) : "9876 5432 1098 7654" %>
            </p>
            <div class="flex justify-between text-sm">
              <span class="font-medium">
                Exp: <%= debitCard ? (new Date(debitCard.expiryDate)).toLocaleDateString("en-US", { month: "2-digit", year: "numeric" }) : "10/26" %>
              </span>
              <span id="debitCardCVV" class="font-medium">
                CVV: <%= debitCard ? debitCard.cvv : "456" %>
              </span>
            </div>
          </div>
          <p class="text-sm mt-2 font-semibold">
            <%= userName %>
          </p>
        </div>
      </div>
    </section>

    <!-- Action Buttons -->
    <section class="grid grid-cols-2 gap-2.5 max-w-md mx-auto">
      <button id="toggleCreditInfo"
        class="bg-white rounded-xl shadow-sm border border-gray-200 px-3 py-3 hover:bg-gray-50 transition flex flex-col items-center justify-center gap-1.5">
        <i id="creditEyeIcon" class="fa-solid fa-eye text-indigo-600 text-base"></i>
        <span class="text-xs font-semibold text-gray-700">Show Credit Info</span>
      </button>

      <button id="toggleDebitInfo"
        class="bg-white rounded-xl shadow-sm border border-gray-200 px-3 py-3 hover:bg-gray-50 transition flex flex-col items-center justify-center gap-1.5">
        <i id="debitEyeIcon" class="fa-solid fa-eye text-violet-600 text-base"></i>
        <span class="text-xs font-semibold text-gray-700">Show Debit Info</span>
      </button>
    </section>

    <section class="grid grid-cols-2 gap-2.5 max-w-md mx-auto">
      <a href="creditcard"
        class="bg-white rounded-xl shadow-sm border border-gray-200 px-3 py-3 hover:bg-gray-50 transition flex flex-col items-center justify-center gap-1.5 no-underline">
        <i class="fa-solid fa-credit-card text-indigo-600 text-base"></i>
        <span class="text-xs font-semibold text-gray-700">View Credit Card</span>
      </a>

      <a href="debitcard"
        class="bg-white rounded-xl shadow-sm border border-gray-200 px-3 py-3 hover:bg-gray-50 transition flex flex-col items-center justify-center gap-1.5 no-underline">
        <i class="fa-solid fa-credit-card-alt text-violet-600 text-base"></i>
        <span class="text-xs font-semibold text-gray-700">View Debit Card</span>
      </a>
    </section>
  </div>

  <div class="fixed bottom-0 left-0 right-0 bottom-nav z-50">
    <div class="flex justify-around items-center px-4 py-2.5">
      <a href="dashboard" class="flex flex-col items-center gap-0.5 text-gray-600">
        <div class="w-9 h-9 rounded-lg flex items-center justify-center">
          <i class="fa-solid fa-house text-sm"></i>
        </div>
        <span class="text-xs font-medium">Home</span>
      </a>
      <a href="finance" class="flex flex-col items-center gap-0.5 text-gray-600">
        <div class="w-9 h-9 rounded-lg flex items-center justify-center">
          <i class="fa-solid fa-chart-line text-sm"></i>
        </div>
        <span class="text-xs font-medium">Finance</span>
      </a>
      <a href="cards" class="nav-item active flex flex-col items-center gap-0.5">
        <div class="w-9 h-9 rounded-lg bg-indigo-50 flex items-center justify-center">
          <i class="fa-solid fa-credit-card text-indigo-600 text-sm"></i>
        </div>
        <span class="text-xs font-medium text-indigo-600">Cards</span>
      </a>
      <a href="profile" class="flex flex-col items-center gap-0.5 text-gray-600">
        <div class="w-9 h-9 rounded-lg flex items-center justify-center">
          <i class="fa-solid fa-user text-sm"></i>
        </div>
        <span class="text-xs font-medium">Profile</span>
      </a>
    </div>
  </div>
  <script src="/js/frontendfiles/cardstoggle.js"></script>
    <%- include('partials/floatingchat') %>
</body>

</html>
