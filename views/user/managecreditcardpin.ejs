<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capital Trust Bank - Manage credit card pin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" sizes="32x32" href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank" />
    <link rel="icon" type="image/png" sizes="16x16" href="https://placehold.co/16x16/2563EB/DBEAFE?text=CTBank" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://placehold.co/180x180/2563EB/DBEAFE?text=CTBank" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#4f46e5" />
</head>

<body class="bg-gradient-to-br from-slate-50 via-indigo-50/20 to-slate-50 min-h-screen pb-24">
    <div class="fixed top-0 left-0 right-0 bg-white/98 backdrop-blur-lg border-b border-gray-100 flex items-center px-5 py-4 z-30 shadow-sm">
        <button onclick="history.back()" class="w-10 h-10 rounded-full bg-white shadow-md flex items-center justify-center hover:bg-gray-50 transition border border-gray-100 mr-3">
            <i class="fa-solid fa-arrow-left text-gray-700"></i>
        </button>
        <h2 class="text-lg font-bold text-gray-800">Manage Credit Card PIN</h2>
    </div>

    <div class="pt-20 px-5 flex flex-col justify-center items-center min-h-[calc(100vh-80px)]">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 max-w-sm w-full text-center">
            <div class="w-16 h-16 rounded-full bg-indigo-100 flex items-center justify-center mx-auto mb-4">
                <i class="fa-solid fa-credit-card text-indigo-600 text-2xl"></i>
            </div>
            <h2 class="text-xl font-bold text-gray-800 mb-6">Manage Credit Card PIN</h2>

            <button id="resetPinBtn"
                class="w-full py-3 bg-gradient-to-r from-indigo-600 to-indigo-700 text-white rounded-xl font-semibold hover:from-indigo-700 hover:to-indigo-800 transition shadow-lg mb-6">
                Reset Card PIN
            </button>

            <div id="resetPinSection" class="hidden space-y-5">
                <form id="resetPinForm">
                    <p class="text-sm font-semibold text-gray-700 mb-3">Enter your login PIN</p>
                    <div class="flex justify-center gap-2 mb-5">
                        <input type="password" maxlength="1" class="pin-box" id="loginPin1" />
                        <input type="password" maxlength="1" class="pin-box" id="loginPin2" />
                        <input type="password" maxlength="1" class="pin-box" id="loginPin3" />
                        <input type="password" maxlength="1" class="pin-box" id="loginPin4" />
                        <input type="password" maxlength="1" class="pin-box" id="loginPin5" />
                        <input type="password" maxlength="1" class="pin-box" id="loginPin6" />
                    </div>

                    <p class="text-sm font-semibold text-gray-700 mb-3">Enter your new card PIN</p>
                    <div class="flex justify-center gap-2 mb-5">
                        <input type="password" maxlength="1" class="pin-box" id="newCardPin1" />
                        <input type="password" maxlength="1" class="pin-box" id="newCardPin2" />
                        <input type="password" maxlength="1" class="pin-box" id="newCardPin3" />
                        <input type="password" maxlength="1" class="pin-box" id="newCardPin4" />
                    </div>

                    <p class="text-sm font-semibold text-gray-700 mb-3">Confirm your new card PIN</p>
                    <div class="flex justify-center gap-2 mb-6">
                        <input type="password" maxlength="1" class="pin-box" id="confirmCardPin1" />
                        <input type="password" maxlength="1" class="pin-box" id="confirmCardPin2" />
                        <input type="password" maxlength="1" class="pin-box" id="confirmCardPin3" />
                        <input type="password" maxlength="1" class="pin-box" id="confirmCardPin4" />
                    </div>

                    <button type="submit"
                        class="w-full py-3 bg-gradient-to-r from-indigo-600 to-indigo-700 text-white rounded-xl font-semibold hover:from-indigo-700 hover:to-indigo-800 transition shadow-lg">
                        Submit
                    </button>
                </form>
            </div>
        </div>
    </div>

    <style>
        .pin-box {
            width: 3rem;
            height: 3rem;
            text-align: center;
            font-size: 1.25rem;
            font-weight: 600;
            border: 2px solid #e2e8f0;
            border-radius: 0.75rem;
            outline: none;
            transition: all 0.3s;
        }

        .pin-box:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }
    </style>

    <div id="generatingModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center hidden z-50 p-4">
        <div class="bg-white rounded-2xl shadow-2xl p-8 w-full max-w-sm text-center">
            <i class="fa-solid fa-spinner fa-spin text-indigo-600 text-5xl mb-4"></i>
            <h3 class="text-lg font-bold text-gray-800">Resetting Card PIN...</h3>
            <p class="text-sm text-gray-500 mt-2">Please wait while we reset your card PIN.</p>
        </div>
    </div>

    <div id="pinModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50 hidden p-4">
        <div class="bg-white rounded-2xl shadow-2xl p-8 w-full max-w-sm text-center relative">
            <div id="successIcon" class="mb-4">
                <div class="w-16 h-16 rounded-full bg-emerald-100 flex items-center justify-center mx-auto mb-4">
                    <i class="fa-solid fa-circle-check text-emerald-600 text-3xl"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-800">Card PIN Reset Successfully</h3>
                <p class="text-sm text-gray-500 mt-2">Your card PIN has been reset.</p>
            </div>

            <div id="failureIcon" class="mb-4 hidden">
                <div class="w-16 h-16 rounded-full bg-red-100 flex items-center justify-center mx-auto mb-4">
                    <i class="fa-solid fa-circle-xmark text-red-600 text-3xl"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-800">Failed to Reset Card PIN</h3>
                <p class="text-sm text-gray-500 mt-2">Something went wrong. Please try again.</p>
            </div>

            <button onclick="closePinModal()"
                class="mt-6 w-full py-3 bg-indigo-600 text-white rounded-xl hover:bg-indigo-700 transition font-semibold shadow-lg">
                Close
            </button>
        </div>
    </div>

    <div class="fixed bottom-0 left-0 right-0 bg-white/98 backdrop-blur-lg border-t border-gray-100 z-50">
        <div class="flex justify-around items-center px-6 py-3">
            <a href="/udp/dashboard" class="flex flex-col items-center gap-1 text-gray-600">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center">
                    <i class="fa-solid fa-house text-lg"></i>
                </div>
                <span class="text-xs font-medium">Home</span>
            </a>
            <a href="/udp/finance" class="flex flex-col items-center gap-1 text-gray-600">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center">
                    <i class="fa-solid fa-chart-line text-lg"></i>
                </div>
                <span class="text-xs font-medium">Finance</span>
            </a>
            <a href="/udp/cards" class="flex flex-col items-center gap-1 text-gray-600">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center">
                    <i class="fa-solid fa-credit-card text-lg"></i>
                </div>
                <span class="text-xs font-medium">Cards</span>
            </a>
            <a href="/udp/profile" class="flex flex-col items-center gap-1 text-gray-600">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center">
                    <i class="fa-solid fa-user text-lg"></i>
                </div>
                <span class="text-xs font-medium">Profile</span>
            </a>
        </div>
    </div>

    <script>
        function setupInputs(selector) {
            const inputs = document.querySelectorAll(selector);
            inputs.forEach((input, index) => {
                input.addEventListener("input", () => {
                    if (input.value && index < inputs.length - 1) {
                        inputs[index + 1].focus();
                    }
                });
                input.addEventListener("keydown", (e) => {
                    if (e.key === "Backspace" && !input.value && index > 0) {
                        inputs[index - 1].focus();
                    }
                });
            });
        }

        document.addEventListener("DOMContentLoaded", () => {
            setupInputs(".pin-box");

            const resetPinBtn = document.getElementById("resetPinBtn");
            const resetPinSection = document.getElementById("resetPinSection");

            resetPinBtn.addEventListener("click", () => {
                resetPinSection.classList.toggle("hidden");
            });

            const generatingModal = document.getElementById("generatingModal");
            const pinModal = document.getElementById("pinModal");
            const successIcon = document.getElementById("successIcon");
            const failureIcon = document.getElementById("failureIcon");

            function closePinModal() {
                pinModal.classList.add("hidden");
            }
            window.closePinModal = closePinModal;

            document.getElementById("resetPinForm").addEventListener("submit", function (e) {
                e.preventDefault();
                generatingModal.classList.remove("hidden");
                setTimeout(() => {
                    generatingModal.classList.add("hidden");
                    successIcon.classList.remove("hidden");
                    failureIcon.classList.add("hidden");
                    pinModal.classList.remove("hidden");
                }, 2000);
            });
        });
    </script>
</body>

</html>
