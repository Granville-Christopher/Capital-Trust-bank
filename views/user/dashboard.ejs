<!DOCTYPE html>
<html lang="en">


<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capital Trust Bank - Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <link rel="icon" type="image/png" sizes="32x32" href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank" />
    <link rel="icon" type="image/png" sizes="16x16" href="https://placehold.co/16x16/2563EB/DBEAFE?text=CTBank" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://placehold.co/180x180/2563EB/DBEAFE?text=CTBank" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#2563EB" />

    <meta property="og:title" content="Capital Trust Bank - Secure & Modern Banking" />
    <meta property="og:description"
        content="Manage your finances with ease. Secure, fast, and reliable banking services for all your needs." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://capital-trust-bank-production.up.railway.app/" />
    <meta property="og:image" content="https://capital-trust-bank-production.up.railway.app/images/hpg.jpg" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:site_name" content="Capital Trust Bank" />
    <meta property="og:locale" content="en_NG" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@CTBankOfficial" />
    <meta name="twitter:creator" content="@CTBankOfficial" />
    <meta name="twitter:title" content="Capital Trust Bank - Secure & Modern Banking" />
    <meta name="twitter:description"
        content="Manage your finances with ease. Secure, fast, and reliable banking services for all your needs." />
    <meta name="twitter:image" content="https://capital-trust-bank-production.up.railway.app/images/hpg.jpg" />


</head>

<body class="bg-gradient-to-b relative overflow-y-hidden from-blue-100 to-gray-100 min-h-screen p-6 space-y-8">

    <div class="fixed top-0 left-0 bg-blue-100 right-0 flex justify-between align-center px-4 py-3 z-10">
        <a href="profile" class="flex justify-start gap-2 items-center">
            <span class="text-blue-50 bg-blue-600 rounded-full px-2 py-1"><i class="fa-solid fa-user "></i></span>
            <h2 class="text-lg font-semibold text-gray-800">
                <span id="greeting"></span>,
                <h2 class="text-lg font-semibold">
                    <%= user.Name.split(' ')[0] %>
                </h2>
            </h2>
        </a>
        <a href="notifications"><i class="fa fa-bell text-blue-600 text-2xl"></i></a>
    </div>

    <div class="bg-black text-white rounded-xl p-6 relative shadow-lg h-[180px]">
        <div class="absolute top-4 right-6 text-right">
            <p class="text-sm font-semibold">Personal Account</p>
            <p class="text-xs text-gray-300">Savings Account</p>
            <div class="accountid mt-3">
                <p class="text-gray-400 text-xs">Account number:</p>
                <style>
                    .account-id-wrapper {
                        position: relative;
                        display: inline-block;
                        margin-bottom: 5px;
                    }

                    .copy-feedback {
                        position: absolute;
                        top: 100%;
                        left: 70%;
                        transform: translateX(-50%);
                        white-space: nowrap;
                        padding: 4px 8px;
                        background-color: #18aaf3;
                        color: #ffffff;
                        border-radius: 4px;
                        font-size: 0.8em;
                        opacity: 0;
                        transition: opacity 0.3s ease-in-out;
                        pointer-events: none;
                        z-index: 10;
                    }

                    .copy-feedback.show {
                        opacity: 1;
                    }
                </style>
                <p id="copyAccountId"
                    class="inline-flex items-center text-lg cursor-pointer hover:text-blue-600 transition">
                    <i class="fas fa-copy text-blue-400 mr-2"></i>
                    <%= user.AccountNumber%>
                </p>
                <span id="copyFeedback" class="copy-feedback">Copied!</span>

            </div>
        </div>

        <div class="absolute top-4 left-6">
            <p class="text-xs text-gray-400">Available Balance <button onclick="toggleBalance()"
                    class="text-blue-400 ml-2 text-sm">
                    <i id="balanceIcon" class="fa-solid fa-eye"></i>
                </button></p>
            <div class="flex items-center space-x-2 mt-1">
                <p id="balanceAmount" class="text-2xl font-bold">$<%= user.AccountBalance %>
                </p>
            </div>
        </div>

        <div class="absolute bottom-4 left-6 text-sm">
            <a href="transactionhistory" class="text-blue-400 hover:underline">View Transaction History</a>
        </div>

        <div class="absolute bottom-4 right-6 text-sm text-gray-300">Nigeria</div>
    </div>

    <div class="grid grid-cols-2 gap-4">
        <a href="internationaltransfer"
            class="bg-white rounded-xl px-auto flex justify-start pl-2 items-center shadow hover:shadow-md hover:bg-blue-50 transition">
            <div class="flex items-center space-x-3">
                <i class="fa-solid fa-globe text-blue-600 text-lg"></i>
                <h3 class="font-semibold text-gray-800 text-xs md:text-md">International Transfer</h3>
            </div>
        </a>

        <a href="localtransfer"
            class="bg-white rounded-xl flex justify-start pl-2 items-center px-auto shadow hover:shadow-md hover:bg-blue-50 transition">
            <div class="flex items-center space-x-3">
                <i class="fa-solid fa-location-dot text-blue-600 text-lg"></i>
                <h3 class="font-semibold text-gray-800 text-xs md:text-md">Local Transfer</h3>
            </div>
        </a>
    </div>

    <div class="bg-white rounded-xl shadow p-3 h-[180px] ">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Recent Transactions</h3>
        <ul class="space-y-3 text-sm">
            <% if (recentTransactions && recentTransactions.length> 0) { %>
                <% recentTransactions.forEach(transaction=> { %>
                    <li class="flex justify-between border-b pb-2">
                        <span>
                            <% if (transaction.type===' debit' && transaction.description.startsWith('Transfer to ')) { %>
                            <%= transaction.description.split(' (')[0].trim() %>
                        <% } else if (transaction.type==='credit' && transaction.description.startsWith('Transfer from ')) { %>
                            <%= transaction.description.split(' (')[0].trim() %>
                            <% } else { %>
                                <%= transaction.description %>
                                    <% } %>
                                        </span>
                                        <span class="font-semibold
                        <% if (transaction.type === 'debit') { %>
                            text-red-600
                        <% } else if (transaction.type === 'credit') { %>
                            text-green-600
                        <% } else { %>
                            text-gray-800
                        <% } %>
                    ">
                                            <% if (transaction.type==='debit' ) { %>-<% } %>
                                                    ₦<%= transaction.amount.toLocaleString(undefined, {
                                                        minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                        </span>
                                        </li>
                                        <% }) %>
                                            <% } else { %>
                                                <li class="text-gray-500 text-center">No recent transactions.</li>
                                                <% } %>
                                                    </ul>
    </div>

    <div class="grid grid-cols-2 gap-4">
        <a href="creditcard" class="bg-white rounded-xl p-6 shadow hover:shadow-md hover:bg-blue-50 transition">
            <div class="flex items-center space-x-3">
                <i class="fa-solid fa-credit-card text-blue-600 text-lg"></i>
                <h3 class="font-semibold text-gray-800">Credit Card</h3>
            </div>
        </a>

        <a href="debitcard" class="bg-white rounded-xl p-6 shadow hover:shadow-md hover:bg-blue-50 transition">
            <div class="flex items-center space-x-3">
                <i class="fa-solid fa-credit-card-alt text-blue-600 text-lg"></i>
                <h3 class="font-semibold text-gray-800">Debit Card</h3>
            </div>
        </a>

        <a href="finance" class="bg-white rounded-xl p-6 shadow hover:shadow-md hover:bg-blue-50 transition">
            <div class="flex items-center space-x-3">
                <i class="fa-solid fa-hand-holding-dollar text-blue-600 text-lg"></i>
                <h3 class="font-semibold text-gray-800"> Loans </h3>
            </div>
        </a>

        <a href="finance" class="bg-white rounded-xl p-6 shadow hover:shadow-md hover:bg-blue-50 transition">
            <div class="flex items-center space-x-3">
                <i class="fa-solid fa-piggy-bank text-blue-600 text-lg"></i>
                <h3 class="font-semibold text-gray-800">Savings</h3>
            </div>
        </a>
    </div>
    <div class="fixed bottom-0 left-0 right-0 bg-gray-100 border-t-2 shadow-md z-50">
        <div class="flex justify-between items-center px-8 py-3 text-xs text-gray-700">

            <a href="dashboard" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
                <i class="fa-solid fa-house text-lg"></i>
                <span class="mt-1">Home</span>
            </a>

            <a href="finance" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
                <i class="fa-solid fa-chart-line text-lg"></i>
                <span class="mt-1">Finance</span>
            </a>

            <a href="cards" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
                <i class="fa-solid fa-credit-card text-lg"></i>
                <span class="mt-1">Cards</span>
            </a>

            <a href="profile" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
                <i class="fa-solid fa-user text-lg"></i>
                <span class="mt-1">Me</span>
            </a>

        </div>
    </div>
    <script src="/js/frontendfiles/balancetoggle.js"></script>
    <script src="/js/frontendfiles/customgreeting.js"></script>
    <script src="/js/frontendfiles/copyaccountid.js"></script>
</body>

</html>