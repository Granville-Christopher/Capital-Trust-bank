<!DOCTYPE html>
<html lang="en">


<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capital Trust Bank - Credit card</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <link rel="icon" type="image/png" sizes="32x32" href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank" />
    <link rel="icon" type="image/png" sizes="16x16" href="https://placehold.co/16x16/2563EB/DBEAFE?text=CTBank" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://placehold.co/180x180/2563EB/DBEAFE?text=CTBank" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#2563EB" />

    <meta property="og:title" content="Capital Trust Bank - Secure & Modern Banking" />
    <meta property="og:description"
        content="Manage your finances with ease. Secure, fast, and reliable banking services for all your needs." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://capital-trust-bank-production.up.railway.app/" />
    <meta property="og:image" content="https://capital-trust-bank-production.up.railway.app/images/hpg.jpg" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:site_name" content="Capital Trust Bank" />
    <meta property="og:locale" content="en_NG" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@CTBankOfficial" />
    <meta name="twitter:creator" content="@CTBankOfficial" />
    <meta name="twitter:title" content="Capital Trust Bank - Secure & Modern Banking" />
    <meta name="twitter:description"
        content="Manage your finances with ease. Secure, fast, and reliable banking services for all your needs." />
    <meta name="twitter:image" content="https://capital-trust-bank-production.up.railway.app/images/hpg.jpg" />


</head>
<style>
    .card-face {
        width: 100%;
        height: 200px;
        border-radius: 1rem;
        padding: 1.5rem;
        background-color: #2563eb;
        color: white;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    }

    .card-back {
        background-color: #1e3a8a;
    }
</style>

<body
    class="bg-gradient-to-b from-blue-100 to-gray-100 min-h-screen p-6 text-gray-800 space-y-6 relative">

    <div id="noCardSection" class="hidden text-center">
        <p class="text-sm mb-4">No card available</p>
        <button onclick="toggleCardCreation()"
            class="bg-blue-600 text-white px-4 py-2 rounded-full hover:bg-blue-700 transition">
            Create New Credit Card?
        </button>
    </div>

    <div id="cardTypeSelector" class="hidden bg-white rounded-xl shadow p-6 max-w-md mx-auto">
        <p class="text-sm font-semibold mb-4 text-center text-gray-700">Select Debit Card Type</p>
        <div class="grid grid-cols-2 gap-4">
            <div id="mastercardOption" onclick="selectCard('mastercard')"
                class="cursor-pointer border-2 rounded-xl p-4 flex flex-col items-center transition hover:border-blue-400">
                <i class="fa-brands fa-cc-mastercard text-4xl text-orange-500 mb-2"></i>
                <span class="text-sm font-medium text-gray-700">Mastercard</span>
            </div>
            <div id="visaOption" onclick="selectCard('visa')"
                class="cursor-pointer border-2 rounded-xl p-4 flex flex-col items-center transition hover:border-blue-400">
                <i class="fa-brands fa-cc-visa text-4xl text-blue-600 mb-2"></i>
                <span class="text-sm font-medium text-gray-700">Visa</span>
            </div>
        </div>
        <button onclick="confirmCardType()"
            class="mt-6 w-full py-2 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition">
            Continue
        </button>
    </div>
    <div class="relative w-full max-w-md mx-auto">
        <div id="carouselSlides" class="w-full">
            <div class="card-face w-full flex flex-col justify-between">
                <div class="flex justify-between items-center">
                    <span><i class="fa-brands fa-cc-mastercard text-2xl"></i></span>
                    <span class="text-sm">Credit Card</span>
                </div>
                <div>
                    <p class="text-lg tracking-widest mb-2">1234 5678 9012 3456</p>
                    <div class="flex justify-between text-sm">
                        <span>Exp: 12/27</span>
                        <span>CVV: 123</span>
                    </div>
                </div>
                <p class="text-sm mt-2 font-medium">Granville Banks</p>
            </div>
        </div>

    </div>
    <div class="grid grid-cols-2 gap-4 mt-6 text-center">
        <button
            class="flex flex-col items-center justify-center bg-white rounded-xl shadow px-4 py-5 hover:bg-blue-50 transition">
            <i class="fa-solid fa-snowflake text-blue-600 text-2xl mb-1"></i>
            <span class="text-sm font-medium text-gray-700">Freeze Card</span>
        </button>

        <button
            class="flex flex-col items-center justify-center bg-white rounded-xl shadow px-4 py-5 hover:bg-red-50 transition">
            <i class="fa-solid fa-ban text-red-600 text-2xl mb-1"></i>
            <span class="text-sm font-medium text-red-700">Terminate Card</span>
        </button>
    </div>

    <a href="/secure/ctb/managecreditcardpin" class="w-full">
        <button
            class="items-center justify-center bg-white rounded-xl mt-4 w-full shadow px-4 py-5 hover:bg-blue-50 transition">
            <i class="fa-solid fa-edit text-blue-600 text-2xl mb-1"></i>
            <span class="text-sm font-medium text-blue-700">Manage Card</span>
        </button>
    </a>

    <div id="generatingModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
        <div class="bg-white rounded-xl shadow-xl p-6 w-full max-w-sm text-center">
            <i class="fa-solid fa-spinner fa-spin text-blue-600 text-4xl mb-4"></i>
            <h3 class="text-lg font-semibold">Generating Card...</h3>
            <p class="text-sm text-gray-500">Please wait while we generate your card.</p>
        </div>
    </div>

    <div class="fixed bottom-0 left-0 right-0 bg-gray-100 border-t-2 shadow-md z-50">
        <div class="flex justify-between items-center px-8 py-3 text-xs text-gray-700">

            <a href="dashboard" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
                <i class="fa-solid fa-house text-lg"></i>
                <span class="mt-1">Home</span>
            </a>

            <a href="finance" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
                <i class="fa-solid fa-chart-line text-lg"></i>
                <span class="mt-1">Finance</span>
            </a>

            <a href="cards" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
                <i class="fa-solid fa-credit-card text-lg"></i>
                <span class="mt-1">Cards</span>
            </a>

            <a href="profile" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
                <i class="fa-solid fa-user text-lg"></i>
                <span class="mt-1">Me</span>
            </a>

        </div>
    </div>

    <script src="/js/frontendfiles/creditcard.js"> </script>

</body>

</html>