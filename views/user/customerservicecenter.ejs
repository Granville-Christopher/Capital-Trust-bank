<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capital Trust Bank - Customer Service Center</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="icon" type="image/png" sizes="32x32" href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank" />
    <link rel="icon" type="image/png" sizes="16x16" href="https://placehold.co/16x16/2563EB/DBEAFE?text=CTBank" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://placehold.co/180x180/2563EB/DBEAFE?text=CTBank" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#4f46e5" />
  </head>

  <body class="bg-gradient-to-br from-slate-50 via-indigo-50/20 to-slate-50 min-h-screen pb-24">
    <div class="fixed top-0 left-0 right-0 bg-white/98 backdrop-blur-lg border-b border-gray-100 flex items-center px-4 py-3 z-30 shadow-sm">
        <button onclick="history.back()" class="w-9 h-9 rounded-full bg-white shadow-md flex items-center justify-center hover:bg-gray-50 transition border border-gray-100 mr-2">
            <i class="fa-solid fa-arrow-left text-gray-700 text-sm"></i>
        </button>
        <h2 class="text-sm font-bold text-gray-800">Customer Service Center</h2>
    </div>

    <div class="pt-20 px-4 space-y-4 flex flex-col items-center">
      <div class="flex flex-col gap-4 max-w-md w-full">
        
        <!-- Live Chat Card -->
        <button
          type="button"
          onclick="window.openSupportChat ? window.openSupportChat() : null"
          class="text-left flex items-center space-x-3 bg-white rounded-2xl shadow-sm border border-indigo-100 p-5 w-full hover:shadow-md transition hover:border-indigo-500 group relative overflow-hidden"
        >
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 flex items-center justify-center flex-shrink-0 text-white shadow-md group-hover:scale-105 transition">
            <i class="fa-solid fa-headset text-xl"></i>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-0.5">
              <h3 class="text-sm font-bold text-gray-900">Live Support Chat</h3>
              <span class="px-2 py-0.5 bg-emerald-50 text-emerald-700 text-[10px] font-bold rounded-full border border-emerald-200 flex items-center gap-1">
                <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span> Online
              </span>
            </div>
            <p class="text-xs text-gray-600 leading-relaxed">
              Chat in real-time with an official banking support specialist for instant assistance.
            </p>
            <p class="text-xs text-indigo-600 font-semibold mt-1.5 flex items-center gap-1">
              <span>Start Conversation</span>
              <i class="fa-solid fa-arrow-right text-[10px]"></i>
            </p>
          </div>
        </button>

        <!-- Email Support Card -->
        <a
          href="mailto:capitaltrustbank920@gmail.com"
          class="flex items-center space-x-3 bg-white rounded-2xl shadow-sm border border-gray-100 p-5 w-full hover:shadow-md transition hover:border-indigo-500 group"
        >
          <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center flex-shrink-0 group-hover:bg-indigo-600 transition">
            <i class="fas fa-envelope text-slate-600 text-xl group-hover:text-white transition"></i>
          </div>
          <div>
            <h3 class="text-sm font-bold text-gray-800 mb-0.5">Email Support</h3>
            <p class="text-xs text-gray-600 leading-relaxed">
              Send us an inquiry and our desk team will reply directly to your verified address.
            </p>
            <p class="text-xs text-indigo-600 font-semibold mt-1">capitaltrustbank920@gmail.com</p>
          </div>
        </a>

      </div>
    </div>

    <%- include('partials/floatingchat') %>

    <div class="fixed bottom-0 left-0 right-0 bg-white/98 backdrop-blur-lg border-t border-gray-100 z-40">
      <div class="flex justify-around items-center px-4 py-2.5">
        <a href="dashboard" class="flex flex-col items-center gap-0.5 text-gray-600">
          <div class="w-9 h-9 rounded-lg flex items-center justify-center">
            <i class="fa-solid fa-house text-sm"></i>
          </div>
          <span class="text-xs font-medium">Home</span>
        </a>
        <a href="finance" class="flex flex-col items-center gap-0.5 text-gray-600">
          <div class="w-9 h-9 rounded-lg flex items-center justify-center">
            <i class="fa-solid fa-chart-line text-sm"></i>
          </div>
          <span class="text-xs font-medium">Finance</span>
        </a>
        <a href="cards" class="flex flex-col items-center gap-0.5 text-gray-600">
          <div class="w-9 h-9 rounded-lg flex items-center justify-center">
            <i class="fa-solid fa-credit-card text-sm"></i>
          </div>
          <span class="text-xs font-medium">Cards</span>
        </a>
        <a href="profile" class="flex flex-col items-center gap-0.5 text-gray-600">
          <div class="w-9 h-9 rounded-lg flex items-center justify-center">
            <i class="fa-solid fa-user text-sm"></i>
          </div>
          <span class="text-xs font-medium">Profile</span>
        </a>
      </div>
    </div>
  </body>
</html>
