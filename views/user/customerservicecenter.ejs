<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Customer Service Center</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
</head>

<body
    class="bg-gradient-to-b from-blue-100 to-gray-100 min-h-screen p-6 flex flex-col items-center justify-center space-y-6">

    <h2 class="text-2xl font-semibold text-gray-800 mb-6">Customer Service Center</h2>

    <div class="flex flex-col md:flex-row gap-6 max-w-4xl w-full justify-center">

        <!-- WhatsApp Card -->
        <a href="https://wa.me/yourwhatsappnumber" target="_blank"
            class="flex items-center space-x-4 bg-white rounded-xl shadow p-6 w-full max-w-md hover:shadow-lg transition">
            <i class="fab fa-whatsapp text-green-500 text-5xl"></i>
            <div>
                <h3 class="text-xl font-semibold text-gray-800">WhatsApp Support</h3>
                <p class="text-gray-600">Chat with our support team on WhatsApp for quick assistance.</p>
            </div>
        </a>

        <!-- Email Card -->
        <a href="mailto:support@example.com"
            class="flex items-center space-x-4 bg-white rounded-xl shadow p-6 w-full max-w-md hover:shadow-lg transition">
            <i class="fas fa-envelope text-blue-600 text-5xl"></i>
            <div>
                <h3 class="text-xl font-semibold text-gray-800">Email Support</h3>
                <p class="text-gray-600">Send us an email and we will get back to you as soon as possible.</p>
            </div>
        </a>

    </div>
    <!-- Fixed Bottom Navigation -->
    <div class="fixed bottom-0 left-0 right-0 bg-gray-100 border-t-2 shadow-md z-50">
        <div class="flex justify-between items-center px-8 py-3 text-xs text-gray-700">

            <!-- Home -->
            <a href="dashboard" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
                <i class="fa-solid fa-house text-lg"></i>
                <span class="mt-1">Home</span>
            </a>

            <!-- Finance -->
            <a href="finance" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
                <i class="fa-solid fa-chart-line text-lg"></i>
                <span class="mt-1">Finance</span>
            </a>

            <!-- Cards -->
            <a href="cards" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
                <i class="fa-solid fa-credit-card text-lg"></i>
                <span class="mt-1">Cards</span>
            </a>

            <!-- Me -->
            <a href="profile" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
                <i class="fa-solid fa-user text-lg"></i>
                <span class="mt-1">Me</span>
            </a>

        </div>
    </div>

</body>

</html>