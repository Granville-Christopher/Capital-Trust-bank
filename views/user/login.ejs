<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Capital Trust Bank - Login</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>

<body class="bg-gradient-to-b from-blue-100 to-gray-100 min-h-screen flex flex-col relative overflow-y-hidden">

    <!-- Header Section -->
    <div class="bg-blue-600 text-white py-6 px-4 flex flex-col items-center">
        <div class="text-2xl font-semibold flex items-center space-x-2">
            <i class="fa-solid fa-building-columns text-white"></i>
            <span>Capital Trust Bank</span>
        </div>
        <p class="mt-2 text-sm">Welcome back! We're glad to see you again.</p>
        <a href="index" class="mt-2 text-xs underline hover:text-gray-200">← Back to Home</a>
    </div>

    <!-- Login Form -->
    <div class="flex-grow flex items-center justify-center px-4">
        <form class="rounded-xl p-8 w-full max-w-md mt-[-4rem] relative">
            <h2 class="text-xl font-bold text-blue-600 mb-6 text-center">Sign In to Your Account</h2>

            <!-- Email Field -->
            <div class="mb-4">
                <label class="block text-sm text-gray-700 mb-1" for="email">Email Address</label>
                <input type="email" id="email" placeholder="Enter your email"
                    class="w-full px-4 py-2 border border-blue-500 rounded-full outline-none focus:ring-2 focus:ring-blue-400" />
            </div>

            <!-- Password Field with Toggle -->
            <div class="mb-4 relative ">
                <label class="block text-sm text-gray-700 mb-1" for="password">Password</label>
                <input type="password" id="password" placeholder="Enter your password"
                    class=" w-full px-4 py-2 pr-10 border border-blue-500 rounded-full outline-none focus:ring-2 focus:ring-blue-400" />
                <span class="absolute right-3 top-[38px] cursor-pointer text-blue-500" onclick="togglePassword()">
                    <i id="toggleIcon" class="fa-solid fa-eye"></i>
                </span>
            </div>

            <!-- Submit Button -->
            <button type="submit"
                class="w-full py-2 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition duration-200">
                Log In
            </button>

            <!-- Extra Links -->
            <div class="flex justify-between mt-4 text-sm">
                <a href="resetpassword" class="text-blue-500 hover:underline">Forgot Password?</a>
                <a href="signup" class="text-blue-500 hover:underline">Sign Up</a>
            </div>
        </form>
    </div>
    <script src="/js/frontendfiles/showpassword.js"></script>
</body>

</html>