<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capital Trust Bank - Secure Login</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <link rel="icon" type="image/png" sizes="32x32" href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank" />
    <link rel="icon" type="image/png" sizes="16x16" href="https://placehold.co/16x16/2563EB/DBEAFE?text=CTBank" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://placehold.co/180x180/2563EB/DBEAFE?text=CTBank" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#4f46e5" />
</head>
<%- include('partials/toastalerts')%>

<body class="bg-gradient-to-b from-indigo-50 to-slate-100 min-h-screen flex flex-col relative font-sans text-slate-800">

    <!-- Top Banner -->
    <div class="bg-gradient-to-r from-indigo-700 via-indigo-600 to-blue-700 text-white py-6 px-4 flex flex-col items-center shadow-lg">
        <div class="text-2xl font-extrabold flex items-center space-x-3 tracking-wide">
            <i class="fa-solid fa-building-columns text-indigo-200 text-xl"></i>
            <span>Capital Trust Bank</span>
        </div>
        <p class="mt-1.5 text-xs text-indigo-100 font-medium">Encrypted Online Banking Portal</p>
        <a href="/" class="mt-2 text-xs text-indigo-200 hover:text-white underline transition flex items-center gap-1">
            <i class="fa-solid fa-arrow-left text-[10px]"></i> Back to Home
        </a>
    </div>

    <!-- Main Card Container -->
    <div class="flex-grow flex items-center justify-center px-4 py-8">
        <div class="bg-white rounded-2xl shadow-2xl p-6 sm:p-8 w-full max-w-md mt-[-2rem] relative border border-slate-100 transition-all duration-300">
            
            <!-- STEP 1: LOGIN CREDENTIALS SECTION -->
            <div id="login-section">
                <div class="text-center mb-6">
                    <div class="w-14 h-14 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center mx-auto mb-3 text-indigo-600 shadow-sm">
                        <i class="fa-solid fa-user-shield text-2xl"></i>
                    </div>
                    <h2 class="text-xl font-bold text-slate-900">Sign In to Your Account</h2>
                    <p class="text-xs text-slate-500 mt-1">Enter your registered email and password</p>
                </div>

                <!-- Error Message Banner -->
                <div id="login-error-msg" class="hidden mb-4 p-3 bg-red-50 border border-red-200 text-red-700 text-xs rounded-xl flex items-start gap-2">
                    <i class="fa-solid fa-circle-exclamation text-red-500 mt-0.5 flex-shrink-0 text-sm"></i>
                    <span id="login-error-text" class="font-medium"></span>
                </div>

                <form id="login" class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1.5" for="email">Email Address</label>
                        <div class="relative">
                            <input type="email" id="email" name="Email" required placeholder="name@example.com"
                                class="w-full pl-10 pr-4 py-2.5 border border-slate-300 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition text-sm bg-slate-50/50 focus:bg-white" />
                            <i class="fa-solid fa-envelope absolute left-3.5 top-3 text-slate-400 text-sm"></i>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1.5" for="password">Password</label>
                        <div class="relative">
                            <input type="password" id="password" name="Password" required placeholder="Enter password"
                                class="w-full pl-10 pr-10 py-2.5 border border-slate-300 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition text-sm bg-slate-50/50 focus:bg-white" />
                            <i class="fa-solid fa-lock absolute left-3.5 top-3 text-slate-400 text-sm"></i>
                            <span class="absolute right-3.5 top-2.5 cursor-pointer text-slate-400 hover:text-indigo-600 transition" onclick="togglePassword()">
                                <i id="toggleIcon" class="fa-solid fa-eye text-sm"></i>
                            </span>
                        </div>
                    </div>

                    <button type="submit" id="login-btn"
                        class="w-full py-3 bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 text-white rounded-xl transition-all duration-200 font-bold shadow-md hover:shadow-lg flex items-center justify-center text-sm gap-2 mt-2">
                        <span id="login-text">Sign In</span>
                        <svg id="spinner" class="animate-spin h-4 w-4 hidden text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                        </svg>
                    </button>

                    <div class="flex justify-between items-center pt-2 text-xs">
                        <a href="resetpassword" class="text-indigo-600 hover:text-indigo-800 font-medium hover:underline">Forgot Password?</a>
                        <a href="signup" class="text-indigo-600 hover:text-indigo-800 font-semibold hover:underline">Open New Account &rarr;</a>
                    </div>
                </form>
            </div>

            <!-- STEP 2: OTP 2FA VERIFICATION SECTION (Dynamically Revealed) -->
            <div id="otp-section" class="hidden">
                <div class="text-center mb-5">
                    <div class="w-14 h-14 rounded-2xl bg-emerald-50 border border-emerald-100 flex items-center justify-center mx-auto mb-3 text-emerald-600 shadow-sm animate-pulse">
                        <i class="fa-solid fa-shield-halved text-2xl"></i>
                    </div>
                    <h2 class="text-xl font-bold text-slate-900">Security Verification</h2>
                    <p class="text-xs text-slate-500 mt-1">
                        We sent a 6-digit code to <br/>
                        <strong id="userEmailSpan" class="text-indigo-600 font-semibold">your email</strong>
                    </p>
                </div>

                <!-- Spam Note -->
                <div class="mb-4 p-3 bg-amber-50 border border-amber-200 rounded-xl text-left flex items-start gap-2.5">
                    <i class="fa-solid fa-circle-info text-amber-600 text-sm mt-0.5 flex-shrink-0"></i>
                    <p class="text-[11px] text-amber-800 leading-relaxed font-medium">
                        Didn't see the email? Please check your <strong>Spam / Junk folder</strong> or click Resend OTP below.
                    </p>
                </div>

                <!-- OTP Error / Success Banner -->
                <div id="otpErrorMsg" class="hidden mb-4 p-3 bg-red-50 border border-red-200 text-red-700 text-xs rounded-xl flex items-start gap-2">
                    <i class="fa-solid fa-circle-exclamation text-red-500 mt-0.5 flex-shrink-0 text-sm"></i>
                    <span id="otpErrorText" class="font-medium"></span>
                </div>

                <div id="otpSuccessMsg" class="hidden mb-4 p-3 bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs rounded-xl flex items-start gap-2">
                    <i class="fa-solid fa-circle-check text-emerald-500 mt-0.5 flex-shrink-0 text-sm"></i>
                    <span id="otpSuccessText" class="font-medium"></span>
                </div>

                <form id="loginOtpForm" class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1.5 text-center">Enter 6-Digit Code</label>
                        <input type="text" id="otpInput" name="otp" maxlength="6" pattern="[0-9]{6}" required placeholder="123456" autocomplete="one-time-code"
                            class="w-full py-3 px-4 text-center tracking-[0.5em] font-mono text-2xl font-bold rounded-xl border-2 border-indigo-200 focus:border-indigo-600 focus:ring-2 focus:ring-indigo-500/20 outline-none bg-slate-50 transition" />
                    </div>

                    <button type="submit" id="verifyOtpBtn"
                        class="w-full py-3 bg-gradient-to-r from-emerald-600 to-teal-700 hover:from-emerald-700 hover:to-teal-800 text-white rounded-xl transition-all duration-200 font-bold shadow-md hover:shadow-lg flex items-center justify-center text-sm gap-2">
                        <span id="verifyOtpText">Verify &amp; Enter Dashboard</span>
                        <svg id="otpSpinner" class="animate-spin h-4 w-4 hidden text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                        </svg>
                    </button>
                </form>

                <div class="flex items-center justify-between mt-5 pt-4 border-t border-slate-100 text-xs">
                    <button type="button" id="backToLoginBtn" class="text-slate-500 hover:text-slate-800 font-medium transition flex items-center gap-1">
                        <i class="fa-solid fa-arrow-left text-[10px]"></i> Back
                    </button>
                    <button type="button" id="resendOtpBtn" class="text-indigo-600 hover:text-indigo-800 font-semibold transition">
                        Resend Code
                    </button>
                </div>
            </div>

            <!-- Blocked Modal (if account is locked) -->
            <div id="loginBlockedModal" class="hidden fixed inset-0 bg-black/60 z-50 items-center justify-center p-4">
                <div class="bg-white p-6 max-w-sm w-full shadow-2xl rounded-2xl text-center border border-red-100">
                    <div class="w-14 h-14 mx-auto mb-3 rounded-full bg-red-100 flex items-center justify-center text-red-600">
                        <i class="fa-solid fa-ban text-2xl"></i>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 mb-1">Access Restricted</h3>
                    <p class="text-xs text-slate-600 mb-5 leading-relaxed" id="loginBlockedModalMessage">
                        Your login access has been suspended. Please contact customer support.
                    </p>
                    <button type="button" id="loginBlockedModalClose" class="w-full py-2.5 bg-slate-900 text-white rounded-xl text-xs font-semibold hover:bg-slate-800 transition">
                        Close
                    </button>
                </div>
            </div>

        </div>
    </div>

    <script src="/js/frontendfiles/showpassword.js"></script>
    <script src="/js/auth/userlogin.js?v=10"></script>
</body>

</html>