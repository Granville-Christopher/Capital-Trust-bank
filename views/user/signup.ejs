<!DOCTYPE html>
<html lang="en">


<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capital Trust Bank - Signup</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <link rel="icon" type="image/png" sizes="32x32" href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank" />
    <link rel="icon" type="image/png" sizes="16x16" href="https://placehold.co/16x16/2563EB/DBEAFE?text=CTBank" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://placehold.co/180x180/2563EB/DBEAFE?text=CTBank" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#4f46e5" />

    <meta property="og:title" content="Capital Trust Bank - Secure & Modern Banking" />
    <meta property="og:description"
        content="Manage your finances with ease. Secure, fast, and reliable banking services for all your needs." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://capital-trust-bank-production.up.railway.app/" />
    <meta property="og:image" content="https://capital-trust-bank-production.up.railway.app/images/hpg.jpg" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:site_name" content="Capital Trust Bank" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@CTBankOfficial" />
    <meta name="twitter:creator" content="@CTBankOfficial" />
    <meta name="twitter:title" content="Capital Trust Bank - Secure & Modern Banking" />
    <meta name="twitter:description"
        content="Manage your finances with ease. Secure, fast, and reliable banking services for all your needs." />
    <meta name="twitter:image" content="https://capital-trust-bank-production.up.railway.app/images/hpg.jpg" />


</head>
<%- include('partials/toastalerts') %>

    <body class="bg-gradient-to-b from-indigo-50 to-slate-50 min-h-screen flex flex-col relative">

        <div class="bg-gradient-to-r from-indigo-600 to-indigo-700 text-white py-5 px-4 flex flex-col items-center shadow-lg">
            <div class="text-xl font-bold flex items-center space-x-2">
                <i class="fa-solid fa-building-columns text-white text-lg"></i>
                <span>Capital Trust Bank</span>
            </div>
            <p class="mt-2 text-xs text-indigo-100">Join the Capital Trust family and start your financial journey with confidence.</p>
            <a href="index" class="mt-2 text-xs underline hover:text-white transition">← Back to Home</a>
        </div>

        <div class="flex-grow flex items-center justify-center px-4">
            <form id="signup" class="bg-white rounded-xl shadow-xl p-6 w-full max-w-md mt-[-3rem] border border-gray-100">
                <div class="text-center mb-5">
                    <div class="w-12 h-12 rounded-full bg-indigo-100 flex items-center justify-center mx-auto mb-3">
                        <i class="fa-solid fa-user-plus text-indigo-600 text-lg"></i>
                    </div>
                    <h2 class="text-xl font-bold text-indigo-700">Create Your Account</h2>
                </div>

                <div class="mb-3">
                    <label class="block text-xs font-semibold text-gray-700 mb-1.5" for="name">Full Name</label>
                    <input type="text" id="name" name="Name" placeholder="Enter your full name"
                        class="w-full px-3 py-2 border-2 border-gray-200 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition text-sm">
                </div>

                <div class="mb-3">
                    <label class="block text-xs font-semibold text-gray-700 mb-1.5" for="email">Email Address</label>
                    <input type="email" id="email" name="Email" placeholder="Enter your email"
                        class="w-full px-3 py-2 border-2 border-gray-200 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition text-sm">
                </div>

                <div class="mb-4 relative">
                    <label class="block text-xs font-semibold text-gray-700 mb-1.5" for="password">Password</label>
                    <input type="password" id="password" name="Password" placeholder="Enter your password"
                        class="w-full px-3 py-2 pr-10 border-2 border-gray-200 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition text-sm" />
                    <span class="absolute right-3 top-[38px] cursor-pointer text-indigo-600 hover:text-indigo-700" onclick="togglePassword()">
                        <i id="toggleIcon" class="fa-solid fa-eye text-sm"></i>
                    </span>
                </div>

                <button type="submit" id="signup-btn"
                    class="w-full py-2.5 bg-gradient-to-r from-indigo-600 to-indigo-700 text-white rounded-lg hover:from-indigo-700 hover:to-indigo-800 transition font-semibold shadow-md flex items-center justify-center text-sm">
                    <span id="signup-text">Sign Up</span>
                    <svg id="spinner" class="animate-spin h-4 w-4 ml-2 hidden text-white"
                        xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4">
                        </circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                    </svg>
                </button>

                <p class="mt-4 text-xs text-center text-gray-600">
                    Already have an account with Capital Trust? <a href="login"
                        class="text-indigo-600 hover:text-indigo-700 font-semibold hover:underline">Please log in here</a>
                </p>
            </form>
        </div>
        <script src="/js/frontendfiles/showpassword.js"></script>
        <script src="/js/auth/usersignup.js"></script>
    </body>

</html>