<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Capital Trust Bank - Sign Up</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<%- include('partials/toastalerts') %>
<body class="bg-gradient-to-b from-blue-100 to-gray-100 min-h-screen flex flex-col relative overflow-y-hidden">

    <!-- Header Section -->
    <div class="bg-blue-600 text-white py-6 px-4 flex flex-col items-center">
        <div class="text-2xl font-semibold flex items-center space-x-2">
            <i class="fa-solid fa-building-columns text-white"></i>
            <span>Capital Trust Bank</span>
        </div>
        <p class="mt-2 text-sm">Join the Capital Trust family and start your financial journey with confidence.</p>
        <a href="index" class="mt-2 text-xs underline hover:text-gray-200">← Back to Home</a>
    </div>

    <!-- Sign-Up Form -->
    <div class="flex-grow flex items-center justify-center px-4">
        <form id="signup" class=" rounded-xl p-8 w-full max-w-md mt-[-4rem]">
            <h2 class="text-xl font-bold text-blue-600 mb-6 text-center">Create Your Account</h2>

            <div class="mb-4">
                <label class="block text-sm text-gray-700 mb-1" for="name">Full Name</label>
                <input type="text" id="name" name="Name" placeholder="Enter your full name"
                    class="w-full px-4 py-2 border border-blue-500 rounded-full outline-none focus:ring-2 focus:ring-blue-400">
            </div>

            <div class="mb-4">
                <label class="block text-sm text-gray-700 mb-1" for="email">Email Address</label>
                <input type="email" id="email" name="Email" placeholder="Enter your email"
                    class="w-full px-4 py-2 border border-blue-500 rounded-full outline-none focus:ring-2 focus:ring-blue-400">
            </div>

            <div class="mb-4 relative ">
                <label class="block text-sm text-gray-700 mb-1" for="password">Password</label>
                <input type="password" id="password" name="Password" placeholder="Enter your password"
                    class=" w-full px-4 py-2 pr-10 border border-blue-500 rounded-full outline-none focus:ring-2 focus:ring-blue-400" />
                <span class="absolute right-3 top-[38px] cursor-pointer text-blue-500" onclick="togglePassword()">
                    <i id="toggleIcon" class="fa-solid fa-eye"></i>
                </span>
            </div>

            <button type="submit" id="signup-btn"
                class="w-full py-2 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition duration-200 flex items-center justify-center">
                <span id="signup-text">Sign Up</span>
                <svg id="spinner" class="animate-spin h-5 w-5 ml-2 hidden text-white" xmlns="http://www.w3.org/2000/svg"
                    fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                </svg>
            </button>


            <p class="mt-4 text-sm text-center">
                Already have an account with Capital Trust? <a href="login" class="text-blue-500 hover:underline">Please
                    log in here</a>
            </p>
        </form>
    </div>
    <script src="/js/frontendfiles/showpassword.js"></script>
    <script src="/js/auth/usersignup.js"></script>
</body>

</html>