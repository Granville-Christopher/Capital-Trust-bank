<!DOCTYPE html>
<html lang="en">


<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Capital Trust Bank - Profile</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

  <link rel="icon" type="image/png" sizes="32x32" href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank" />
  <link rel="icon" type="image/png" sizes="16x16" href="https://placehold.co/16x16/2563EB/DBEAFE?text=CTBank" />
  <link rel="apple-touch-icon" sizes="180x180" href="https://placehold.co/180x180/2563EB/DBEAFE?text=CTBank" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#2563EB" />

  <meta property="og:title" content="Capital Trust Bank - Secure & Modern Banking" />
  <meta property="og:description"
    content="Manage your finances with ease. Secure, fast, and reliable banking services for all your needs." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://capital-trust-bank-production.up.railway.app/" />
  <meta property="og:image" content="https://placehold.co/512x512/2563EB/DBEAFE?text=CTBank" />
  <meta property="og:image:width" content="512" />
  <meta property="og:image:height" content="512" />
  <meta property="og:site_name" content="Capital Trust Bank" />
  <meta property="og:locale" content="en_NG" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@CTBankOfficial" />
  <meta name="twitter:creator" content="@CTBankOfficial" />
  <meta name="twitter:title" content="Capital Trust Bank - Secure & Modern Banking" />
  <meta name="twitter:description"
    content="Manage your finances with ease. Secure, fast, and reliable banking services for all your needs." />
  <meta name="twitter:image" content="https://capital-trust-bank-production.up.railway.app/images/hpg.jpg" />

</head>

<body class="bg-gradient-to-b from-blue-100 to-gray-100 min-h-screen relative">


  <div class="fixed top-0 left-0 right-0 bg-blue-100 px-6 py-4 flex justify-between items-center z-50">
    <h2 class="text-lg font-semibold"> <span id="greeting">Welcome</span>, Granville</h2>
    <a href="settings" class="text-blue-700 text-xl hover:text-blue-900">
      <i class="fa-solid fa-gear"></i>
    </a>
  </div>

  <div class="pt-16 px-6 space-y-6">

    <div class="bg-white rounded-xl shadow p-6 relative">
      <div class="flex justify-between items-center">
        <p class="text-sm font-medium text-gray-500">Total Balance</p>
        <button onclick="toggleBalance()" class="text-blue-600">
          <i id="balanceIcon" class="fa-solid fa-eye"></i>
        </button>
      </div>
      <p id="balanceAmount" class="mt-2 text-2xl font-bold text-gray-800">
        <%= user.AccountBalance.toLocaleString('en-US', { style: 'currency' , currency: 'USD' }) %>
      </p>
    </div>

    <div class="bg-white rounded-xl shadow p-6 relative">
      <div class="accountid mt-3">
        <p class="text-gray-400 text-xs">Account number:</p>
        <style>
          .account-id-wrapper {
            position: relative;
            display: inline-block;
            margin-bottom: 5px;
          }

          .copy-feedback {
            position: absolute;
            top: 100%;
            left: 70%;
            transform: translateX(-50%);
            white-space: nowrap;
            padding: 4px 8px;
            background-color: #18aaf3;
            color: #ffffff;
            border-radius: 4px;
            font-size: 0.8em;
            opacity: 0;
            transition: opacity 0.3s ease-in-out;
            pointer-events: none;
            z-index: 10;
          }

          .copy-feedback.show {
            opacity: 1;
          }
        </style>
        <p id="copyAccountId" class="inline-flex items-center text-lg cursor-pointer hover:text-blue-600 transition font-bold">
          <i class="fas fa-copy text-blue-400 mr-2 font-bold"></i>
          <%= user.AccountNumber%>
        </p>
        <span id="copyFeedback" class="copy-feedback">Copied!</span>
      </div>
    </div>





    <div class="space-y-4 text-sm">
      <a href="transactionhistory" class="block bg-white rounded-xl shadow px-6 py-4 hover:bg-blue-50 transition">
        <span class="font-semibold text-gray-700">Transaction History</span>
        <p class="text-xs text-gray-500">View your recent banking activity</p>
      </a>

      <a href="#" class="block bg-white rounded-xl shadow px-6 py-4 hover:bg-blue-50 transition">
        <span class="font-semibold text-gray-700">Account Type</span>
        <p class="text-xs text-gray-500"> <%= user.AccountCategory %> - <%= user.AccountType %></p>
      </a>

      <a href="cards" class="block bg-white rounded-xl shadow px-6 py-4 hover:bg-blue-50 transition">
        <span class="font-semibold text-gray-700">Cards</span>
        <p class="text-xs text-gray-500">Manage your credit and debit cards</p>
      </a>
    </div>

    <div class="bg-white rounded-xl shadow px-6 py-5 mt-4 hover:bg-blue-50 transition">
      <a href="customerservicecenter" class="flex justify-between items-center ">
        <div>
          <h3 class="text-sm font-semibold text-gray-700">Customer Service Center</h3>
          <p class="text-xs text-gray-500">Need help? We're here for you</p>
        </div>
        <i class="fa-solid fa-headset text-blue-600 text-xl"></i>
      </a>
    </div>

  </div>

  <div class="fixed bottom-0 left-0 right-0 bg-gray-100 border-t-2 shadow-md z-50">
    <div class="flex justify-between items-center px-8 py-3 text-xs text-gray-700">

      <a href="dashboard" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
        <i class="fa-solid fa-house text-lg"></i>
        <span class="mt-1">Home</span>
      </a>

      <a href="finance" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
        <i class="fa-solid fa-chart-line text-lg"></i>
        <span class="mt-1">Finance</span>
      </a>

      <a href="cards" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
        <i class="fa-solid fa-credit-card text-lg"></i>
        <span class="mt-1">Cards</span>
      </a>

      <a href="profile" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
        <i class="fa-solid fa-user text-lg"></i>
        <span class="mt-1">Me</span>
      </a>

    </div>
  </div>

  <script src="/js/frontendfiles/balancetoggle.js"></script>
  <script src="/js/frontendfiles/customgreeting.js"></script>
</body>

</html>