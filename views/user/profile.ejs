<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Capital Trust Bank - Profile</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="icon" type="image/png" sizes="32x32" href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank" />
  <link rel="icon" type="image/png" sizes="16x16" href="https://placehold.co/16x16/2563EB/DBEAFE?text=CTBank" />
  <link rel="apple-touch-icon" sizes="180x180" href="https://placehold.co/180x180/2563EB/DBEAFE?text=CTBank" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#4f46e5" />

  <style>
    * {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    .glass-effect {
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(14, 165, 233, 0.1);
    }

    .profile-card {
      background: #ffffff;
      border: 1.5px solid #e2e8f0;
      transition: all 0.3s ease;
    }

    .profile-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
      border-color: #4f46e5;
    }

    .bottom-nav {
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.06);
      border-top: 1px solid #e2e8f0;
    }

    .nav-item.active {
      color: #4f46e5;
    }
  </style>
</head>

<body class="bg-gradient-to-br from-slate-50 via-indigo-50/20 to-slate-50 min-h-screen pb-20">
  <div class="fixed top-0 left-0 right-0 glass-effect flex justify-between items-center px-4 py-3 z-30 shadow-sm">
    <div class="flex items-center gap-2">
      <button onclick="history.back()" class="w-9 h-9 rounded-full bg-white shadow-md flex items-center justify-center hover:bg-gray-50 transition border border-gray-100">
        <i class="fa-solid fa-arrow-left text-gray-700 text-sm"></i>
      </button>
      <h2 class="text-sm font-bold text-gray-800">Profile</h2>
    </div>
    <a href="settings" class="w-9 h-9 rounded-full bg-white shadow-md flex items-center justify-center hover:bg-gray-50 transition border border-gray-100">
      <i class="fa-solid fa-gear text-gray-700 text-sm"></i>
    </a>
  </div>

  <div class="pt-16 px-4 space-y-4 pb-20">
    <!-- Balance Card -->
    <div class="bg-gradient-to-br from-indigo-600 to-indigo-700 rounded-2xl p-4 text-white shadow-xl">
      <div class="flex justify-between items-start mb-3">
        <div>
          <p class="text-indigo-100 text-xs font-medium mb-1">Total Balance</p>
          <div class="flex items-center gap-2">
            <p id="balanceAmount" class="text-2xl font-bold tracking-tight"
              data-balance="<%= Number(user?.AccountBalance ?? 0) %>" data-currency="<%= currencyCode %>">
              $<%= Number(user?.AccountBalance ?? 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
            </p>
            <button onclick="toggleBalance()" class="text-indigo-200 hover:text-white transition">
              <i id="balanceIcon" class="fa-solid fa-eye text-sm"></i>
            </button>
          </div>
        </div>
      </div>
      <script src="/js/currencydisplaycountry.js"></script>
    </div>

    <!-- Account Number Card -->
    <div class="profile-card rounded-xl p-3 shadow-sm">
      <p class="text-gray-500 text-xs font-medium mb-1.5">Account Number</p>
      <div class="relative inline-block w-full">
        <p id="copyAccountId" class="text-base font-bold text-gray-800 cursor-pointer hover:text-indigo-600 transition flex items-center gap-2">
          <i class="fas fa-copy text-indigo-600 text-xs"></i>
          <%= user.AccountNumber %>
        </p>
        <span id="copyFeedback" class="absolute top-full left-0 mt-2 px-2 py-1 bg-indigo-600 text-white text-xs rounded-lg opacity-0 transition-opacity pointer-events-none">Copied!</span>
      </div>
    </div>

    <!-- Menu Items -->
    <div class="space-y-3">
      <a href="transactionhistory" class="profile-card rounded-2xl p-5 flex items-center justify-between group">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-indigo-100 flex items-center justify-center">
            <i class="fa-solid fa-receipt text-indigo-600 text-lg"></i>
          </div>
          <div>
            <p class="font-semibold text-gray-800 text-sm">Transaction History</p>
            <p class="text-xs text-gray-500">View your recent banking activity</p>
          </div>
        </div>
        <i class="fa-solid fa-chevron-right text-gray-400 group-hover:text-indigo-600 transition"></i>
      </a>

      <a href="/secure/ctb/kyc" class="profile-card rounded-2xl p-5 flex items-center justify-between group bg-indigo-50/50 border-indigo-200">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-indigo-600 text-white flex items-center justify-center">
            <i class="fa-solid fa-id-card text-lg"></i>
          </div>
          <div>
            <p class="font-semibold text-gray-800 text-sm">Identity Verification (KYC)</p>
            <p class="text-xs <%= kyc ? (kyc.verified ? 'text-emerald-600 font-semibold' : 'text-amber-600 font-semibold') : 'text-indigo-600 font-semibold' %>">
              <%= kyc ? (kyc.verified ? 'Verified ✓' : 'Under Review ⏳') : 'Verify Account Identity →' %>
            </p>
          </div>
        </div>
        <i class="fa-solid fa-chevron-right text-indigo-600 group-hover:translate-x-1 transition"></i>
      </a>

      <div class="profile-card rounded-2xl p-5">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-violet-100 flex items-center justify-center">
            <i class="fa-solid fa-user-tag text-violet-600 text-lg"></i>
          </div>
          <div>
            <p class="font-semibold text-gray-800 text-sm">Account Type</p>
            <p class="text-xs text-gray-500">
              <%= kyc ? (kyc.accountCategory + ' - ' + kyc.accountType) : 'Personal - Savings' %>
            </p>
          </div>
        </div>
      </div>

      <a href="cards" class="profile-card rounded-2xl p-5 flex items-center justify-between group">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-indigo-100 flex items-center justify-center">
            <i class="fa-solid fa-credit-card text-indigo-600 text-lg"></i>
          </div>
          <div>
            <p class="font-semibold text-gray-800 text-sm">Cards</p>
            <p class="text-xs text-gray-500">Manage your credit and debit cards</p>
          </div>
        </div>
        <i class="fa-solid fa-chevron-right text-gray-400 group-hover:text-indigo-600 transition"></i>
      </a>

      <a href="customerservicecenter" class="profile-card rounded-2xl p-5 flex items-center justify-between group">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-emerald-100 flex items-center justify-center">
            <i class="fa-solid fa-headset text-emerald-600 text-lg"></i>
          </div>
          <div>
            <p class="font-semibold text-gray-800 text-sm">Customer Service</p>
            <p class="text-xs text-gray-500">Need help? We're here for you</p>
          </div>
        </div>
        <i class="fa-solid fa-chevron-right text-gray-400 group-hover:text-indigo-600 transition"></i>
      </a>
    </div>
  </div>

  <div class="fixed bottom-0 left-0 right-0 bottom-nav z-50">
    <div class="flex justify-around items-center px-6 py-3">
      <a href="dashboard" class="nav-item flex flex-col items-center gap-1 text-gray-600">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center">
          <i class="fa-solid fa-house text-lg"></i>
        </div>
        <span class="text-xs font-medium">Home</span>
      </a>

      <a href="finance" class="nav-item flex flex-col items-center gap-1 text-gray-600">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center">
          <i class="fa-solid fa-chart-line text-lg"></i>
        </div>
        <span class="text-xs font-medium">Finance</span>
      </a>

      <a href="cards" class="nav-item flex flex-col items-center gap-1 text-gray-600">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center">
          <i class="fa-solid fa-credit-card text-lg"></i>
        </div>
        <span class="text-xs font-medium">Cards</span>
      </a>

      <a href="profile" class="nav-item active flex flex-col items-center gap-1">
        <div class="w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center">
          <i class="fa-solid fa-user text-indigo-600"></i>
        </div>
        <span class="text-xs font-medium text-indigo-600">Profile</span>
      </a>
    </div>
  </div>

  <script>
    const copyAccountId = document.getElementById("copyAccountId");
    const copyFeedback = document.getElementById("copyFeedback");

    copyAccountId.addEventListener("click", () => {
      const accountNumber = copyAccountId.textContent.trim().replace(/^\S+\s+/, '');
      navigator.clipboard.writeText(accountNumber).then(() => {
        copyFeedback.classList.remove("opacity-0");
        setTimeout(() => {
          copyFeedback.classList.add("opacity-0");
        }, 2000);
      });
    });
  </script>
  <script src="/js/frontendfiles/balancetoggle.js"></script>
  <script src="/js/frontendfiles/customgreeting.js"></script>
    <%- include('partials/floatingchat') %>
</body>

</html>
