<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capital Trust Bank - Finance History</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link rel="icon" type="image/png" sizes="32x32" href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank" />
    <link rel="icon" type="image/png" sizes="16x16" href="https://placehold.co/16x16/2563EB/DBEAFE?text=CTBank" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://placehold.co/180x180/2563EB/DBEAFE?text=CTBank" />
    <meta name="theme-color" content="#2563EB" />
</head>

<body class="bg-gradient-to-b from-blue-100 to-gray-100 min-h-screen p-6 space-y-6 relative">

    <div class="flex justify-between px-3 fixed right-0 left-0 top-0 bg-blue-100 items-center mb-4 shadow-md">
        <h2 class="text-xl py-4 font-semibold text-gray-800">
            <i class="fa-solid fa-file-invoice-dollar text-blue-600 mr-2"></i>
            Finance History
        </h2>
        <p class="text-blue-600">
            <a href="finance">Back to finance</a>
        </p>
    </div>

    <div class="flex justify-between mb-4 pt-8 px-4 max-w-7xl mx-auto">
        <button id="btnSavings" class="text-blue-600 font-semibold border-b-2 border-b-blue-600 pb-1">
            Savings History
        </button>
        <button id="btnLoans"
            class="text-gray-600 font-semibold border-b-2 border-transparent pb-1 hover:text-blue-600">
            Loan History
        </button>
    </div>

    <div id="savingsHistorySection" class="max-w-7xl mx-auto block space-y-4">

        <div class="flex justify-between items-center px-4">
            <p class="font-semibold text-gray-700">Total Amount Saved:</p>
            <p class="font-semibold text-blue-600">
                <%= new Intl.NumberFormat(undefined, { style: "currency" , currency: currencyCode })
                    .format(totalSavings || 0) %>
            </p>
        </div>

        <div class="flex justify-end mb-2 px-4">
            <button id="downloadSavingsHistory" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
                Download Savings History
            </button>
        </div>

        <div class="overflow-x-auto rounded-xl pb-6 max-h-[550px] bg-white shadow">

            <table class="w-full text-sm" id="savingsTable">
                <thead class="bg-blue-100 text-gray-700 sticky w-full top-0 z-10">
                    <div class="flex justify-between items-center px-4 py-3 border-b">
                        <div class="text-gray-700 font-semibold whitespace-nowrap p-4">
                            <p>Total Deposits:</p>
                            <span class="text-green-600">
                                <%= new Intl.NumberFormat(undefined, { style: "currency" , currency: currencyCode })
                                    .format( savingsHistory.filter(s=> s.type === 'deposit')
                                    .reduce((sum, s) => sum + (s.amount || 0), 0)
                                    ) %>
                            </span>
                        </div>

                        <div class="text-gray-700 font-semibold whitespace-nowrap p-4">
                            <p>Total Withdrawals:</p>
                            <span class="text-red-600">
                                <%= new Intl.NumberFormat(undefined, { style: "currency" , currency: currencyCode })
                                    .format( savingsHistory.filter(s=> s.type === 'withdraw_interest')
                                    .reduce((sum, s) => sum + (s.amount || 0), 0)
                                    ) %>
                            </span>
                        </div>

                        <div class="text-gray-700 font-semibold whitespace-nowrap p-4">
                            <p>Total Compound Interest:</p>
                            <span class="text-blue-600">
                                <%= new Intl.NumberFormat(undefined, { style: "currency" , currency: currencyCode })
                                    .format( savingsHistory.filter(s=> s.type === 'compound_interest')
                                    .reduce((sum, s) => sum + (s.amount || 0), 0)
                                    ) %>
                            </span>
                        </div>
                    </div>
                    <tr>
                        <th class="py-2 px-4 text-left whitespace-nowrap">Date</th>
                        <th class="py-2 px-4 text-left whitespace-nowrap">Type</th>
                        <th class="py-2 px-4 text-left whitespace-nowrap">Amount</th>
                        <th class="py-2 px-4 text-left whitespace-nowrap">Balance After</th>
                        <th class="py-2 px-4 text-left whitespace-nowrap">Reference ID</th>
                    </tr>
                </thead>
                <tbody class="text-gray-800 bg-white">
                    <% if (savingsHistory && savingsHistory.length> 0) { %>
                        <% savingsHistory.forEach(function(saving) { %>
                            <tr class="border-b">
                                <td class="py-2 px-4">
                                    <%= new Date(saving.createdAt).toLocaleDateString() %>
                                </td>
                                <td class="py-2 px-4 capitalize
                                <% if (saving.type === 'deposit') { %> text-green-600 
                                <% } else if (saving.type === 'withdraw_interest') { %> text-red-600 
                                <% } else if (saving.type === 'compound_interest') { %> text-blue-600 
                                <% } else { %> text-gray-600 <% } %>">
                                    <%= saving.type.replace('_', ' ' ) %>
                                </td>
                                <td class="py-2 px-4 font-semibold 
                                <% if (saving.type === 'deposit') { %> text-green-600 
                                <% } else if (saving.type === 'withdraw_interest') { %> text-red-600 <% } %>">
                                    <%= new Intl.NumberFormat(undefined, { style: "currency" , currency: currencyCode })
                                        .format(saving.amount || 0) %>
                                </td>
                                <td class="py-2 px-4 text-blue-600 font-semibold">
                                    <%= new Intl.NumberFormat(undefined, { style: "currency" , currency: currencyCode })
                                        .format(saving.balanceAfter || 0) %>
                                </td>
                                <td class="py-2 px-4 text-gray-600">
                                    <%= saving.referenceId ? saving.referenceId : 'N/A' %>
                                </td>
                            </tr>
                            <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="py-4 px-4 text-center text-gray-500">
                                            No savings history found.
                                        </td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </div>


    <div id="loanHistorySection" class="max-w-7xl mx-auto hidden space-y-4">

        <div class="flex justify-between items-center px-4">
            <p class="font-semibold text-gray-700">Total Loans:</p>
            <p class="font-semibold text-red-600">
                <%= currencyCode %>
                    <%= totalLoans ? totalLoans.toLocaleString(undefined, { minimumFractionDigits: 2,
                        maximumFractionDigits: 2 }) : '0.00' %>
            </p>
        </div>

        <div class="flex justify-end mb-2 px-4">
            <button id="downloadLoanHistory" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
                Download Loan History
            </button>
        </div>

        <div class="overflow-x-auto rounded-xl pb-6 max-h-[650px] bg-white shadow">
            <table class="min-w-full text-sm" id="loanTable">
                <thead class="bg-blue-100 text-gray-700 sticky top-0 z-10">
                    <tr>
                        <th class="py-2 px-4 text-left whitespace-nowrap">Date</th>
                        <th class="py-2 px-4 text-left whitespace-nowrap">Reason</th>
                        <th class="py-2 px-4 text-left whitespace-nowrap">Amount</th>
                        <th class="py-2 px-4 text-left whitespace-nowrap">Action</th>
                        <th class="py-2 px-4 text-left whitespace-nowrap">Note</th>
                    </tr>
                </thead>
                <tbody class="text-gray-800">
                    <% if (loanHistory && loanHistory.length> 0) { %>
                        <% loanHistory.forEach(function(loan) { %>
                            <tr class="border-b">
                                <td class="py-2 px-4">
                                    <%= new Date(loan.createdAt).toLocaleDateString() %>
                                </td>
                                <td class="py-2 px-4 capitalize">
                                    <%= loan.reason %>
                                </td>
                                <td class="py-2 px-4 text-red-600 font-semibold">
                                    <%= currencyCode %>
                                        <%= (loan.amount || 0).toLocaleString(undefined, { minimumFractionDigits: 2,
                                            maximumFractionDigits: 2 }) %>
                                </td>
                                <td class="py-2 px-4 capitalize
                        <% if (loan.action === 'approved' || loan.action === 'repaid') { %> text-green-600 
                        <% } else if (loan.action === 'rejected') { %> text-red-600 
                        <% } else { %> text-yellow-600 <% } %>">
                                    <%= loan.action %>
                                </td>
                                <td class="py-2 px-4 text-gray-600 whitespace-nowrap">
                                    <%= loan.statusNote ? loan.statusNote : 'No additional note' %>
                                </td>
                            </tr>
                            <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="py-4 px-4 text-center text-gray-500">
                                            No loan history found.
                                        </td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </div>


    <div class="fixed bottom-0 left-0 right-0 bg-gray-100 border-t-2 shadow-md z-50">
        <div class="flex justify-between items-center px-8 py-3 text-xs text-gray-700">
            <a href="dashboard" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
                <i class="fa-solid fa-house text-lg"></i>
                <span class="mt-1">Home</span>
            </a>
            <a href="finance" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
                <i class="fa-solid fa-chart-line text-lg"></i>
                <span class="mt-1">Finance</span>
            </a>
            <a href="cards" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
                <i class="fa-solid fa-credit-card text-lg"></i>
                <span class="mt-1">Cards</span>
            </a>
            <a href="profile" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
                <i class="fa-solid fa-user text-lg"></i>
                <span class="mt-1">Me</span>
            </a>
        </div>
    </div>

    <script src="/js/frontendfiles/financehistory.js">

    </script>

</body>

</html>