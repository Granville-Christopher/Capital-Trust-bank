<!DOCTYPE html>
<html lang="en">


<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Capital Trust Bank - Finance</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

  <link rel="icon" type="image/png" sizes="32x32" href="https://placehold.co/32x32/2563EB/DBEAFE?text=CTBank" />
  <link rel="icon" type="image/png" sizes="16x16" href="https://placehold.co/16x16/2563EB/DBEAFE?text=CTBank" />
  <link rel="apple-touch-icon" sizes="180x180" href="https://placehold.co/180x180/2563EB/DBEAFE?text=CTBank" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#2563EB" />

  <meta property="og:title" content="Capital Trust Bank - Secure & Modern Banking" />
  <meta property="og:description"
    content="Manage your finances with ease. Secure, fast, and reliable banking services for all your needs." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://capital-trust-bank-production.up.railway.app/" />
  <meta property="og:image" content="https://placehold.co/512x512/2563EB/DBEAFE?text=CTBank" />
  <meta property="og:image:width" content="512" />
  <meta property="og:image:height" content="512" />
  <meta property="og:site_name" content="Capital Trust Bank" />
  <meta property="og:locale" content="en_NG" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@CTBankOfficial" />
  <meta name="twitter:creator" content="@CTBankOfficial" />
  <meta name="twitter:title" content="Capital Trust Bank - Secure & Modern Banking" />
  <meta name="twitter:description"
    content="Manage your finances with ease. Secure, fast, and reliable banking services for all your needs." />
  <meta name="twitter:image" content="https://capital-trust-bank-production.up.railway.app/images/hpg.jpg" />


</head>

<body class="bg-gradient-to-b relative from-blue-100 to-gray-100 min-h-screen pt-16 pb-24 px-6 space-y-8">
  <div class="text-center mb-8">
    <p class="text-sm text-gray-600">Total Balance</p>
    <p class="text-4xl font-bold text-blue-600">
      <%= user.AccountBalance.toLocaleString('en-US', { style: 'currency' , currency: 'USD' }) %>

    </p>
  </div>

  <div class="flex justify-between max-w-md mx-auto mb-6">
    <button id="savingsBtn"
      class="flex items-center space-x-2 text-blue-600 font-semibold border-b-2 border-blue-600 pb-1">
      <i class="fa-solid fa-piggy-bank text-xl"></i>
      <span>Savings</span>
    </button>
    <button id="loansBtn"
      class="flex items-center space-x-2 text-gray-500 font-semibold border-b-2 border-transparent pb-1 hover:text-blue-600">
      <i class="fa-solid fa-hand-holding-dollar text-xl"></i>
      <span>Loans</span>
    </button>
  </div>

  <section id="savingsSection" class="max-w-md mx-auto">
    <div class="bg-white rounded-xl shadow p-6 mb-4 relative" id="savingsCard">
      <p class="text-lg font-semibold mb-2">Savings Balance</p>
      <p class="text-3xl font-bold text-blue-600 mb-4" id="savingsBalance"> no savings yet</p>

      <div class="flex justify-between text-sm text-gray-600 mb-4">
        <span id="todayInterest"></span>
        <span id="totalInterest"></span>
      </div>

      <div class="flex gap-4 mt-4">
        <button id="withdrawInterestBtn"
          class="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-xl font-medium w-1/2">
          Withdraw Interest
        </button>

        <button id="compoundInterestBtn"
          class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-xl font-medium w-1/2">
          Compound Interest
        </button>
      </div>
      <button id="cancelSavingsBtn"
        class="mt-4 w-full py-2 bg-red-600 text-white rounded-full hover:bg-red-700 transition">
        Cancel Savings
      </button>
    </div>

    <button id="openSavingsFormBtn"
      class="w-full py-2 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition mb-4">
      Add to Savings
    </button>
    <form id="savingsForm" class="bg-white rounded-xl shadow p-6 max-w-md mx-auto hidden">
      <label for="saveAmount" class="block text-sm font-semibold mb-2">Choose amount to save</label>
      <input type="number" id="saveAmount" name="saveAmount" placeholder="Enter amount"
        class="w-full px-4 py-2 border border-blue-500 rounded-full outline-none focus:ring-2 focus:ring-blue-400 mb-4" />
      <label for="savingsTerm" class="block text-sm font-semibold mb-2">Select Savings Term</label>
      <select id="savingsTerm" name="savingsTerm"
        class="w-full px-4 py-2 border border-blue-500 rounded-full outline-none focus:ring-2 focus:ring-blue-400 mb-4">
        <option value="7">7 days</option>
        <option value="14">14 days</option>
        <option value="30">1 month</option>
        <option value="90">3 months</option>
        <option value="120">4 months</option>
        <option value="150">5 months</option>
        <option value="180">6 months</option>
        <option value="210">7 months</option>
        <option value="240">8 months</option>
        <option value="270">9 months</option>
        <option value="300">10 months</option>
        <option value="330">11 months</option>
        <option value="365">12 months</option>
      </select>
      <button type="submit" class="w-full py-2 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition">
        Save
      </button>
    </form>
  </section>

  <section id="loansSection" class="max-w-md mx-auto hidden">
    <div class="bg-white rounded-xl shadow p-6 mb-4 relative">
      <div class="qlcredit">
        <p class="text-lg font-semibold mb-2">Qualified loan credit</p>
        <p class="text-3xl mb-8 font-bold text-green-600">0</p>
      </div>
      <p class="text-lg font-semibold mb-2">Outstanding Loan</p>
      <p class="text-3xl font-bold text-red-600 mb-4">0</p>
      <div class="flex justify-between text-sm text-gray-600">
        <span></span>
        <span>Outstanding Loan payment Due: 10/15/2024</span>
      </div>
    </div>
    <div class="loanBtns flex justify-between items-center gap-2">
      <button id="openLoanFormBtn"
        class="w-full py-2 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition mb-4">
        Request for Loan
      </button>
      <button id="openPayLoanFormBtn"
        class="w-full py-2 bg-red-600 text-white rounded-full hover:bg-blue-700 transition mb-4">
        Pay Outstanding Loan
      </button>
    </div>
    <form id="loanForm" class="bg-white rounded-xl shadow p-6 max-w-md mx-auto hidden">
      <label for="loanAmount" class="block text-sm font-semibold mb-2">Loan Amount</label>
      <input type="number" id="loanAmount" name="loanAmount" placeholder="Enter loan amount"
        class="w-full px-4 py-2 border border-blue-500 rounded-full outline-none focus:ring-2 focus:ring-blue-400 mb-4" />
      <label for="loanReason" class="block text-sm font-semibold mb-2">Reason for Loan</label>
      <select id="loanReason" name="loanReason"
        class="w-full px-4 py-2 border border-blue-500 rounded-full outline-none focus:ring-2 focus:ring-blue-400 mb-4">
        <option value="" disabled selected>Select a reason</option>
        <option value="medical">Medical Bills</option>
        <option value="rent">Rent</option>
        <option value="education">Education</option>
        <option value="business">Business</option>
        <option value="other">Other</option>
      </select>
      <label for="loanTerm" class="block text-sm font-semibold mb-2">Select Savings Term</label>
      <select id="loanTerm" name="loanTerm"
        class="w-full px-4 py-2 border border-blue-500 rounded-full outline-none focus:ring-2 focus:ring-blue-400 mb-4">
        <option value="7">7 days</option>
        <option value="14">14 days</option>
        <option value="30">1 month</option>
        <option value="90">3 months</option>
        <option value="120">4 months</option>
        <option value="150">5 months</option>
        <option value="180">6 months</option>
        <option value="210">7 months</option>
        <option value="240">8 months</option>
        <option value="270">9 months</option>
        <option value="300">10 months</option>
        <option value="330">11 months</option>
        <option value="365">12 months</option>
      </select>
      <button type="submit" class="w-full py-2 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition">
        Submit Loan Request
      </button>
    </form>
  </section>

  <div id="loanProcessingModal"
    class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden">
    <div class="bg-white rounded-xl shadow-xl p-6 w-full max-w-sm text-center relative">
      <div id="loanSpinner" class="mb-4">
        <i class="fa-solid fa-spinner fa-spin text-blue-600 text-4xl mb-4"></i>
        <h3 class="text-lg font-semibold text-gray-800">Loan processing...</h3>
        <p class="text-sm text-gray-500">Please wait...</p>
      </div>
      <div id="loanSuccess" class="mb-4 hidden">
        <i class="fa-solid fa-circle-check text-green-500 text-5xl animate-bounce"></i>
        <h3 class="mt-2 text-xl font-semibold text-gray-800">Loan Request Successful</h3>
        <p class="text-sm text-gray-500">Your loan request has been submitted.</p>
      </div>
      <div id="loanFailure" class="mb-4 hidden">
        <i class="fa-solid fa-circle-xmark text-red-500 text-5xl animate-shake"></i>
        <h3 class="mt-2 text-xl font-semibold text-gray-800">Loan Request Failed</h3>
        <p class="text-sm text-gray-500">Something went wrong. Please try again.</p>
      </div>
      <button id="closeLoanModalBtn"
        class="mt-6 w-full py-2 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition">
        Close
      </button>
    </div>
  </div>
  <div class="fixed bottom-0 left-0 right-0 bg-gray-100 border-t-2 shadow-md z-50">
    <div class="flex justify-between items-center px-8 py-3 text-xs text-gray-700">

      <a href="dashboard" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
        <i class="fa-solid fa-house text-lg"></i>
        <span class="mt-1">Home</span>
      </a>

      <a href="finance" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
        <i class="fa-solid fa-chart-line text-lg"></i>
        <span class="mt-1">Finance</span>
      </a>

      <a href="cards" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
        <i class="fa-solid fa-credit-card text-lg"></i>
        <span class="mt-1">Cards</span>
      </a>

      <a href="profile" class="flex flex-col items-center text-blue-600 hover:text-blue-800">
        <i class="fa-solid fa-user text-lg"></i>
        <span class="mt-1">Me</span>
      </a>

    </div>
  </div>
  <script src="/js/frontendfiles/finance.js"></script>
  <script src="/js/auth/savings.js"></script>
</body>

</html>